{% comment %}
  TSS image — renders a merchant-picked image when there is one, otherwise the
  bundled theme asset, otherwise a placeholder.

  Accepts:
    image   - image_picker value (wins when set)
    asset   - filename in assets/, e.g. 'tss-hero.jpg'
    class   - css class for the <img>
    alt     - alt text
    width   - ignored; the src is always the master (original) upload
    asset_width / asset_height - intrinsic size of the theme asset (default 900)
    widths  - srcset widths for picked images; 1200-3000 are added when missing
              so high-density screens get a sharp copy
    sizes   - sizes attribute
    loading - 'lazy' (default) or 'eager'
    priority- true to set fetchpriority="high"
    placeholder - placeholder_svg name when nothing is set

  Usage:
    {% render 'tss-image', image: b.image, asset: b.image_asset,
       class: 'tss-img-34', sizes: '78vw', alt: b.name %}
{% endcomment %}

{%- liquid
  assign img_class = class | default: 'tss-img-34'
  # 5760 is the CDN's ceiling and it never upscales, so this is the master file.
  assign img_width = 5760
  assign img_widths = widths | default: '320,480,640,900'
  assign img_width_list = img_widths | split: ','
  assign hi_widths = '1200,1600,2000,2400,3000' | split: ','
  for hi_width in hi_widths
    unless img_width_list contains hi_width
      assign img_widths = img_widths | append: ',' | append: hi_width
    endunless
  endfor
  assign img_sizes = sizes | default: '100vw'
  assign img_loading = loading | default: 'lazy'
  assign img_placeholder = placeholder | default: 'product-1'
-%}

{%- if image != blank -%}
  {%- if priority -%}
    {{
      image
      | image_url: width: img_width
      | image_tag:
        class: img_class,
        widths: img_widths,
        sizes: img_sizes,
        fetchpriority: 'high',
        alt: image.alt | default: alt
    }}
  {%- else -%}
    {{
      image
      | image_url: width: img_width
      | image_tag:
        class: img_class,
        widths: img_widths,
        sizes: img_sizes,
        loading: img_loading,
        alt: image.alt | default: alt
    }}
  {%- endif -%}

{%- elsif asset != blank -%}
  <img
    class="{{ img_class }}"
    src="{{ asset | asset_url }}"
    alt="{{ alt | escape }}"
    width="{{ asset_width | default: 900 }}"
    height="{{ asset_height | default: 900 }}"
    {% if priority %}
      fetchpriority="high"
    {% else %}
      loading="{{ img_loading }}" decoding="async"
    {% endif %}
  >

{%- else -%}
  {{ img_placeholder | placeholder_svg_tag: img_class }}
{%- endif -%}
