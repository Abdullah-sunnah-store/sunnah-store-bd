{% doc %}
  Renders one product card for TSS House sections: image, name, an optional
  short note, and the price. The note reads the product metafield
  custom.card_note when it exists.

  @param {object} product - The product to show
  @param {string} [ratio] - Image aspect ratio, e.g. '3 / 4'. Defaults to 1
  @param {string} [sizes] - Image sizes attribute
  @param {boolean} [large] - Use the larger name size
  @param {boolean} [eager] - Load the image eagerly

  @example
  {% render 'tss-house-card', product: product, ratio: '3 / 4', sizes: '(min-width: 990px) 20vw, 50vw' %}
{% enddoc %}

{%- liquid
  assign img = product.featured_media.preview_image
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
  assign img_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign note = product.metafields.custom.card_note.value
-%}

<a class="th-card" href="{{ product.url }}">
  <div class="th-card__media" style="--th-ratio: {{ ratio | default: '1' }}">
    {%- if img -%}
      {{
        img
        | image_url: width: 1000
        | image_tag:
          widths: '240,360,480,640,800,1000',
          sizes: img_sizes,
          loading: loading,
          alt: img.alt | default: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- unless product.available -%}
      <span class="th-card__sold">{{ 'blocks.sold_out' | t }}</span>
    {%- endunless -%}
  </div>
  <span class="th-card__name{% if large %} th-card__name--lg{% endif %}">{{ product.title | escape }}</span>
  {%- if note != blank -%}
    <span class="th-note">{{ note | escape }}</span>
  {%- endif -%}
  <span class="th-card__price">
    {%- if product.price_varies -%}
      {%- assign price_min = product.price_min | money -%}
      {{ 'content.price_from' | t: price: price_min }}
    {%- else -%}
      {{ product.price | money }}
    {%- endif -%}
    {%- if product.compare_at_price > product.price -%}
      <s>{{ product.compare_at_price | money }}</s>
    {%- endif -%}
  </span>
</a>
