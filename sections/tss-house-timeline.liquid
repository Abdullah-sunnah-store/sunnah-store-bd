{% comment %}
  Section contract.
  TSS House — The year ahead. Occasions in date order along a thin line with
  a green dot for each: the expected date, then an image, the name and a short
  line linking to its collection. Each occasion is a block, in calendar order.
  @example
  <!-- templates/collection.occasions.json, after In season -->
{% endcomment %}

{% render 'tss-house-base' %}

{%- assign s = section.settings -%}
{%- assign uid = section.id -%}

<style>
  #th-year-{{ uid }} {
    padding-block: {{ s.padding_top | times: 0.66 | round }}px {{ s.padding_bottom | times: 0.66 | round }}px;
  }

  #th-year-{{ uid }} .th-year__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 12px;
  }

  #th-year-{{ uid }} .th-year__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    margin: 20px 0 0;
    padding: 0 0 0 20px;
    border-inline-start: 1px solid var(--th-line-strong);
    list-style: none;
  }

  #th-year-{{ uid }} .th-year__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  #th-year-{{ uid }} .th-year__dot {
    position: absolute;
    inset-block-start: 4px;
    inset-inline-start: -26px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--th-green);
  }

  @media (min-width: 750px) {
    #th-year-{{ uid }} .th-year__list {
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 24px;
      padding: 0;
      border-inline-start: 0;
      border-top: 1px solid var(--th-line-strong);
    }

    #th-year-{{ uid }} .th-year__item {
      margin-top: -6px;
    }

    #th-year-{{ uid }} .th-year__dot {
      position: static;
      flex: none;
    }

    #th-year-{{ uid }} .th-year__date {
      margin-top: 6px;
    }
  }

  @media (min-width: 990px) {
    #th-year-{{ uid }} {
      padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;
    }
  }
</style>

<section id="th-year-{{ uid }}" class="tss-section tss-house" aria-labelledby="th-year-{{ uid }}-h">
  <div class="th-wrap">
    <div class="th-year__head">
      <h2 class="th-h2" id="th-year-{{ uid }}-h">{{ s.heading | escape }}</h2>
      {%- if s.note != blank -%}
        <span class="th-note">{{ s.note | escape }}</span>
      {%- endif -%}
    </div>
    <ol class="th-year__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign c = b.collection
          assign href = b.link | default: c.url
          assign img = b.image | default: c.featured_image
          assign title = b.title | default: c.title
          assign text = b.text
          if b.show_count and c != blank
            assign text = text | append: ' · ' | append: c.products_count
          endif
        -%}
        <li class="th-year__item" {{ block.shopify_attributes }}>
          <span class="th-year__dot" aria-hidden="true"></span>
          {%- if b.date != blank -%}
            <span class="th-eyebrow th-year__date">{{ b.date | escape }}</span>
          {%- endif -%}
          <a class="th-card" href="{{ href | default: '#' }}">
            <span class="th-card__media" style="--th-ratio: 4 / 5">
              {%- if img != blank -%}
                {{
                  img
                  | image_url: width: 900
                  | image_tag:
                    widths: '300,450,600,900',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 90vw',
                    loading: 'lazy',
                    alt: img.alt | default: title
                }}
              {%- else -%}
                {{ 'collection-3' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            <span class="th-card__name th-card__name--lg">{{ title | escape }}</span>
            {%- if text != blank -%}
              <span class="th-card__text">{{ text | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "TSS House — Year ahead",
  "tag": "div",
  "class": "tss-house-timeline-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The year ahead" },
    { "type": "text", "id": "note", "label": "Note", "default": "Expected dates in Bangladesh. They follow the moon and may move by a day." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        { "type": "text", "id": "date", "label": "Expected date", "default": "About 10 March" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the collection image." },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to link to the collection." },
        { "type": "text", "id": "title", "label": "Name", "info": "Leave empty to use the collection title." },
        { "type": "text", "id": "text", "label": "Line" },
        { "type": "checkbox", "id": "show_count", "label": "Add product count", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "TSS House — Year ahead",
      "blocks": [
        { "type": "occasion", "settings": { "date": "From about 9 February", "title": "Ramadan", "text": "Journals, dua cards and Ramadan cards", "show_count": false } },
        { "type": "occasion", "settings": { "date": "About 10 March", "title": "Eid ul-Fitr", "text": "Salami cheque books and gifts for the family" } },
        { "type": "occasion", "settings": { "date": "April to May", "title": "Hajj & Umrah", "text": "For the one who’s leaving" } },
        { "type": "occasion", "settings": { "date": "About 17 May", "title": "Eid ul-Adha", "text": "Qurans, dua sets and gifts for the house" } }
      ]
    }
  ]
}
{% endschema %}
