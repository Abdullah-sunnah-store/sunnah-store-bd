{% comment %}
  TSS — Gift box
  A single-product gift box page. Phones and tablets get one centred column
  (the "Gift Box page B" design); from 990px the gallery sits sticky on the
  left with the choices on the right, and the du'a, inside and delivery bands
  run full width below both. In order:

    intro · eyebrow, serif title with an italic end, introduction
    gallery · swipeable photos with pill dots; a tap opens the photo viewer
    price · "From" price, proof and delivery lines
    Quantity · one, two or three boxes; each box after the first carries a
       free perfume as a property instead of a paid line
    Finish · tabs per box, the chosen colour's photo and round swatches
    The card · card choice per box and the optional name, sent as properties
    On the Nikah card · dark band with the du'a, its translation and source
    Inside · numbered list from the In the box blocks; a photo opens the viewer
    Complete the gift · perfume, miswak, hijab (shown less the set discount,
       which a matching automatic discount in Shopify admin must charge) and
       any Add-on product blocks
    Delivery · "Label | value" rows in two columns
    Your gift · the chosen box's photo, one line per item, total and Order now
    fixed bar with the total and Order now

  Without JavaScript the form still posts the first box with its card; the
  add-on lines and the other boxes need the script.

  @example
  <!-- templates/page.hafezi-gift-box.json with Box product set to the gift box,
       Perfume product set to the scent product and Miswak product set -->
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign box = s.product
  assign perfume = s.perfume_product
  assign perfume_collection = s.perfume_collection

  # A perfume collection, when it has products, replaces the single product.
  # The add-on shows the lowest price; each scent shows its own when they differ.
  assign has_perfume = false
  assign perfume_title = perfume.title
  assign perfume_price = perfume.price
  assign perfume_price_max = perfume.price_max
  if perfume_collection != blank and perfume_collection.products_count > 0
    assign has_perfume = true
    assign perfume_title = perfume_collection.title
    assign perfume_price = perfume_collection.products.first.price_min
    assign perfume_price_max = perfume_price
    for item in perfume_collection.products limit: 50
      if item.price_min < perfume_price
        assign perfume_price = item.price_min
      endif
      if item.price_max > perfume_price_max
        assign perfume_price_max = item.price_max
      endif
    endfor
  elsif perfume != blank
    assign has_perfume = true
    assign perfume_price = perfume.price_min
  endif
  assign scent_group = 'tss-gbx-' | append: uid | append: '-scent'
  assign perfume_prices_vary = false
  if perfume_price != perfume_price_max
    assign perfume_prices_vary = true
  endif
  assign miswak = s.miswak_product

  # Add-on thumbnails: the picked image wins, otherwise the product's own.
  assign perfume_image = s.perfume_image
  if perfume_image == blank
    if perfume_collection != blank and perfume_collection.products_count > 0
      assign perfume_image = perfume_collection.featured_image | default: perfume_collection.products.first.featured_image
    else
      assign perfume_image = perfume.featured_image
    endif
  endif
  assign miswak_image = s.miswak_image | default: miswak.featured_image
  assign perfume_label_text = s.perfume_label | default: perfume_title
  assign current = box.selected_or_first_available_variant
  assign colour_blocks = section.blocks | where: 'type', 'colour'
  assign card_blocks = section.blocks | where: 'type', 'card_image'
  assign addon_blocks = section.blocks | where: 'type', 'addon'
  assign colour_property = s.colour_property | default: 'Box colour'
  assign show_colours = true
  if colour_blocks.size == 0 and box.has_only_default_variant
    assign show_colours = false
  endif

  # Colour and card block images join the gallery after the product's own media.
  # "Colours only" keeps just the colour images, when there are any.
  assign colour_image_count = 0
  for block in colour_blocks
    if block.settings.image != blank
      assign colour_image_count = colour_image_count | plus: 1
    endif
  endfor
  assign colours_only = false
  if s.gallery == 'colours' and colour_image_count > 0
    assign colours_only = true
  endif

  assign media_count = box.media.size | at_most: 10
  if colours_only
    assign media_count = 0
  endif
  assign slide_count = media_count | plus: colour_image_count
  unless colours_only
    for block in card_blocks
      if block.settings.image != blank
        assign slide_count = slide_count | plus: 1
      endif
    endfor
  endunless

  # The Finish photo follows each box's colour: a colour block's image, or the
  # variant's own media. It opens on the colour the first box starts with.
  assign finish_first = ''
  assign finish_initial = ''
  if colour_blocks.size > 0
    for block in colour_blocks
      if block.settings.image != blank
        assign finish_first = 'colour-' | append: block.id
        break
      endif
    endfor
    if current.available
      for block in colour_blocks
        unless block.settings.sold_out
          if block.settings.image != blank
            assign finish_initial = 'colour-' | append: block.id
          endif
          break
        endunless
      endfor
    endif
  elsif show_colours
    for variant in box.variants
      if variant.featured_media
        assign finish_first = variant.featured_media.id | append: ''
        break
      endif
    endfor
    if current.featured_media
      assign finish_initial = current.featured_media.id | append: ''
    endif
  endif
  if finish_initial == blank
    assign finish_initial = finish_first
  endif
  assign has_finish = false
  if finish_first != blank
    assign has_finish = true
  endif

  # The colour line starts on the colour the first box opens with.
  assign first_colour_name = current.title
  assign first_mood = ''
  if colour_blocks.size > 0
    assign first_colour_name = colour_blocks.first.settings.name
    for block in colour_blocks
      unless block.settings.sold_out
        assign first_colour_name = block.settings.name
        assign first_mood = block.settings.mood
        break
      endunless
    endfor
  endif

  assign title = s.title | default: box.title | default: page.title
  assign card_options = s.card_options | newline_to_br | split: '<br />'
  assign card_property = s.card_property | default: 'Card'
  assign perfume_property = s.perfume_property | default: 'Perfume'
  assign name_property = s.name_label
  assign miswak_label_text = s.miswak_label | default: miswak.title

  # Hijab add-on, offered at a percentage off while it rides with the box.
  # The page shows the reduced price; an automatic discount must charge it.
  # Colours come from a collection (one product per colour, as in the set
  # builder) or from the variants of one product; swatches are painted from
  # "Name: #hex" lines matched against each colour's name.
  assign hijab = s.hijab_product
  assign hijab_collection = s.hijab_collection
  assign has_hijab = false
  if hijab_collection != blank and hijab_collection.products_count > 0
    assign has_hijab = true
  elsif hijab != blank
    assign has_hijab = true
  endif
  assign hijab_label_text = s.hijab_label | default: hijab_collection.title | default: hijab.title
  assign hijab_keep = 100 | minus: s.hijab_discount
  assign hijab_swatch_lines = s.hijab_swatch_colours | newline_to_br | split: '<br />'
  assign hijab_exclude = s.hijab_exclude | strip | downcase
  # When set, only colours whose name contains one of these words are offered.
  assign hijab_only = s.hijab_only | downcase | split: ','

  # A second fabric (Cherry) adds a switch under the hijab photo.
  assign hijab_group_count = 0
  if has_hijab
    assign hijab_group_count = 1
  endif
  if s.hijab_collection_2 != blank and s.hijab_collection_2.products_count > 0
    assign has_hijab = true
    assign hijab_group_count = hijab_group_count | plus: 1
  endif

  assign has_addons = false
  for block in addon_blocks
    if block.settings.product != blank
      assign has_addons = true
      break
    endif
  endfor

  # Inside list: one row per In the box block with a name or an image.
  assign inside_blocks = section.blocks | where: 'type', 'inside'
  assign inside_count = 0
  for block in inside_blocks
    if block.settings.image != blank or block.settings.name != blank
      assign inside_count = inside_count | plus: 1
    endif
  endfor

  assign has_dua = false
  if s.dua_arabic != blank or s.dua_translation != blank
    assign has_dua = true
  endif
  assign delivery_rows = s.delivery_rows | newline_to_br | split: '<br />'

  # Boxes on offer: one, two, or three.
  assign panel_count = 1
  if s.allow_two
    assign panel_count = 2
    if s.allow_three
      assign panel_count = 3
    endif
  endif

  assign has_card_band = false
  if card_options.size > 0 or s.name_label != blank
    assign has_card_band = true
  endif
  if has_perfume and panel_count > 1
    assign has_card_band = true
  endif

  assign finish_sizes = '(min-width: ' | append: s.column_width | append: 'px) ' | append: s.column_width | append: 'px, 100vw'
  # From 990px the gallery is the left column of two.
  assign hero_sizes = '(min-width: 1440px) 740px, (min-width: 990px) 52vw, ' | append: finish_sizes
-%}

{%- comment -%}
  The Finish photos, rendered once and placed in every box panel and the
  summary; the script shows the one matching that box's colour.
{%- endcomment -%}
{%- capture finish_html -%}
  {%- if colour_blocks.size > 0 -%}
    {%- for block in colour_blocks -%}
      {%- if block.settings.image != blank -%}
        {%- assign finish_key = 'colour-' | append: block.id -%}
        <div class="tss-gbx__finish-item" data-finish="{{ finish_key }}" {% unless finish_key == finish_initial %}hidden{% endunless %}>
          {{-
            block.settings.image
            | image_url: width: 1440
            | image_tag:
              widths: '480, 720, 960, 1200, 1440',
              sizes: finish_sizes,
              loading: 'lazy',
              alt: block.settings.image.alt | default: block.settings.name
          -}}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- elsif show_colours -%}
    {%- assign finish_seen = ',' -%}
    {%- for variant in box.variants -%}
      {%- if variant.featured_media -%}
        {%- liquid
          assign finish_key = variant.featured_media.id | append: ''
          assign finish_mark = ',' | append: finish_key | append: ','
          if finish_seen contains finish_mark
            continue
          endif
          assign finish_seen = finish_seen | append: finish_key | append: ','
        -%}
        <div class="tss-gbx__finish-item" data-finish="{{ finish_key }}" {% unless finish_key == finish_initial %}hidden{% endunless %}>
          {{-
            variant.featured_media.preview_image
            | image_url: width: 1440
            | image_tag:
              widths: '480, 720, 960, 1200, 1440',
              sizes: finish_sizes,
              loading: 'lazy',
              alt: variant.featured_media.alt | default: variant.title
          -}}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&display=swap">
{%- if has_dua -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri&display=swap">
{%- endif -%}

<style>
  #tss-gbx-{{ uid }} {
    --gbx-page: #efe9e1;
    --gbx-bg: #faf7f2;
    --gbx-ink: #2b2320;
    --gbx-ink-2: #4a423c;
    --gbx-muted: #6f675f;
    --gbx-soft: #8a8178;
    --gbx-line: #e6dfd5;
    --gbx-border: #d9d1c5;
    --gbx-green: #1b4332;
    --gbx-paper: #fffdf9;
    --gbx-tint: #f2ece3;
    --gbx-tint-line: #e2d9cc;
    --gbx-dot: #cfc6ba;
    --gbx-night: #14110e;
    --gbx-night-ink: #ede6dc;
    --gbx-night-muted: #c4beb6;
    --gbx-gold: #c9a86a;
    --gbx-sans: 'Outfit', system-ui, -apple-system, sans-serif;
    --gbx-serif: 'Cormorant Garamond', Georgia, serif;
    --gbx-col: {{ s.column_width }}px;
    --gbx-pad: 24px;

    background: var(--gbx-page);
    padding-block-end: {{ s.padding_bottom }}px;
    font-family: var(--gbx-sans);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--gbx-ink);
  }

  #tss-gbx-{{ uid }} .tss-gbx__col {
    position: relative;
    max-width: var(--gbx-col);
    margin-inline: auto;
    background: var(--gbx-bg);
  }

  #tss-gbx-{{ uid }} .tss-gbx__pad {
    padding-inline: var(--gbx-pad);
  }

  #tss-gbx-{{ uid }} .tss-gbx__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  #tss-gbx-{{ uid }} [hidden] {
    display: none !important;
  }

  #tss-gbx-{{ uid }} button,
  #tss-gbx-{{ uid }} input {
    font: inherit;
  }

  #tss-gbx-{{ uid }} a {
    color: var(--gbx-green);
  }

  #tss-gbx-{{ uid }} a:hover {
    color: var(--gbx-ink);
  }

  /* Bands: one per step, split by hairlines. */
  #tss-gbx-{{ uid }} .tss-gbx__band {
    min-width: 0;
    margin: 0;
    padding: 32px var(--gbx-pad);
    border: 0;
    border-top: 1px solid var(--gbx-line);
  }

  #tss-gbx-{{ uid }} .tss-gbx__band--bleed {
    padding-inline: 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__heading {
    display: block;
    width: 100%;
    margin: 0 0 20px;
    padding: 0;
    font-family: var(--gbx-serif);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--gbx-ink);
    overflow-wrap: anywhere;
  }

  /* Headings in full-bleed bands (Finish) keep the side padding. */
  #tss-gbx-{{ uid }} .tss-gbx__heading.tss-gbx__pad {
    padding-inline: var(--gbx-pad);
  }

  #tss-gbx-{{ uid }} .tss-gbx__heading-note {
    color: var(--gbx-soft);
  }

  /* ---------- intro ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__intro {
    padding-block: 28px 8px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__eyebrow {
    margin: 0 0 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gbx-muted);
  }

  #tss-gbx-{{ uid }} .tss-gbx__title {
    margin: 0;
    font-family: var(--gbx-serif);
    font-size: 40px;
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--gbx-ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  #tss-gbx-{{ uid }} .tss-gbx__title em {
    font-style: italic;
  }

  #tss-gbx-{{ uid }} .tss-gbx__subtitle {
    margin: 6px 0 0;
    font-family: var(--gbx-serif);
    font-size: 22px;
    font-style: italic;
    line-height: 1.2;
    color: var(--gbx-muted);
  }

  #tss-gbx-{{ uid }} .tss-gbx__lede {
    margin: 14px 0 0;
    color: var(--gbx-ink-2);
  }

  /* ---------- gallery ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__media {
    min-width: 0;
    padding-top: 20px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__stage {
    position: relative;
  }

  #tss-gbx-{{ uid }} .tss-gbx__rail {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    background: var(--gbx-tint);
  }

  #tss-gbx-{{ uid }} .tss-gbx__rail::-webkit-scrollbar {
    display: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__rail:focus-visible {
    outline: 2px solid var(--gbx-green);
    outline-offset: -2px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__slide {
    flex: none;
    width: 100%;
    aspect-ratio: {{ s.image_ratio }};
    scroll-snap-align: start;
  }

  #tss-gbx-{{ uid }} .tss-gbx__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  #tss-gbx-{{ uid }} .tss-gbx__zoom:focus-visible {
    outline: 2px solid var(--gbx-green);
    outline-offset: -4px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__slide img,
  #tss-gbx-{{ uid }} .tss-gbx__slide svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Colour shortcut over the photo, bottom start corner. */
  #tss-gbx-{{ uid }} .tss-gbx__quick {
    position: absolute;
    z-index: 1;
    inset-block-end: 16px;
    inset-inline-start: 16px;
    display: flex;
    gap: 10px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__qswatch {
    width: 40px;
    height: 40px;
    padding: 0;
    border: 4px solid var(--gbx-bg);
    border-radius: 50%;
    background: var(--swatch, var(--gbx-tint));
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
    cursor: pointer;
  }

  #tss-gbx-{{ uid }} .tss-gbx__qswatch[aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--gbx-ink), 0 1px 4px rgb(0 0 0 / 0.25);
  }

  #tss-gbx-{{ uid }} .tss-gbx__qswatch:focus-visible {
    outline: 2px solid var(--gbx-green);
    outline-offset: 3px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__qswatch:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  #tss-gbx-{{ uid }} .tss-gbx__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    padding-top: 6px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  #tss-gbx-{{ uid }} .tss-gbx__dot::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--gbx-dot);
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  #tss-gbx-{{ uid }} .tss-gbx__dot[aria-current='true']::before {
    width: 18px;
    background: var(--gbx-ink);
  }

  #tss-gbx-{{ uid }} .tss-gbx__dot:focus-visible {
    outline: 2px solid var(--gbx-green);
    outline-offset: -4px;
  }

  /* ---------- price ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__buy {
    padding-block: 8px 32px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__price {
    margin: 0;
    font-family: var(--gbx-serif);
    font-size: 26px;
    font-weight: 400;
  }

  #tss-gbx-{{ uid }} .tss-gbx__proof {
    margin: 0;
    font-size: 13px;
    color: var(--gbx-muted);
  }

  #tss-gbx-{{ uid }} .tss-gbx__fact {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--gbx-ink-2);
  }

  #tss-gbx-{{ uid }} .tss-gbx__fact--strong {
    font-weight: 400;
    color: var(--gbx-ink);
  }

  /* ---------- quantity ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__row {
    position: relative;
    display: block;
    min-height: 72px;
    padding: 16px 18px;
    border: 1px solid var(--gbx-border);
    border-radius: 14px;
    background: transparent;
    color: var(--gbx-ink);
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  #tss-gbx-{{ uid }} .tss-gbx__row-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__row-title {
    min-width: 0;
    font-size: 17px;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  #tss-gbx-{{ uid }} .tss-gbx__row-price {
    flex: none;
    font-size: 15px;
    white-space: nowrap;
  }

  #tss-gbx-{{ uid }} .tss-gbx__row-note {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    color: var(--gbx-muted);
  }

  #tss-gbx-{{ uid }} .tss-gbx__row-note--gift {
    color: var(--gbx-green);
  }

  /* Radios and checkboxes fill their tile so the whole tile is the target. */
  #tss-gbx-{{ uid }} .tss-gbx__row input,
  #tss-gbx-{{ uid }} .tss-gbx__tile input,
  #tss-gbx-{{ uid }} .tss-gbx__add input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  #tss-gbx-{{ uid }} .tss-gbx__row:has(input:checked) {
    border-color: var(--gbx-green);
    box-shadow: 0 0 0 0.5px var(--gbx-green);
    background: var(--gbx-paper);
  }

  #tss-gbx-{{ uid }} .tss-gbx__row:has(input:focus-visible),
  #tss-gbx-{{ uid }} .tss-gbx__tile:has(input:focus-visible),
  #tss-gbx-{{ uid }} .tss-gbx__add:has(input:focus-visible) {
    outline: 2px solid var(--gbx-green);
    outline-offset: 2px;
  }

  /* ---------- finish ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__tabs {
    display: flex;
    gap: 8px;
    margin: 0 var(--gbx-pad) 16px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__tab {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 12px;
    border: 1px solid var(--gbx-border);
    border-radius: 22px;
    background: transparent;
    font-size: 14px;
    color: var(--gbx-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  #tss-gbx-{{ uid }} .tss-gbx__tab[aria-selected='true'] {
