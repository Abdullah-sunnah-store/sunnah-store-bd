    transition: opacity 0.2s ease;
  }

  #tss-gbx-{{ uid }} .tss-gbx__summary .tss-gbx__submit {
    width: 100%;
  }

  #tss-gbx-{{ uid }} .tss-gbx__submit:hover {
    opacity: 0.92;
  }

  #tss-gbx-{{ uid }} .tss-gbx__submit:focus-visible {
    outline: 2px solid var(--gbx-green);
    outline-offset: 3px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__submit[aria-disabled='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  #tss-gbx-{{ uid }} .tss-gbx__ask {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 8px;
    font-size: 14px;
    text-align: center;
  }

  #tss-gbx-{{ uid }} .tss-gbx__trust {
    margin: 4px 0 0;
    font-size: 12px;
    text-align: center;
    color: var(--gbx-muted);
  }

  /* ---------- bar ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: var(--gbx-col);
    margin-inline: auto;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom)) var(--gbx-pad);
    border-top: 1px solid var(--gbx-line);
    background: rgb(250 247 242 / 0.96);
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-info {
    flex: 1 1 auto;
    min-width: 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-line {
    margin: 0;
    overflow: hidden;
    font-size: 12px;
    color: var(--gbx-ink-2);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-line:empty {
    display: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-total {
    margin: 0;
    font-family: var(--gbx-serif);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar .tss-gbx__submit {
    flex: none;
    height: 48px;
    font-size: 15px;
  }

  /* WhatsApp at the start of the bar, in WhatsApp's own green. */
  #tss-gbx-{{ uid }} .tss-gbx__bar-wa {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-wa:hover {
    color: #fff;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-wa:focus-visible {
    outline: 2px solid var(--gbx-green);
    outline-offset: 2px;
  }

  /* Room for the fixed bar goes at the page end, not between sections. */
  body:has(#tss-gbx-{{ uid }} .tss-gbx__bar) {
    padding-block-end: 80px;
  }

  /* The bar carries WhatsApp, so the floating launcher steps aside. */
  body:has(#tss-gbx-{{ uid }} .tss-gbx__bar-wa) .whatsapp-float,
  body:has(#tss-gbx-{{ uid }} .tss-gbx__bar-wa) .whatsapp-popup {
    display: none !important;
  }

  #tss-gbx-{{ uid }} .tss-gbx__empty {
    margin: 0;
    padding: 80px var(--gbx-pad);
    text-align: center;
    color: var(--gbx-muted);
  }

  /* ---------- photo viewer ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--gbx-night-ink);
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer::backdrop {
    background: rgb(20 17 14 / 0.94);
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    animation: tss-gbx-viewer-in 0.2s ease;
  }

  @keyframes tss-gbx-viewer-in {
    from {
      opacity: 0;
    }
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer-img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 140px);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer-close {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-end: 12px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 24px;
    background: var(--gbx-bg);
    color: var(--gbx-ink);
    cursor: pointer;
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: var(--gbx-col);
    width: 100%;
    padding-inline: 16px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer-name {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    margin: 0;
    font-family: var(--gbx-serif);
    font-size: 18px;
    text-align: center;
    overflow-wrap: anywhere;
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer-count {
    font-family: var(--gbx-sans);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--gbx-night-muted);
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer-step {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(237 230 220 / 0.3);
    border-radius: 22px;
    background: transparent;
    color: var(--gbx-night-ink);
    cursor: pointer;
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer-step[data-viewer-step='-1'] .tss-icon {
    transform: scaleX(-1);
  }

  /* Previous/next point the other way in right-to-left languages. */
  [dir='rtl'] #tss-gbx-{{ uid }} .tss-gbx__viewer-step .tss-icon {
    transform: scaleX(-1);
  }

  [dir='rtl'] #tss-gbx-{{ uid }} .tss-gbx__viewer-step[data-viewer-step='-1'] .tss-icon {
    transform: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer-step[data-off] {
    visibility: hidden;
  }

  #tss-gbx-{{ uid }} .tss-gbx__viewer-close:focus-visible,
  #tss-gbx-{{ uid }} .tss-gbx__viewer-step:focus-visible {
    outline: 2px solid var(--gbx-gold);
    outline-offset: 2px;
  }

  /* The bar steps away while the summary, with its own Order now, is on screen. */
  #tss-gbx-{{ uid }} .tss-gbx__bar {
    transition: transform 0.3s ease, visibility 0s linear 0s;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar[data-away] {
    transform: translateY(110%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0s linear 0.3s;
  }

  /* ---------- desktop: gallery on the left, choices on the right ----------
     The du'a, inside and delivery bands move below both columns, full width. */
  @media (min-width: 990px) {
    #tss-gbx-{{ uid }} {
      --gbx-pad: 0px;
      background: var(--gbx-bg);
    }

    /* Same measure as the TSS header, so the page lines up with the logo and cart. */
    #tss-gbx-{{ uid }} .tss-gbx__col {
      max-width: calc(var(--tss-max) + 2 * var(--tss-gutter));
      background: transparent;
    }

    #tss-gbx-{{ uid }} [data-form] {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      column-gap: 64px;
      align-items: start;
      padding: 40px var(--tss-gutter) 0;
    }

    #tss-gbx-{{ uid }} [data-form] > * {
      grid-column: 2;
      min-width: 0;
      max-width: 560px;
    }

    /* The media cell stretches over the right column's rows only, so the
       sticky gallery inside it stops before the full-width bands below. */
    #tss-gbx-{{ uid }} [data-form] > .tss-gbx__media {
      grid-column: 1;
      grid-row: 1 / span 40;
      align-self: stretch;
      max-width: none;
      padding-top: 0;
    }

    #tss-gbx-{{ uid }} .tss-gbx__media-inner {
      position: sticky;
      top: 24px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__rail {
      border-radius: 6px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__intro {
      padding-top: 8px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__title {
      font-size: 52px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__lede {
      max-width: 46ch;
      font-size: 16px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__buy {
      padding-bottom: 28px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__band {
      padding-block: 28px;
    }

    /* The gallery shows each colour, so the Finish photo would repeat it. */
    #tss-gbx-{{ uid }} .tss-gbx__panel .tss-gbx__finish,
    #tss-gbx-{{ uid }} .tss-gbx__finish--summary {
      display: none;
    }

    #tss-gbx-{{ uid }} .tss-gbx__colours {
      padding-top: 0;
    }

    #tss-gbx-{{ uid }} .tss-gbx__summary {
      margin-bottom: 8px;
      padding: 32px;
      border-radius: 16px;
    }

    #tss-gbx-{{ uid }} [data-form] > .tss-gbx__info {
      grid-column: 1 / -1;
      order: 10;
      max-width: none;
    }

    #tss-gbx-{{ uid }} .tss-gbx__dua {
      margin-top: 72px;
      padding: 72px 64px;
      border-radius: 16px;
      text-align: center;
    }

    #tss-gbx-{{ uid }} .tss-gbx__dua-arabic {
      font-size: 40px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__dua-translation {
      max-width: 36ch;
      margin-inline: auto;
      font-size: 26px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__info.tss-gbx__band {
      padding-block: 56px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__info .tss-gbx__heading {
      margin-bottom: 28px;
      font-size: 36px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__inside {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 40px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__inside-item:last-child {
      border-bottom: 0;
    }

    #tss-gbx-{{ uid }} .tss-gbx__inside-row {
      padding-block: 18px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__inside-thumb {
      width: 56px;
      height: 56px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__delivery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px;
      font-size: 15px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__bar {
      max-width: none;
      padding-inline: max(var(--tss-gutter), calc((100% - var(--tss-max)) / 2));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tss-gbx-{{ uid }} .tss-gbx__rail {
      scroll-behavior: auto;
    }

    #tss-gbx-{{ uid }} *,
    #tss-gbx-{{ uid }} *::before {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<section
  id="tss-gbx-{{ uid }}"
  class="tss-section tss-gbx"
  aria-label="{{ title | escape }}"
>
  {%- if box == blank -%}
    <div class="tss-gbx__col">
      <p class="tss-gbx__empty">{{ s.empty_text | escape }}</p>
    </div>
  {%- else -%}
    <div class="tss-gbx__col">
      <form
        id="tss-gbx-{{ uid }}-form"
        action="{{ routes.cart_add_url }}"
        method="post"
        data-form
      >
        <input type="hidden" name="quantity" value="1">

        <div class="tss-gbx__intro tss-gbx__pad">
          {%- if s.eyebrow != blank -%}
            <p class="tss-gbx__eyebrow">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          <h1 class="tss-gbx__title">
            {{- title | escape -}}
            {%- if s.title_emphasis != blank %} <em>{{ s.title_emphasis | escape }}</em>{% endif -%}
          </h1>
          {%- if s.subtitle != blank -%}
            <p class="tss-gbx__subtitle">{{ s.subtitle | escape }}</p>
          {%- endif -%}
          {%- if s.lede != blank -%}
            <p class="tss-gbx__lede">{{ s.lede | escape }}</p>
          {%- endif -%}
        </div>

        <div class="tss-gbx__media">
          {%- comment -%} Sticky on desktop; the media cell bounds it to the two-column rows. {%- endcomment -%}
          <div class="tss-gbx__media-inner">
          <div class="tss-gbx__stage">
            <div
              class="tss-gbx__rail"
              tabindex="0"
              role="region"
              aria-label="{{ box.title | escape }}"
              data-rail
            >
              {%- for media in box.media limit: 10 -%}
                {%- if colours_only -%}{%- break -%}{%- endif -%}
                {%- liquid
                  assign loading = 'lazy'
                  if forloop.first
                    assign loading = 'eager'
                  endif
                  assign slide_alt = media.alt | default: box.title
                -%}
                <div class="tss-gbx__slide" data-media-id="{{ media.id }}">
                  <button
                    type="button"
                    class="tss-gbx__zoom"
                    aria-haspopup="dialog"
                    aria-label="{{ 'actions.zoom' | t }}: {{ slide_alt | escape }}"
                    data-view="gallery"
                    data-src="{{ media.preview_image | image_url: width: 1600 }}"
                    data-name="{{ slide_alt | escape }}"
                  >
                    {{
                      media.preview_image
                      | image_url: width: 1440
                      | image_tag:
                        widths: '480, 720, 960, 1200, 1440',
                        sizes: hero_sizes,
                        loading: loading,
                        alt: slide_alt
                    }}
                  </button>
                </div>
              {%- endfor -%}
              {%- for block in colour_blocks -%}
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign loading = 'lazy'
                    if media_count == 0 and forloop.first
                      assign loading = 'eager'
                    endif
                    assign slide_alt = block.settings.image.alt | default: block.settings.name
                  -%}
                  <div class="tss-gbx__slide" data-media-id="colour-{{ block.id }}">
                    <button
                      type="button"
                      class="tss-gbx__zoom"
                      aria-haspopup="dialog"
                      aria-label="{{ 'actions.zoom' | t }}: {{ slide_alt | escape }}"
                      data-view="gallery"
                      data-src="{{ block.settings.image | image_url: width: 1600 }}"
                      data-name="{{ slide_alt | escape }}"
                    >
                      {{
                        block.settings.image
                        | image_url: width: 1440
                        | image_tag:
                          widths: '480, 720, 960, 1200, 1440',
                          sizes: hero_sizes,
                          loading: loading,
                          alt: slide_alt
                      }}
                    </button>
                  </div>
                {%- endif -%}
              {%- endfor -%}
              {%- for block in card_blocks -%}
                {%- if colours_only -%}{%- break -%}{%- endif -%}
                {%- if block.settings.image != blank -%}
                  {%- assign slide_alt = block.settings.image.alt | default: block.settings.card -%}
                  <div class="tss-gbx__slide" data-media-id="card-{{ block.id }}">
                    <button
                      type="button"
                      class="tss-gbx__zoom"
                      aria-haspopup="dialog"
                      aria-label="{{ 'actions.zoom' | t }}: {{ slide_alt | escape }}"
                      data-view="gallery"
                      data-src="{{ block.settings.image | image_url: width: 1600 }}"
                      data-name="{{ slide_alt | escape }}"
                    >
                      {{
                        block.settings.image
                        | image_url: width: 1440
                        | image_tag:
                          widths: '480, 720, 960, 1200, 1440',
                          sizes: hero_sizes,
                          loading: 'lazy',
                          alt: slide_alt
                      }}
                    </button>
                  </div>
                {%- endif -%}
              {%- endfor -%}
              {%- if slide_count == 0 -%}
                <div class="tss-gbx__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
              {%- endif -%}
            </div>
            {%- if show_colours and s.photo_swatches -%}
              {%- comment -%}
                Shortcut to the Finish step, filled by the script from the
                active box's colour choices; the step stays the source of truth.
              {%- endcomment -%}
              <div
                class="tss-gbx__quick"
                role="group"
                aria-label="{{ s.colour_line_label | escape }}"
                data-quick-colours
                hidden
              ></div>
            {%- endif -%}
          </div>

          {%- if slide_count > 1 -%}
            <div class="tss-gbx__dots">
              {%- for i in (1..slide_count) -%}
                <button
                  type="button"
                  class="tss-gbx__dot"
                  aria-label="{{ s.image_label | escape }} {{ i }} / {{ slide_count }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-dot="{{ forloop.index0 }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
          </div>
        </div>

        <div class="tss-gbx__buy tss-gbx__pad">
          <div class="tss-gbx__price-row">
            <p class="tss-gbx__price">
              {%- if s.price_prefix != blank -%}{{ s.price_prefix | escape }} {% endif -%}
              <span data-price>{{ current.price | money }}</span>
            </p>
            {%- if s.proof != blank -%}
              <p class="tss-gbx__proof">{{ s.proof | escape }}</p>
            {%- endif -%}
          </div>
          {%- if s.worth_text != blank -%}
            <p class="tss-gbx__fact">{{ s.worth_text | escape }}</p>
          {%- endif -%}
          {%- if s.dispatch_title != blank -%}
            <p class="tss-gbx__fact tss-gbx__fact--strong">{{ s.dispatch_title | escape }}</p>
          {%- endif -%}
          {%- if s.dispatch_text != blank -%}
            <p class="tss-gbx__fact">{{ s.dispatch_text | escape }}</p>
          {%- endif -%}
        </div>

        {%- if panel_count > 1 -%}
          <fieldset class="tss-gbx__band">
            <legend class="tss-gbx__heading">
              {{- s.count_label | escape -}}
              {%- if s.count_note != blank %} <span class="tss-gbx__heading-note">{{ s.count_note | escape }}</span>{% endif -%}
            </legend>
            <div class="tss-gbx__rows">
              {%- for n in (1..panel_count) -%}
                {%- liquid
                  case n
                    when 1
                      assign row_label = s.one_label
                      assign row_hint = s.one_hint
                    when 2
                      assign row_label = s.two_label
                      assign row_hint = s.two_hint
                    else
                      assign row_label = s.three_label
                      assign row_hint = s.three_hint
                  endcase
                -%}
                <label class="tss-gbx__row">
                  <input
                    type="radio"
                    name="tss-gbx-{{ uid }}-count"
                    value="{{ n }}"
                    data-count
                    {% if n == 1 %}
                      checked
                    {% endif %}
                  >
                  <span class="tss-gbx__row-top">
                    <span class="tss-gbx__row-title">{{ row_label | escape }}</span>
                    <span class="tss-gbx__row-price" data-count-price="{{ n }}">{{ current.price | times: n | money }}</span>
                  </span>
                  {%- if row_hint != blank -%}
                    <span class="tss-gbx__row-note{% if n > 1 %} tss-gbx__row-note--gift{% endif %}">{{ row_hint | escape }}</span>
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        {%- comment -%}
          Finish: with several boxes, tabs pick which box is being styled; the
          Finish and Card panels of that box show together.
        {%- endcomment -%}
        {%- if show_colours or has_finish -%}
          <div class="tss-gbx__band tss-gbx__band--bleed">
            <h2 class="tss-gbx__heading tss-gbx__pad">
              {{- s.colour_label | escape -}}
              {%- if s.colour_note != blank %} <span class="tss-gbx__heading-note">{{ s.colour_note | escape }}</span>{% endif -%}
            </h2>
            {%- if panel_count > 1 -%}
              <div class="tss-gbx__tabs" role="tablist" aria-label="{{ s.tabs_label | escape }}" data-only-many hidden>
                {%- for slot in (1..panel_count) -%}
                  {%- liquid
                    case slot
                      when 1
                        assign tab_label = s.box_one_label
                      when 2
                        assign tab_label = s.box_two_label
                      else
                        assign tab_label = s.box_three_label
                    endcase
                  -%}
                  <button
                    type="button"
                    class="tss-gbx__tab"
                    id="tss-gbx-{{ uid }}-tab-{{ slot }}"
                    role="tab"
                    aria-controls="tss-gbx-{{ uid }}-finish-{{ slot }}{% if has_card_band %} tss-gbx-{{ uid }}-card-{{ slot }}{% endif %}"
                    aria-selected="{% if slot == 1 %}true{% else %}false{% endif %}"
                    tabindex="{% if slot == 1 %}0{% else %}-1{% endif %}"
                    data-tab="{{ slot }}"
                  >
                    {{- tab_label | escape -}}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- for slot in (1..panel_count) -%}
              {%- liquid
                case slot
                  when 1
                    assign colour_name = ''
                  when 2
                    assign colour_name = 'tss-gbx-' | append: uid | append: '-colour-2'
                  else
                    assign colour_name = 'tss-gbx-' | append: uid | append: '-colour-3'
                endcase
              -%}
              <div
                class="tss-gbx__panel"
                id="tss-gbx-{{ uid }}-finish-{{ slot }}"
                data-box-panel="{{ slot }}"
                {% if slot > 1 %}
                  hidden
                {% endif %}
              >
                {%- if has_finish -%}
                  <div class="tss-gbx__finish" data-finish-slot="{{ slot }}">{{ finish_html }}</div>
                {%- endif -%}
                {%- capture colours_html -%}
                  {%- render 'tss-gift-box-colours',
                    box: box,
                    current: current,
                    colours: colour_blocks,
                    slot: slot,
                    name: colour_name,
                    colour_property: colour_property,
                    sold_out_label: s.sold_out_label
                  -%}
                {%- endcapture -%}
                {%- if show_colours -%}
                  <fieldset class="tss-gbx__colours">
                    <legend class="tss-gbx__colour-line">
                      {{- s.colour_line_label | escape }} ·
                      <span class="tss-gbx__colour-name" data-colour-name="{{ slot }}">{{ first_colour_name | escape }}</span>
                      <span class="tss-gbx__mood" data-mood-out="{{ slot }}">
                        {%- if first_mood != blank %}— {{ first_mood | escape }}{% endif -%}
                      </span>
                    </legend>
                    <div class="tss-gbx__swatch-row" data-colours="{{ slot }}">{{ colours_html }}</div>
                  </fieldset>
                {%- else -%}
                  <div data-colours="{{ slot }}" hidden>{{ colours_html }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          {%- comment -%} A box with a single variant and no colours still needs its hidden choice. {%- endcomment -%}
          {%- for slot in (1..panel_count) -%}
            {%- liquid
              case slot
                when 1
                  assign colour_name = ''
                when 2
                  assign colour_name = 'tss-gbx-' | append: uid | append: '-colour-2'
                else
                  assign colour_name = 'tss-gbx-' | append: uid | append: '-colour-3'
              endcase
            -%}
            <div data-colours="{{ slot }}" hidden>
              {%- render 'tss-gift-box-colours',
                box: box,
                current: current,
                colours: colour_blocks,
                slot: slot,
                name: colour_name,
                colour_property: colour_property,
                sold_out_label: s.sold_out_label
              -%}
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- if has_card_band -%}
          <div class="tss-gbx__band">
            <h2 class="tss-gbx__heading">
              {{- s.card_label | escape -}}
              {%- if s.card_note != blank %} <span class="tss-gbx__heading-note">{{ s.card_note | escape }}</span>{% endif -%}
            </h2>
            {%- if panel_count > 1 -%}
              <p class="tss-gbx__for" data-only-many data-active-box hidden></p>
            {%- endif -%}

            {%- for slot in (1..panel_count) -%}
              {%- liquid
                case slot
                  when 1
                    assign box_suffix = s.box_one_label
                    assign card_name = 'properties[' | append: card_property | append: ']'
                  when 2
                    assign box_suffix = s.box_two_label
                    assign card_name = 'tss-gbx-' | append: uid | append: '-card-2'
                  else
                    assign box_suffix = s.box_three_label
                    assign card_name = 'tss-gbx-' | append: uid | append: '-card-3'
                endcase
                assign scent_name = scent_group | append: '-' | append: slot
              -%}
              <div
                class="tss-gbx__panel"
                id="tss-gbx-{{ uid }}-card-{{ slot }}"
                data-box-panel="{{ slot }}"
                {% if slot > 1 %}
                  hidden
                {% endif %}
              >
                {%- if card_options.size > 0 -%}
                  <fieldset class="tss-gbx__set">
                    <legend class="tss-gbx__sr">
                      {{- s.card_label | escape -}}
                      <span data-only-many hidden> · {{ box_suffix | escape }}</span>
                    </legend>
                    <div class="tss-gbx__cards" data-cards="{{ slot }}">
                      {%- for card in card_options -%}
                        {%- assign card = card | strip -%}
                        {%- if card != blank -%}
                          {%- liquid
                            # A box variant named like this card shows its image; a Card image
                            # block with the same name overrides it.
                            assign card_media = ''
                            assign card_key = card | downcase
                            for variant in box.variants
                              assign variant_key = variant.title | strip | downcase
                              if variant_key == card_key
                                assign card_media = variant.featured_media.id
                                break
                              endif
                            endfor
                            for block in card_blocks
                              assign block_key = block.settings.card | strip | downcase
                              if block_key == card_key and block.settings.image != blank
                                assign card_media = 'card-' | append: block.id
                                break
                              endif
                            endfor
                          -%}
                          <label class="tss-gbx__tile">
                            <input
                              type="radio"
                              name="{{ card_name | escape }}"
                              value="{{ card | escape }}"
                              {% if card_media != blank %}
                                data-media="{{ card_media }}"
                              {% endif %}
                              {% if forloop.first %}
                                checked
                              {% endif %}
                            >
                            <span class="tss-gbx__tile-text">{{ card | escape }}</span>
                          </label>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endif -%}

                {%- if s.name_label != blank -%}
                  <div class="tss-gbx__name">
                    <label class="tss-gbx__name-label" for="tss-gbx-{{ uid }}-name-{{ slot }}">
                      {{- s.name_label | escape -}}
                      {%- if s.optional_label != blank %} <span>{{ s.optional_label | escape }}</span>{% endif -%}
                      <span class="tss-gbx__sr" data-only-many hidden> · {{ box_suffix | escape }}</span>
                    </label>
                    <input
                      id="tss-gbx-{{ uid }}-name-{{ slot }}"
                      class="tss-gbx__input"
                      type="text"
                      {% if slot == 1 %}
                        name="properties[{{ name_property | escape }}]"
                      {% endif %}
                      placeholder="{{ s.name_placeholder | escape }}"
                      maxlength="40"
                      autocomplete="off"
                      {% if s.name_help != blank %}
                        aria-describedby="tss-gbx-{{ uid }}-name-help-{{ slot }}"
                      {% endif %}
                      data-box-name="{{ slot }}"
                    >
                    {%- if s.name_help != blank -%}
                      <p class="tss-gbx__help" id="tss-gbx-{{ uid }}-name-help-{{ slot }}">{{ s.name_help | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- comment -%} With several boxes each gets a free perfume; a choice shows only when there are several scents. {%- endcomment -%}
                {%- if has_perfume and panel_count > 1 -%}
                  <div data-scent-group hidden>
                    <p class="tss-gbx__box-label" id="tss-gbx-{{ uid }}-scent-{{ slot }}">{{ box_suffix | escape }} · {{ s.scent_label | escape }}</p>
                    <div class="tss-gbx__scents" role="radiogroup" aria-labelledby="tss-gbx-{{ uid }}-scent-{{ slot }}">
                      {%- render 'tss-gift-box-scents',
                        collection: perfume_collection,
                        product: perfume,
                        slot: slot,
                        name: scent_name,
                        image: perfume_image,
                        label: perfume_label_text,
                        note: s.free_label,
                        show_price: false
                      -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if has_dua -%}
          <figure class="tss-gbx__dua tss-gbx__info">
            {%- if s.dua_eyebrow != blank -%}
              <p class="tss-gbx__dua-eyebrow">{{ s.dua_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if s.dua_arabic != blank -%}
              <p class="tss-gbx__dua-arabic" lang="ar" dir="rtl">{{ s.dua_arabic | escape }}</p>
            {%- endif -%}
            {%- if s.dua_translation != blank -%}
              <blockquote class="tss-gbx__dua-translation">{{ s.dua_translation | escape }}</blockquote>
            {%- endif -%}
            {%- if s.dua_source != blank -%}
              <figcaption class="tss-gbx__dua-source">{{ s.dua_source | escape }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}

        {%- if inside_count > 0 -%}
          <div class="tss-gbx__band tss-gbx__info tss-gbx__info--inside">
            <h2 class="tss-gbx__heading">
              {{- s.inside_label | escape -}}
              {%- if s.inside_note != blank %} <span class="tss-gbx__heading-note">{{ s.inside_note | escape }}</span>{% endif -%}
            </h2>
            <ol class="tss-gbx__inside">
              {%- assign inside_index = 0 -%}
              {%- for block in inside_blocks -%}
                {%- if block.settings.image != blank or block.settings.name != blank -%}
                  {%- assign inside_index = inside_index | plus: 1 -%}
                  {%- capture inside_body -%}
                    <span class="tss-gbx__inside-num" aria-hidden="true">
                      {%- if inside_index < 10 -%}0{%- endif -%}
                      {{- inside_index -}}
                    </span>
                    <span class="tss-gbx__inside-text">
                      <span class="tss-gbx__inside-name">{{ block.settings.name | escape }}</span>
                      {%- if block.settings.note != blank -%}
                        <span class="tss-gbx__inside-note">{{ block.settings.note | escape }}</span>
                      {%- endif -%}
                    </span>
                  {%- endcapture -%}
                  <li class="tss-gbx__inside-item" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      {%- comment -%} A photo opens in the viewer; the row still reads as a list item. {%- endcomment -%}
                      <button
                        type="button"
                        class="tss-gbx__inside-row"
                        aria-haspopup="dialog"
                        data-view="inside"
                        data-src="{{ block.settings.image | image_url: width: 1600 }}"
                        data-name="{{ block.settings.name | escape }}"
                      >
                        {{- inside_body -}}
                        {{-
                          block.settings.image
                          | image_url: width: 132
                          | image_tag: class: 'tss-gbx__inside-thumb', loading: 'lazy', widths: '44, 88, 132', sizes: '44px', alt: ''
                        -}}
                      </button>
                    {%- else -%}
                      <div class="tss-gbx__inside-row">{{ inside_body }}</div>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}

        {%- if has_perfume or miswak != blank or has_hijab or has_addons -%}
          <fieldset class="tss-gbx__band">
            <legend class="tss-gbx__heading">
              {{- s.addons_label | escape -}}
              {%- if s.addons_note != blank %} <span class="tss-gbx__heading-note">{{ s.addons_note | escape }}</span>{% endif -%}
            </legend>

            <div class="tss-gbx__extras">
              {%- if has_perfume -%}
                <div class="tss-gbx__extra" data-perfume-card>
                  {%- if perfume_image != blank -%}
                    {{- perfume_image | image_url: width: 216 | image_tag: class: 'tss-gbx__extra-img', loading: 'lazy', widths: '72, 144, 216', sizes: '72px', alt: '' -}}
                  {%- endif -%}
                  <div class="tss-gbx__extra-text">
                    <span class="tss-gbx__extra-name">{{ perfume_label_text | escape }}</span>
                    {%- if s.perfume_text != blank -%}
                      <span class="tss-gbx__extra-note">{{ s.perfume_text | escape }}</span>
                    {%- endif -%}
                    <span class="tss-gbx__extra-price" data-only-one>
                      {%- if perfume_prices_vary -%}
                        {%- assign perfume_from = perfume_price | money -%}
                        {{ 'content.price_from' | t: price: perfume_from }}
                      {%- else -%}
                        + {{ perfume_price | money }}
                      {%- endif -%}
                    </span>
                    {%- if s.perfume_free_text != blank and panel_count > 1 -%}
                      <span
                        class="tss-gbx__extra-free"
                        data-only-many
                        data-free-text="{{ s.perfume_free_text | escape }}"
                        hidden
                      >
                        {{- s.perfume_free_text | replace: '[count]', '2' | escape -}}
                      </span>
                    {%- endif -%}
                  </div>
                  <label class="tss-gbx__add" data-only-one>
                    <input type="checkbox" aria-label="{{ s.add_label | escape }} {{ perfume_label_text | escape }}" data-perfume-toggle>
                    <span class="tss-gbx__add-off" aria-hidden="true">{{ s.add_label | escape }}</span>
                    <span class="tss-gbx__add-on" aria-hidden="true">{{ s.added_label | escape }}</span>
                  </label>
                  {%- if panel_count > 1 -%}
                    <span class="tss-gbx__included" data-only-many hidden>{{ s.included_label | escape }}</span>
                  {%- endif -%}
                </div>
                <div class="tss-gbx__sub tss-gbx__scents" role="radiogroup" aria-label="{{ s.scent_label | escape }}" data-perfume-scents hidden>
                  {%- render 'tss-gift-box-scents',
                    collection: perfume_collection,
                    product: perfume,
                    slot: 0,
                    name: scent_group,
                    image: perfume_image,
                    label: perfume_label_text,
                    show_price: perfume_prices_vary
                  -%}
                </div>
              {%- endif -%}

              {%- if miswak != blank -%}
                <div class="tss-gbx__extra">
                  {%- if miswak_image != blank -%}
                    {{- miswak_image | image_url: width: 216 | image_tag: class: 'tss-gbx__extra-img', loading: 'lazy', widths: '72, 144, 216', sizes: '72px', alt: '' -}}
                  {%- endif -%}
                  <div class="tss-gbx__extra-text">
                    <span class="tss-gbx__extra-name">{{ miswak_label_text | escape }}</span>
                    {%- if s.miswak_text != blank -%}
                      <span class="tss-gbx__extra-note">{{ s.miswak_text | escape }}</span>
                    {%- endif -%}
                    <span class="tss-gbx__extra-price">
                      {%- if miswak.available -%}
                        + {{ miswak.price | money }}
                      {%- else -%}
                        {{ s.sold_out_label | escape }}
                      {%- endif -%}
                    </span>
                  </div>
                  <label class="tss-gbx__add">
                    <input
                      type="checkbox"
                      value="{{ miswak.selected_or_first_available_variant.id }}"
                      data-price="{{ miswak.price }}"
                      data-title="{{ miswak_label_text | escape }}"
                      aria-label="{{ s.add_label | escape }} {{ miswak_label_text | escape }}"
                      data-addon
                      {% unless miswak.available %}
                        disabled
                      {% endunless %}
                    >
                    <span class="tss-gbx__add-off" aria-hidden="true">{{ s.add_label | escape }}</span>
                    <span class="tss-gbx__add-on" aria-hidden="true">{{ s.added_label | escape }}</span>
                  </label>
                </div>
              {%- endif -%}

              {%- if has_hijab -%}
                {%- comment -%}
                  Hijab: photo with the fabric switch (Pashmina / Cherry) under
                  it; beside it the chosen colour's name and price, small round
                  swatches for the chosen fabric and a stepper. Each colour keeps
                  its own count, shown as a badge on its swatch; every counted
                  colour is its own line.
                {%- endcomment -%}
                <div class="tss-gbx__hijab" data-hijab>
                  <div class="tss-gbx__hijab-media">
                    <img alt="" width="600" height="600" loading="lazy" data-hijab-img hidden>
                  </div>
                  <div class="tss-gbx__hijab-body">
                    <span class="tss-gbx__hijab-name" data-hijab-name>{{ hijab_label_text | escape }}</span>
                    <div class="tss-gbx__hijab-price">
                      <span class="tss-gbx__extra-price">
                        <span data-hijab-sale></span>
                        {%- if s.hijab_discount > 0 %} <s data-hijab-full></s>{% endif -%}
                      </span>
                      {%- if s.hijab_badge != blank and s.hijab_discount > 0 -%}
                        <span class="tss-gbx__extra-badge">
                          {{- s.hijab_badge | replace: '[percent]', s.hijab_discount | escape -}}
                        </span>
                      {%- endif -%}
                    </div>

                    <div class="tss-gbx__swatches" role="group" aria-label="{{ s.hijab_choice_label | escape }}">
                      {%- assign first_open = true -%}
                      {%- for g in (1..2) -%}
                        {%- liquid
                          # Group 1 is the first fabric (collection, or one product);
                          # group 2 the second fabric's collection.
                          assign group_from_collection = false
                          assign group_items = nil
                          if g == 1
                            assign group_collection = hijab_collection
                            assign group_lines = hijab_swatch_lines
                            if hijab_collection != blank and hijab_collection.products_count > 0
                              assign group_from_collection = true
                              assign group_items = hijab_collection.products
                            elsif hijab != blank
                              assign group_items = hijab.handle | split: ','
                            endif
                          else
                            assign group_collection = s.hijab_collection_2
                            assign group_lines = s.hijab_swatch_colours_2 | newline_to_br | split: '<br />'
                            if group_collection != blank and group_collection.products_count > 0
                              assign group_from_collection = true
                              assign group_items = group_collection.products
                            endif
                          endif
                          if group_items == nil
                            continue
                          endif
                        -%}
                        {%- for entry in group_items limit: 50 -%}
                          {%- liquid
                            assign item = entry
                            unless group_from_collection
                              assign item = all_products[entry]
                            endunless
                            if hijab_exclude != blank
                              assign item_title = item.title | downcase
                              if item_title contains hijab_exclude
                                continue
                              endif
                            endif
                          -%}
                          {%- for variant in item.variants -%}
                            {%- liquid
                              unless variant.available
                                continue
                              endunless
                              assign piece_name = item.title
                              unless item.has_only_default_variant
                                if group_from_collection
                                  assign piece_name = item.title | append: ' ' | append: variant.title
                                else
                                  assign piece_name = variant.title
                                endif
                              endunless
                              if hijab_only.size > 0
                                assign piece_lower = piece_name | downcase
                                assign piece_wanted = false
                                for only_word in hijab_only
                                  assign only_word = only_word | strip
                                  if only_word != blank and piece_lower contains only_word
                                    assign piece_wanted = true
                                    break
                                  endif
                                endfor
                                unless piece_wanted
                                  continue
                                endunless
                              endif
                              assign piece_image = variant.featured_image | default: item.featured_image
                              assign piece_max = 99
                              if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
                                assign piece_max = variant.inventory_quantity | at_least: 0
                              endif
                              assign piece_sale = variant.price | times: hijab_keep | divided_by: 100

                              # The longest colour name found in the piece name wins, so
                              # "Mint Green" is not painted as "Mint".
                              assign piece_colour = ''
                              assign best_size = 0
                              assign piece_lower = piece_name | downcase
                              for line in group_lines
                                assign pair = line | split: ':'
                                if pair.size < 2
                                  continue
                                endif
                                assign colour_name = pair[0] | strip | downcase
                                if colour_name != blank and colour_name.size > best_size and piece_lower contains colour_name
                                  assign best_size = colour_name.size
                                  assign piece_colour = pair[1] | strip | remove: ';' | remove: '"'
                                endif
                              endfor
                              if piece_colour == blank
                                for value in item.options_with_values.first.values
                                  if value == variant.option1 and value.swatch.color
                                    assign piece_colour = value.swatch.color
                                  endif
                                endfor
                              endif
                            -%}
                            <button
                              type="button"
                              class="tss-gbx__hswatch"
                              aria-pressed="{% if first_open %}true{% else %}false{% endif %}"
                              aria-label="{{ piece_name | escape }}"
                              {% if piece_colour != blank %}
                                style="background-color: {{ piece_colour | escape }};"
                              {% elsif piece_image %}
                                style="background-image: url('{{ piece_image | image_url: width: 80, height: 80, crop: 'center' }}');"
                              {% endif %}
                              data-hijab-swatch
                              data-hijab-group="{{ g }}"
                              data-variant="{{ variant.id }}"
                              data-name="{{ piece_name | escape }}"
                              data-price="{{ piece_sale }}"
                              data-full="{{ variant.price }}"
                              data-max="{{ piece_max }}"
                              {% if piece_image %}
                                data-large="{{ piece_image | image_url: width: 600 }}"
                              {% endif %}
                              {% if g != 1 %}
                                hidden
                              {% endif %}
                            >
                              <span class="tss-gbx__hswatch-badge" data-badge hidden></span>
                            </button>
                            {%- assign first_open = false -%}
                          {%- endfor -%}
                        {%- endfor -%}
                      {%- endfor -%}
                    </div>
                    {%- capture hijab_stepper -%}
                      {%- if first_open -%}
                        <span class="tss-gbx__extra-note">{{ s.sold_out_label | escape }}</span>
                      {%- else -%}
                        <div class="tss-gbx__stepper">
                          <button type="button" aria-label="{{ s.remove_one_label | escape }}" data-hijab-dec>−</button>
                          <output aria-live="polite" data-hijab-qty>0</output>
                          <button type="button" aria-label="{{ s.add_one_label | escape }}" data-hijab-inc>+</button>
                        </div>
                      {%- endif -%}
                    {%- endcapture -%}
                    {%- comment -%} With one fabric there is no switch, so the stepper sits under the swatches. {%- endcomment -%}
                    {%- if hijab_group_count < 2 -%}
                      <div class="tss-gbx__hijab-qty">{{ hijab_stepper }}</div>
                    {%- endif -%}
                  </div>
                  {%- comment -%} Fabric switch and stepper share one row under the card. {%- endcomment -%}
                  {%- if hijab_group_count > 1 -%}
                  <div class="tss-gbx__hijab-foot">
                    {%- if hijab_group_count > 1 -%}
                      <div class="tss-gbx__hijab-tabs" role="group" aria-label="{{ s.hijab_fabric_label | escape }}">
                        {%- for g in (1..2) -%}
                          {%- liquid
                            if g == 1
                              assign tab_label = s.hijab_tab_1 | default: hijab_collection.title
                            else
                              assign tab_label = s.hijab_tab_2 | default: s.hijab_collection_2.title
                            endif
                          -%}
                          <button
                            type="button"
                            class="tss-gbx__hijab-tab"
                            aria-pressed="{% if g == 1 %}true{% else %}false{% endif %}"
                            data-hijab-tab="{{ g }}"
                          >
                            {{- tab_label | escape -}}
                          </button>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                    {{ hijab_stepper }}
                  </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- for block in addon_blocks -%}
                {%- liquid
                  assign addon = block.settings.product
                  if addon == blank
                    continue
                  endif
                  assign addon_label = block.settings.label | default: addon.title
                  assign addon_image = block.settings.image | default: addon.featured_image
                  assign addon_variant = addon.selected_or_first_available_variant
                -%}
                <div class="tss-gbx__extra" {{ block.shopify_attributes }}>
                  {%- if addon_image != blank -%}
                    {{- addon_image | image_url: width: 216 | image_tag: class: 'tss-gbx__extra-img', loading: 'lazy', widths: '72, 144, 216', sizes: '72px', alt: '' -}}
                  {%- endif -%}
                  <div class="tss-gbx__extra-text">
                    <span class="tss-gbx__extra-name">{{ addon_label | escape }}</span>
                    {%- if block.settings.text != blank -%}
                      <span class="tss-gbx__extra-note">{{ block.settings.text | escape }}</span>
                    {%- endif -%}
                    <span class="tss-gbx__extra-price">
                      {%- if addon.available -%}
                        + {{ addon_variant.price | money }}
                      {%- else -%}
                        {{ s.sold_out_label | escape }}
                      {%- endif -%}
                    </span>
                  </div>
                  <label class="tss-gbx__add">
                    <input
                      type="checkbox"
                      value="{{ addon_variant.id }}"
                      data-price="{{ addon_variant.price }}"
                      data-title="{{ addon_label | escape }}"
                      aria-label="{{ s.add_label | escape }} {{ addon_label | escape }}"
                      data-addon
                      {% unless addon.available %}
                        disabled
                      {% endunless %}
                    >
                    <span class="tss-gbx__add-off" aria-hidden="true">{{ s.add_label | escape }}</span>
                    <span class="tss-gbx__add-on" aria-hidden="true">{{ s.added_label | escape }}</span>
                  </label>
                </div>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        {%- if s.delivery_rows != blank -%}
          <div class="tss-gbx__band tss-gbx__info tss-gbx__info--delivery">
            <h2 class="tss-gbx__heading">
              {{- s.delivery_title | escape -}}
              {%- if s.delivery_subtitle != blank %} <span class="tss-gbx__heading-note">{{ s.delivery_subtitle | escape }}</span>{% endif -%}
            </h2>
            <dl class="tss-gbx__delivery">
              {%- for row in delivery_rows -%}
                {%- assign parts = row | split: '|' -%}
                {%- assign row_label = parts[0] | strip -%}
                {%- if row_label != blank -%}
                  <div>
                    <dt>{{ row_label | escape }}</dt>
                    {%- if parts[1] != blank -%}
                      <dd>{{ parts[1] | strip | escape }}</dd>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </dl>
          </div>
        {%- endif -%}

        <div class="tss-gbx__summary" id="tss-gbx-{{ uid }}-summary">
          {%- if s.summary_title != blank -%}
            <h2 class="tss-gbx__heading tss-gbx__heading--large">
              {{- s.summary_title | escape -}}
              {%- if s.summary_note != blank %} <span class="tss-gbx__heading-note">{{ s.summary_note | escape }}</span>{% endif -%}
            </h2>
          {%- endif -%}
          {%- if has_finish -%}
            <div class="tss-gbx__finish tss-gbx__finish--summary" data-finish-slot="active">{{ finish_html }}</div>
          {%- endif -%}
          <ul class="tss-gbx__lines" data-lines></ul>
          <div class="tss-gbx__total">
            <span>{{ s.total_label | escape }}</span>
            <span class="tss-gbx__total-value" data-total>{{ current.price | money }}</span>
          </div>
          {%- if s.delivery_note != blank -%}
            <p class="tss-gbx__note">{{ s.delivery_note | escape }}</p>
          {%- endif -%}
          <p class="tss-gbx__hint" role="status" data-hint></p>
          <button type="submit" class="tss-gbx__submit" data-submit>{{ s.button_label | escape }}</button>
          {%- liquid
            assign wa_number = s.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
            assign wa_text = s.whatsapp_message | replace: '[title]', title
          -%}
          {%- if wa_number != blank and s.whatsapp_link_label != blank -%}
            <a class="tss-gbx__ask" href="https://wa.me/{{ wa_number }}{% if wa_text != blank %}?text={{ wa_text | url_encode }}{% endif %}" target="_blank" rel="noopener">
              {{- s.whatsapp_link_label | escape -}}
            </a>
          {%- endif -%}
          {%- if s.trust_line != blank -%}
            <p class="tss-gbx__trust">{{ s.trust_line | escape }}</p>
          {%- endif -%}
        </div>
      </form>

      <dialog class="tss-gbx__viewer" aria-labelledby="tss-gbx-{{ uid }}-viewer-name" data-viewer>
        <button
          type="button"
          class="tss-gbx__viewer-close"
          aria-label="{{ 'accessibility.close_dialog' | t }}"
          data-viewer-close
        >
          {%- render 'tss-icon', icon: 'x', size: 20, stroke: 1.5 -%}
        </button>
        <img class="tss-gbx__viewer-img" alt="" width="1600" height="1600" data-viewer-img>
        <div class="tss-gbx__viewer-bar">
          <button
            type="button"
            class="tss-gbx__viewer-step"
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
            data-viewer-step="-1"
          >
            {%- render 'tss-icon', icon: 'chevron-right', size: 18, stroke: 1.5 -%}
          </button>
          <p class="tss-gbx__viewer-name">
            <span id="tss-gbx-{{ uid }}-viewer-name" data-viewer-name></span>
            <span class="tss-gbx__viewer-count" data-viewer-count></span>
          </p>
          <button
            type="button"
            class="tss-gbx__viewer-step"
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
            data-viewer-step="1"
          >
            {%- render 'tss-icon', icon: 'chevron-right', size: 18, stroke: 1.5 -%}
          </button>
        </div>
      </dialog>
    </div>

    <div class="tss-gbx__bar">
      {%- if wa_number != blank -%}
        <a
          class="tss-gbx__bar-wa"
          href="https://wa.me/{{ wa_number }}{% if wa_text != blank %}?text={{ wa_text | url_encode }}{% endif %}"
          target="_blank"
          rel="noopener"
          aria-label="{{ s.whatsapp_label | default: 'Chat on WhatsApp' | escape }}"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.63"/>
          </svg>
        </a>
      {%- endif -%}
      <div class="tss-gbx__bar-info">
        <p class="tss-gbx__bar-line" data-bar-line></p>
        <p class="tss-gbx__bar-total" data-total>{{ current.price | money }}</p>
      </div>
      <button type="submit" form="tss-gbx-{{ uid }}-form" class="tss-gbx__submit" data-submit>
        {{- s.button_label | escape -}}
      </button>
    </div>
  {%- endif -%}
</section>

{%- if box != blank -%}
  <script>
    (function () {
      var root = document.getElementById('tss-gbx-{{ uid }}');
      if (!root || root.hasAttribute('data-ready')) return;
      root.setAttribute('data-ready', '');

      var ADD_URL = {{ routes.cart_add_url | append: '.js' | json }};
      var CART_URL = {{ routes.cart_url | json }};
      var AFTER_ADD = {{ s.after_add | json }};
      var MONEY_FORMAT = {{ shop.money_format | strip_html | json }};
      var COLOUR = {{ colour_property | json }};
      var CARD = {{ card_property | json }};
      var PERFUME = {{ perfume_property | json }};
      var NAME = {{ name_property | json }};
      var LINK = {{ s.link_property | default: 'For' | json }};
      var HAS_PERFUME = {{ has_perfume | json }};
      var MAX = {{ panel_count }};
      var T = {
        adding: {{ s.adding_label | json }},
        error: {{ s.error_text | json }},
        free: {{ s.free_label | json }},
        box: {{ s.box_label | default: 'Box' | json }},
        perfume: {{ perfume_label_text | json }},
        hijab: {{ hijab_label_text | json }},
        offer: {% if s.hijab_discount > 0 %}{{ s.hijab_badge | replace: '[percent]', s.hijab_discount | json }}{% else %}''{% endif %}
      };
      // Indexed by box number (1–3).
      var BOX = [null, {{ s.box_one_label | json }}, {{ s.box_two_label | json }}, {{ s.box_three_label | json }}];
      var COUNT = [null, {{ s.one_label | json }}, {{ s.two_label | json }}, {{ s.three_label | json }}];
      var COUNT_NOTE = [null, '', {{ s.two_note | json }}, {{ s.three_note | json }}];
      var OFFER = {{ s.hijab_offer_property | default: 'Offer' | json }};

      var form = root.querySelector('[data-form]');
      var rail = root.querySelector('[data-rail]');
      var dots = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
      var submits = Array.prototype.slice.call(root.querySelectorAll('[data-submit]'));
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-box-panel]'));
      var totals = root.querySelectorAll('[data-total]');
      var price = root.querySelector('[data-price]');
      var hint = root.querySelector('[data-hint]');
      var lines = root.querySelector('[data-lines]');
      var barLine = root.querySelector('[data-bar-line]');
      var activeBox = root.querySelector('[data-active-box]');
      var perfumeToggle = root.querySelector('[data-perfume-toggle]');
      var perfumeCard = root.querySelector('[data-perfume-card]');
      var scents = root.querySelector('[data-perfume-scents]');
      var addons = Array.prototype.slice.call(root.querySelectorAll('[data-addon]'));
      var hijabCard = root.querySelector('[data-hijab]');
      var hijabSwatches = Array.prototype.slice.call(root.querySelectorAll('[data-hijab-swatch]'));
      var hijabImg = root.querySelector('[data-hijab-img]');
      var hijabName = root.querySelector('[data-hijab-name]');
      var hijabSale = root.querySelector('[data-hijab-sale]');
      var hijabFull = root.querySelector('[data-hijab-full]');
      var hijabQtyOut = root.querySelector('[data-hijab-qty]');
      var hijabDec = root.querySelector('[data-hijab-dec]');
      var hijabInc = root.querySelector('[data-hijab-inc]');
      var hijabTabs = Array.prototype.slice.call(root.querySelectorAll('[data-hijab-tab]'));
      var hijabQty = {};
      var hijabActive = hijabSwatches[0] || null;
      var hijabGroup = hijabActive ? hijabActive.getAttribute('data-hijab-group') : '1';
      var labels = submits.map(function (b) { return b.textContent; });
      var active = 1;
      var busy = false;

      // Shopify's money_format is a Liquid fragment, not a number format.
      function money(cents) {
        var value = (cents || 0) / 100;
        function withCommas(n) {
          var parts = n.split('.');
          parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
          return parts.join('.');
        }
        return String(MONEY_FORMAT).replace(/\{\{\s*(\w+)\s*\}\}/, function (_, token) {
          switch (token) {
            case 'amount_no_decimals':
              return withCommas(String(Math.round(value)));
            case 'amount_with_comma_separator':
              return withCommas(value.toFixed(2)).replace(/,/g, ' ').replace('.', ',');
            case 'amount_no_decimals_with_comma_separator':
              return withCommas(String(Math.round(value))).replace(/,/g, '.');
            case 'amount_no_decimals_with_space_separator':
              return withCommas(String(Math.round(value))).replace(/,/g, ' ');
            default:
              return withCommas(value.toFixed(2));
          }
        });
      }

      function picked(selector) {
        return root.querySelector(selector + ' input:checked');
      }

      function count() {
        var input = root.querySelector('[data-count]:checked');
        var n = input ? parseInt(input.value, 10) : 1;
        return Math.min(Math.max(n || 1, 1), MAX);
      }

      function cents(input) {
        return input ? parseInt(input.getAttribute('data-price'), 10) || 0 : 0;
      }

      function colourOf(slot) {
        return picked('[data-colours="' + slot + '"]');
      }

      // "Navy Floral, Nikah Dua" for one box.
      function describe(slot) {
        var colour = colourOf(slot);
        var card = picked('[data-cards="' + slot + '"]');
        var parts = [];
        if (colour) parts.push(colour.getAttribute('data-title'));
        if (card) parts.push(card.value);
        return parts.join(', ');
      }

      function state() {
        var n = count();
        var first = colourOf(1);
        var boxes = [];
        for (var i = 1; i <= n; i++) boxes.push(colourOf(i) || first);
        var scent = n === 1 && perfumeToggle && perfumeToggle.checked ? picked('[data-perfume-scents]') : null;
        var extras = addons.filter(function (input) { return input.checked && !input.disabled; });
        // Every hijab colour with a count, in swatch order.
        var hijabs = hijabSwatches
          .map(function (el) { return { el: el, qty: hijabQty[el.getAttribute('data-variant')] || 0 }; })
          .filter(function (h) { return h.qty > 0; });
        var total = boxes.reduce(function (sum, input) { return sum + cents(input); }, 0);
        total += cents(scent);
        total += extras.reduce(function (sum, input) { return sum + cents(input); }, 0);
        total += hijabs.reduce(function (sum, h) { return sum + cents(h.el) * h.qty; }, 0);
        return { n: n, many: n > 1, first: first, boxes: boxes, scent: scent, extras: extras, hijabs: hijabs, total: total };
      }

      function addLine(label, value) {
        var item = document.createElement('li');
        var name = document.createElement('span');
        var amount = document.createElement('span');
        item.className = 'tss-gbx__line';
        name.textContent = label;
        amount.textContent = value;
        item.appendChild(name);
        item.appendChild(amount);
        lines.appendChild(item);
      }

      function renderLines(st) {
        if (!lines) return;
        lines.textContent = '';
        if (st.many) {
          st.boxes.forEach(function (input, i) {
            addLine(BOX[i + 1] + ': ' + describe(i + 1), money(cents(input)));
          });
          if (HAS_PERFUME) addLine(st.n + ' × ' + T.perfume, T.free);
        } else {
          addLine(T.box + ': ' + describe(1), money(cents(st.first)));
          if (st.scent) {
            var several = scents && scents.querySelectorAll('input').length > 1;
            addLine(several ? T.perfume + ' – ' + st.scent.getAttribute('data-title') : T.perfume, money(cents(st.scent)));
          }
        }
        st.extras.forEach(function (input) {
          addLine(input.getAttribute('data-title'), money(cents(input)));
        });
        st.hijabs.forEach(function (h) {
          var label = hijabSwatches.length > 1 ? h.el.getAttribute('data-name') : T.hijab;
          addLine(label + (h.qty > 1 ? ' × ' + h.qty : ''), money(cents(h.el) * h.qty));
        });
      }

      // Each Finish photo shows its box's colour; the summary follows the active box.
      function paintFinish() {
        root.querySelectorAll('[data-finish-slot]').forEach(function (frame) {
          var value = frame.getAttribute('data-finish-slot');
          var slot = value === 'active' ? active : parseInt(value, 10);
          var colour = colourOf(slot);
          var key = colour && colour.getAttribute('data-media');
          var match = key ? frame.querySelector('[data-finish="' + key + '"]') : null;
          if (!match) return;
          Array.prototype.forEach.call(frame.querySelectorAll('[data-finish]'), function (item) {
            item.hidden = item !== match;
          });
        });
      }

      function render() {
        var st = state();
        if (active > st.n) active = 1;

        root.querySelectorAll('[data-only-one]').forEach(function (el) { el.hidden = st.many; });
        root.querySelectorAll('[data-only-many]').forEach(function (el) { el.hidden = !st.many; });

        // Several boxes turn the box panels into tabs; one box shows the first panel only.
        panels.forEach(function (el) {
          var slot = parseInt(el.getAttribute('data-box-panel'), 10);
          el.hidden = slot !== active;
          if (st.many) {
            el.setAttribute('role', 'tabpanel');
            el.setAttribute('aria-labelledby', 'tss-gbx-{{ uid }}-tab-' + slot);
          } else {
            el.removeAttribute('role');
            el.removeAttribute('aria-labelledby');
          }
        });
        tabs.forEach(function (tab) {
          var slot = parseInt(tab.getAttribute('data-tab'), 10);
          tab.hidden = slot > st.n;
          tab.setAttribute('aria-selected', slot === active ? 'true' : 'false');
          tab.tabIndex = slot === active ? 0 : -1;
        });
        if (activeBox) activeBox.textContent = BOX[active] || '';

        root.querySelectorAll('[data-colour-name]').forEach(function (el) {
          var colour = colourOf(el.getAttribute('data-colour-name'));
          if (colour) el.textContent = colour.getAttribute('data-title');
        });
        root.querySelectorAll('[data-mood-out]').forEach(function (el) {
          var colour = colourOf(el.getAttribute('data-mood-out'));
          var mood = (colour && colour.getAttribute('data-mood')) || '';
          el.textContent = mood ? '— ' + mood : '';
        });

        // A single scent needs no choice; it stays checked behind the scenes.
        root.querySelectorAll('[data-scent-group]').forEach(function (group) {
          group.hidden = !st.many || group.querySelectorAll('input').length < 2;
        });
        if (scents) {
          scents.hidden = st.many || !(perfumeToggle && perfumeToggle.checked) || scents.querySelectorAll('input').length < 2;
        }
        root.querySelectorAll('[data-free-text]').forEach(function (el) {
          el.textContent = el.getAttribute('data-free-text').replace(/\[count\]/g, st.n);
        });
        if (perfumeCard) {
          perfumeCard.toggleAttribute('data-on', st.many || !!(perfumeToggle && perfumeToggle.checked));
        }

        // The hijab card shows the active colour: photo, name, prices and its count.
        if (hijabCard && hijabActive) {
          var activeId = hijabActive.getAttribute('data-variant');
          var activeQty = hijabQty[activeId] || 0;
          var large = hijabActive.getAttribute('data-large');
          if (hijabImg && large) {
            if (hijabImg.getAttribute('src') !== large) hijabImg.src = large;
            hijabImg.hidden = false;
          }
          if (hijabName) hijabName.textContent = hijabActive.getAttribute('data-name');
          if (hijabSale) hijabSale.textContent = '+ ' + money(cents(hijabActive));
          if (hijabFull) hijabFull.textContent = money(parseInt(hijabActive.getAttribute('data-full'), 10));
          if (hijabQtyOut) hijabQtyOut.textContent = activeQty;
          if (hijabDec) hijabDec.disabled = activeQty <= 0;
          if (hijabInc) hijabInc.disabled = activeQty >= (parseInt(hijabActive.getAttribute('data-max'), 10) || 99);
          hijabTabs.forEach(function (tab) {
            tab.setAttribute('aria-pressed', tab.getAttribute('data-hijab-tab') === hijabGroup ? 'true' : 'false');
          });
          hijabSwatches.forEach(function (el) {
            var qty = hijabQty[el.getAttribute('data-variant')] || 0;
            var badge = el.querySelector('[data-badge]');
            el.hidden = el.getAttribute('data-hijab-group') !== hijabGroup;
            el.setAttribute('aria-pressed', el === hijabActive ? 'true' : 'false');
            if (badge) {
              badge.textContent = qty;
              badge.hidden = qty === 0;
            }
          });
          hijabCard.setAttribute('data-count', st.hijabs.reduce(function (sum, h) { return sum + h.qty; }, 0));
        }

        paintQuick();
        paintFinish();

        var text = money(st.total);
        totals.forEach(function (el) { el.textContent = text; });
        if (price && st.first) price.textContent = money(cents(st.first));

        // Each count row prices its boxes in the colours chosen so far.
        for (var k = 1; k <= MAX; k++) {
          var out = root.querySelector('[data-count-price="' + k + '"]');
          if (!out || !st.first) continue;
          var sum = 0;
          for (var i = 1; i <= k; i++) sum += cents(colourOf(i) || st.first);
          out.textContent = money(sum);
        }

        renderLines(st);
        if (barLine) {
          barLine.textContent = st.many
            ? [COUNT[st.n], HAS_PERFUME ? COUNT_NOTE[st.n] : ''].filter(Boolean).join(' · ')
            : describe(1);
        }

        submits.forEach(function (b, i) {
          b.setAttribute('aria-disabled', busy || !st.first ? 'true' : 'false');
          b.textContent = busy ? T.adding : labels[i];
        });
      }

      /* ---------- colour shortcut on the photo ---------- */
      var quick = root.querySelector('[data-quick-colours]');
      var quickFor = 0;

      // One dot per swatched colour of the active box; a tap checks that
      // radio, so the step, photo, price and summary follow as usual.
      function paintQuick() {
        if (!quick) return;
        if (quickFor !== active) {
          quickFor = active;
          quick.replaceChildren();
          var group = root.querySelector('[data-colours="' + active + '"]');
          var inputs = group ? Array.prototype.slice.call(group.querySelectorAll('input[type="radio"]')) : [];
          inputs.forEach(function (input) {
            var tile = input.closest('.tss-gbx__tile');
            var swatch = tile && tile.querySelector('.tss-gbx__swatch');
            if (!swatch) return;
            var dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'tss-gbx__qswatch';
            dot.style.setProperty('--swatch', swatch.style.getPropertyValue('--swatch'));
            dot.setAttribute('aria-label', input.getAttribute('data-title') || input.value);
            dot.disabled = input.disabled;
            dot.__input = input;
            dot.addEventListener('click', function () {
              if (input.checked || input.disabled) return;
              input.checked = true;
              input.dispatchEvent(new Event('change', { bubbles: true }));
            });
            quick.appendChild(dot);
          });
          quick.hidden = quick.children.length < 2;
        }
        Array.prototype.forEach.call(quick.children, function (dot) {
          dot.setAttribute('aria-pressed', dot.__input.checked ? 'true' : 'false');
        });
      }

      /* ---------- photo viewer: gallery and inside rows ---------- */
      var viewer = root.querySelector('[data-viewer]');
      var viewList = [];
      var viewIndex = 0;
      var viewReturn = null;

      function showView(index) {
        var count = viewList.length;
        if (!count) return;
        viewIndex = (index + count) % count;
        var opener = viewList[viewIndex];
        var img = viewer.querySelector('[data-viewer-img]');
        var name = viewer.querySelector('[data-viewer-name]');
        var counter = viewer.querySelector('[data-viewer-count]');
        img.src = opener.getAttribute('data-src');
        img.alt = opener.getAttribute('data-name') || '';
        name.textContent = opener.getAttribute('data-name') || '';
        counter.textContent = count > 1 ? viewIndex + 1 + ' / ' + count : '';
        viewer.querySelectorAll('[data-viewer-step]').forEach(function (step) {
          step.toggleAttribute('data-off', count < 2);
          step.disabled = count < 2;
        });
      }

      if (viewer && typeof viewer.showModal === 'function') {
        root.addEventListener('click', function (event) {
          var opener = event.target.closest('[data-view]');
          if (!opener || !root.contains(opener)) return;
          viewList = Array.prototype.slice.call(
            root.querySelectorAll('[data-view="' + opener.getAttribute('data-view') + '"]')
          );
          viewReturn = opener;
          showView(viewList.indexOf(opener));
          viewer.showModal();
        });

        viewer.addEventListener('click', function (event) {
          // A click on the backdrop lands on the dialog itself.
          if (event.target === viewer || event.target.closest('[data-viewer-close]')) {
            viewer.close();
            return;
          }
          var step = event.target.closest('[data-viewer-step]');
          if (step) showView(viewIndex + parseInt(step.getAttribute('data-viewer-step'), 10));
        });

        viewer.addEventListener('keydown', function (event) {
          if (viewList.length < 2) return;
          var rtl = getComputedStyle(viewer).direction === 'rtl';
          if (event.key === 'ArrowRight') showView(viewIndex + (rtl ? -1 : 1));
          else if (event.key === 'ArrowLeft') showView(viewIndex + (rtl ? 1 : -1));
        });

        viewer.addEventListener('close', function () {
          if (viewReturn) viewReturn.focus();
        });
      }

      /* ---------- tabs ---------- */
      function selectTab(slot, focus) {
        active = slot;
        render();
        showVariantMedia(colourOf(slot));
        if (focus) {
          var tab = root.querySelector('[data-tab="' + slot + '"]');
          if (tab) tab.focus();
        }
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          selectTab(parseInt(tab.getAttribute('data-tab'), 10), false);
        });
        tab.addEventListener('keydown', function (event) {
          var keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
          if (keys.indexOf(event.key) === -1) return;
          event.preventDefault();
          var n = count();
          var rtl = getComputedStyle(tab).direction === 'rtl';
          var forward = (event.key === 'ArrowRight') !== rtl;
          var next;
          if (event.key === 'Home') next = 1;
          else if (event.key === 'End') next = n;
          else next = forward ? (active % n) + 1 : ((active + n - 2) % n) + 1;
          selectTab(next, true);
        });
      });

      /* ---------- hijab ---------- */
      hijabSwatches.forEach(function (el) {
        el.addEventListener('click', function () {
          hijabActive = el;
          render();
        });
      });

      // Switching fabric shows its swatches and picks its first colour.
      hijabTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var group = tab.getAttribute('data-hijab-tab');
          if (group === hijabGroup) return;
          var first = hijabSwatches.filter(function (el) {
            return el.getAttribute('data-hijab-group') === group;
          })[0];
          if (!first) return;
          hijabGroup = group;
          hijabActive = first;
          render();
        });
      });

      // The hijab follows the box colour (e.g. a red box picks the red hijab).
      // A count already added moves with it, so the order keeps one colour.
      function matchHijab(colour) {
        var want = colour && (colour.getAttribute('data-hijab-match') || '').trim().toLowerCase();
        if (!want || !hijabSwatches.length) return;
        var match = hijabSwatches.filter(function (el) {
          return (
            el.getAttribute('data-hijab-group') === hijabGroup &&
            (el.getAttribute('data-name') || '').toLowerCase().indexOf(want) > -1
          );
        })[0];
        if (!match || match === hijabActive) return;

        if (hijabActive) {
          var fromId = hijabActive.getAttribute('data-variant');
          var toId = match.getAttribute('data-variant');
          var moving = hijabQty[fromId] || 0;
          if (moving > 0 && !hijabQty[toId]) {
            var max = parseInt(match.getAttribute('data-max'), 10) || 99;
            hijabQty[toId] = Math.min(max, moving);
            hijabQty[fromId] = 0;
          }
        }
        hijabActive = match;
      }

      function stepHijab(delta) {
        if (!hijabActive) return;
        var id = hijabActive.getAttribute('data-variant');
        var max = parseInt(hijabActive.getAttribute('data-max'), 10) || 99;
        hijabQty[id] = Math.min(max, Math.max(0, (hijabQty[id] || 0) + delta));
        hint.removeAttribute('data-error');
        hint.textContent = '';
        render();
      }

      if (hijabDec) hijabDec.addEventListener('click', function () { stepHijab(-1); });
      if (hijabInc) hijabInc.addEventListener('click', function () { stepHijab(1); });

      /* ---------- gallery ---------- */
      function goTo(index) {
        var slide = rail.children[index];
        if (slide) rail.scrollTo({ left: slide.offsetLeft - rail.offsetLeft });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goTo(parseInt(dot.getAttribute('data-dot'), 10));
        });
      });

      if (dots.length) {
        rail.addEventListener('scroll', function () {
          var index = Math.round(rail.scrollLeft / rail.clientWidth);
          dots.forEach(function (dot, i) {
            dot.setAttribute('aria-current', i === index ? 'true' : 'false');
          });
        }, { passive: true });
      }

      function showVariantMedia(input) {
        var id = input && input.getAttribute('data-media');
        if (!id) return;
        var slide = rail.querySelector('[data-media-id="' + id + '"]');
        if (slide) goTo(Array.prototype.indexOf.call(rail.children, slide));
      }

      form.addEventListener('change', function (event) {
        var target = event.target;
        if (target.closest('[data-colours], [data-cards]')) showVariantMedia(target);
        if (target.closest('[data-colours]')) matchHijab(target);
        hint.removeAttribute('data-error');
        hint.textContent = '';
        render();
      });

      /* ---------- order ---------- */
      // A colour block rides as a property; a variant colour is the line's id.
      function boxLine(colour, card, scent, slot) {
        var properties = {};
        var name = root.querySelector('[data-box-name="' + slot + '"]');
        var nameValue = name ? name.value.trim() : '';
        if (colour.hasAttribute('data-property')) properties[COLOUR] = colour.value;
        if (card) properties[CARD] = card.value;
        if (nameValue) properties[NAME] = nameValue;
        if (scent) properties[PERFUME] = scent.value + ' (' + T.free + ')';
        return { id: parseInt(colour.getAttribute('data-variant'), 10), quantity: 1, properties: properties };
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var st = state();
        if (busy || !st.first) return;

        var items = [];
        st.boxes.forEach(function (colour, i) {
          var slot = i + 1;
          var scent = st.many ? root.querySelector('[data-scent="' + slot + '"]:checked') : null;
          items.push(boxLine(colour, picked('[data-cards="' + slot + '"]'), scent, slot));
        });
        if (st.scent) {
          var link = {};
          link[LINK] = st.first.getAttribute('data-title');
          items.push({ id: parseInt(st.scent.value, 10), quantity: 1, properties: link });
        }
        st.extras.forEach(function (input) {
          items.push({ id: parseInt(input.value, 10), quantity: 1 });
        });
        st.hijabs.forEach(function (h) {
          var hijabProps = {};
          hijabProps[LINK] = st.first.getAttribute('data-title');
          if (T.offer) hijabProps[OFFER] = T.offer;
          items.push({ id: parseInt(h.el.getAttribute('data-variant'), 10), quantity: h.qty, properties: hijabProps });
        });

        busy = true;
        render();

        fetch(ADD_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: items })
        })
          .then(function (response) {
            return response.json().then(function (body) {
              if (!response.ok) throw new Error(body.description || body.message || T.error);
              return body;
            });
          })
          .then(function () {
            window.location.href = AFTER_ADD === 'checkout' ? '/checkout' : CART_URL;
          })
          .catch(function (error) {
            busy = false;
            hint.setAttribute('data-error', 'true');
            hint.textContent = (error && error.message) || T.error;
            render();
            // The bar's button may have sent it; bring the message into view.
            var box = hint.getBoundingClientRect();
            if (box.top < 0 || box.bottom > window.innerHeight) hint.scrollIntoView({ block: 'center' });
          });
      });

      // Returning with the back button restores the page from cache mid-submit.
      window.addEventListener('pageshow', function (event) {
        if (!event.persisted) return;
        busy = false;
        render();
      });

      // One Order now on screen at a time: the bar steps away over the summary.
      var bar = root.querySelector('.tss-gbx__bar');
      var summary = root.querySelector('.tss-gbx__summary');
      if (bar && summary && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          bar.toggleAttribute('data-away', entries[0].isIntersecting);
        }, { threshold: 0.2 }).observe(summary);
      }

      matchHijab(colourOf(1));
      render();
    })();
  </script>
{%- endif -%}

