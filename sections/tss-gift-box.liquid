{% comment %}
  TSS — Gift box
  A single-product gift box page in the Hafezi style:

    gallery with dots · eyebrow, serif title, subtitle, lede, price and proof
    "In every box" strip linking down to the story's contents
    01 How many boxes — two boxes switch on tabs, one per box
    02 Box colour, with the chosen colour's mood line
    03 Card — the card that goes inside, sent as a line-item property
    04 Names on the card (optional)
    05 Complete the gift — perfume and miswak rows with Add toggles; with two
       boxes both perfumes ride along free as properties instead of paid lines;
       a hijab row shows its price less the set discount, which a matching
       automatic discount in Shopify admin must actually charge
    order summary with one line per item; fixed total bar on small screens

  Without JavaScript the form still posts the first box with its card; the
  add-on lines and the second box need the script.

  @example
  <!-- templates/page.hafezi-gift-box.json with Box product set to the gift box,
       Perfume product set to the scent product and Miswak product set -->
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign box = s.product
  assign perfume = s.perfume_product
  assign perfume_collection = s.perfume_collection

  # A perfume collection, when it has products, replaces the single product.
  # The add-on shows the lowest price; each scent shows its own when they differ.
  assign has_perfume = false
  assign perfume_title = perfume.title
  assign perfume_price = perfume.price
  assign perfume_price_max = perfume.price_max
  if perfume_collection != blank and perfume_collection.products_count > 0
    assign has_perfume = true
    assign perfume_title = perfume_collection.title
    assign perfume_price = perfume_collection.products.first.price_min
    assign perfume_price_max = perfume_price
    for item in perfume_collection.products limit: 50
      if item.price_min < perfume_price
        assign perfume_price = item.price_min
      endif
      if item.price_max > perfume_price_max
        assign perfume_price_max = item.price_max
      endif
    endfor
  elsif perfume != blank
    assign has_perfume = true
    assign perfume_price = perfume.price_min
  endif
  assign scent_group = 'tss-gbx-' | append: uid | append: '-scent'
  assign scent_group_one = scent_group | append: '-1'
  assign scent_group_two = scent_group | append: '-2'
  assign perfume_prices_vary = false
  if perfume_price != perfume_price_max
    assign perfume_prices_vary = true
  endif
  assign miswak = s.miswak_product

  # Add-on thumbnails: the picked image wins, otherwise the product's own.
  assign perfume_image = s.perfume_image
  if perfume_image == blank
    if perfume_collection != blank and perfume_collection.products_count > 0
      assign perfume_image = perfume_collection.featured_image | default: perfume_collection.products.first.featured_image
    else
      assign perfume_image = perfume.featured_image
    endif
  endif
  assign miswak_image = s.miswak_image | default: miswak.featured_image
  assign perfume_label_text = s.perfume_label | default: perfume_title
  assign current = box.selected_or_first_available_variant
  assign colour_blocks = section.blocks | where: 'type', 'colour'
  assign card_blocks = section.blocks | where: 'type', 'card_image'
  assign colour_property = s.colour_property | default: 'Box colour'
  assign colour_two_name = 'tss-gbx-' | append: uid | append: '-colour-2'
  assign show_colours = true
  if colour_blocks.size == 0 and box.has_only_default_variant
    assign show_colours = false
  endif

  # Colour and card block images join the gallery after the product's own media.
  assign media_count = box.media.size | at_most: 10
  assign slide_count = media_count
  for block in colour_blocks
    if block.settings.image != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor
  for block in card_blocks
    if block.settings.image != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign title = s.title | default: box.title | default: page.title
  assign card_options = s.card_options | newline_to_br | split: '<br />'
  assign card_property = s.card_property | default: 'Card'
  assign perfume_property = s.perfume_property | default: 'Perfume'
  assign name_property = s.name_label
  assign miswak_label_text = s.miswak_label | default: miswak.title

  # Hijab add-on, offered at a percentage off while it rides with the box.
  # The page shows the reduced price; an automatic discount must charge it.
  # Colours come from a collection (one product per colour, as in the set
  # builder) or from the variants of one product; swatches are painted from
  # "Name: #hex" lines matched against each colour's name.
  assign hijab = s.hijab_product
  assign hijab_collection = s.hijab_collection
  assign has_hijab = false
  if hijab_collection != blank and hijab_collection.products_count > 0
    assign has_hijab = true
  elsif hijab != blank
    assign has_hijab = true
  endif
  assign hijab_label_text = s.hijab_label | default: hijab_collection.title | default: hijab.title
  assign hijab_keep = 100 | minus: s.hijab_discount
  assign hijab_swatch_lines = s.hijab_swatch_colours | newline_to_br | split: '<br />'
  assign hijab_exclude = s.hijab_exclude | strip | downcase

  # A second fabric (Cherry) adds a switch under the hijab photo.
  assign hijab_group_count = 0
  if has_hijab
    assign hijab_group_count = 1
  endif
  if s.hijab_collection_2 != blank and s.hijab_collection_2.products_count > 0
    assign has_hijab = true
    assign hijab_group_count = hijab_group_count | plus: 1
  endif

  # "In every box" strip: one item per block with a name or an image.
  assign inside_blocks = section.blocks | where: 'type', 'inside'
  assign inside_count = 0
  for block in inside_blocks
    if block.settings.image != blank or block.settings.name != blank
      assign inside_count = inside_count | plus: 1
    endif
  endfor

  # The mood line starts on the colour the first box opens with.
  assign first_mood = ''
  for block in colour_blocks
    unless block.settings.sold_out
      assign first_mood = block.settings.mood
      break
    endunless
  endfor

  assign panel_count = 1
  if s.allow_two
    assign panel_count = 2
  endif

  # Step numbers follow what shows; both boxes share them.
  assign step = 0
  if s.allow_two
    assign step = step | plus: 1
    assign step_count = step
  endif
  if show_colours
    assign step = step | plus: 1
    assign step_colour = step
  endif
  if card_options.size > 0
    assign step = step | plus: 1
    assign step_card = step
  endif
  if s.name_label != blank
    assign step = step | plus: 1
    assign step_name = step
  endif
  if has_perfume or miswak != blank or has_hijab
    assign step = step | plus: 1
    assign step_extras = step
  endif
-%}

<style>
  #tss-gbx-{{ uid }} {
    background: var(--tss-ivory);
    padding-block-end: {{ s.padding_bottom }}px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__layout {
    margin-inline: auto;
    max-width: 1440px;
  }

  /* ---------- media ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__media {
    min-width: 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__rail {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    background: var(--tss-ivory-2);
  }

  #tss-gbx-{{ uid }} .tss-gbx__rail::-webkit-scrollbar {
    display: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__slide {
    flex: none;
    width: 100%;
    aspect-ratio: {{ s.image_ratio }};
    scroll-snap-align: start;
  }

  #tss-gbx-{{ uid }} .tss-gbx__slide img,
  #tss-gbx-{{ uid }} .tss-gbx__slide svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #tss-gbx-{{ uid }} .tss-gbx__dots {
    display: flex;
    justify-content: center;
    gap: 4px;
    padding-block: 4px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__dot {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  #tss-gbx-{{ uid }} .tss-gbx__dot::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(28 28 26 / 0.2);
    transition: transform 0.4s var(--tss-ease), background-color 0.4s var(--tss-ease);
  }

  #tss-gbx-{{ uid }} .tss-gbx__dot[aria-current='true']::before {
    background: var(--tss-gold);
    transform: scale(1.5);
  }

  /* ---------- panel ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__panel {
    min-width: 0;
    padding: 32px var(--tss-gutter) 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__title {
    margin-top: 16px;
    font-family: var(--tss-serif);
    font-size: 44px;
    font-weight: 400;
    line-height: 1.02;
    color: var(--tss-ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  #tss-gbx-{{ uid }} .tss-gbx__subtitle {
    margin-top: 6px;
    font-family: var(--tss-serif);
    font-size: 22px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
    color: rgb(28 28 26 / 0.7);
  }

  #tss-gbx-{{ uid }} .tss-gbx__lede {
    margin-top: 16px;
    max-width: 40ch;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.6;
    color: rgb(28 28 26 / 0.7);
  }

  #tss-gbx-{{ uid }} .tss-gbx__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 24px;
    padding-block-end: 20px;
    border-block-end: 1px solid var(--tss-gold);
  }

  #tss-gbx-{{ uid }} .tss-gbx__price {
    font-family: var(--tss-serif);
    font-size: 26px;
    font-weight: 500;
    color: var(--tss-ink);
  }

  #tss-gbx-{{ uid }} .tss-gbx__proof {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgb(28 28 26 / 0.55);
  }

  /* ---------- in every box ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__inside {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
    padding: 12px;
    background: var(--tss-ivory-2);
    color: var(--tss-ink);
    text-decoration: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__inside:focus-visible {
    outline: 2px solid var(--tss-green);
    outline-offset: 2px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__inside-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    font-size: 13px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__inside-label {
    font-weight: 500;
  }

  #tss-gbx-{{ uid }} .tss-gbx__inside-link {
    color: var(--tss-green);
    text-decoration: underline;
    white-space: nowrap;
  }

  #tss-gbx-{{ uid }} .tss-gbx__inside-items {
    display: grid;
    grid-template-columns: repeat(var(--tss-gbx-inside, 5), minmax(0, 1fr));
    gap: 6px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__inside-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 0;
    font-size: 11px;
    line-height: 1.25;
    text-align: center;
    color: rgb(28 28 26 / 0.75);
    overflow-wrap: anywhere;
  }

  /* Holds the square until the merchant picks an image. */
  #tss-gbx-{{ uid }} .tss-gbx__inside-blank {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: rgb(28 28 26 / 0.06);
  }

  #tss-gbx-{{ uid }} .tss-gbx__inside-item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* ---------- box tabs ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    margin-top: 28px;
    padding: 4px;
    background: var(--tss-ivory-2);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tab {
    min-width: 0;
    min-height: 44px;
    padding: 8px 12px;
    border: 0;
    background: transparent;
    font-family: var(--tss-sans);
    font-size: 13px;
    line-height: 1.3;
    color: rgb(28 28 26 / 0.7);
    overflow-wrap: anywhere;
    cursor: pointer;
    transition: background-color 0.3s var(--tss-ease), color 0.3s var(--tss-ease);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tab[aria-selected='true'] {
    background: var(--tss-ivory);
    box-shadow: inset 0 0 0 1px var(--tss-gold);
    font-weight: 500;
    color: var(--tss-ink);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tab:focus-visible {
    outline: 2px solid var(--tss-green);
    outline-offset: 2px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__tabs[hidden],
  #tss-gbx-{{ uid }} .tss-gbx__box[hidden],
  #tss-gbx-{{ uid }} .tss-gbx__mood[hidden],
  #tss-gbx-{{ uid }} [data-scent-group][hidden] {
    display: none;
  }

  /* ---------- steps ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__step {
    min-width: 0;
    margin: 0;
    margin-top: 36px;
    padding: 0;
    border: 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__legend {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 0;
    margin-bottom: 16px;
    font-family: var(--tss-serif);
    font-size: 22px;
    font-weight: 400;
    color: var(--tss-ink);
  }

  #tss-gbx-{{ uid }} .tss-gbx__num {
    font-family: var(--tss-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--tss-gold);
  }

  #tss-gbx-{{ uid }} .tss-gbx__optional {
    font-family: var(--tss-sans);
    font-size: 11px;
    color: rgb(28 28 26 / 0.5);
  }

  #tss-gbx-{{ uid }} .tss-gbx__options {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 140px), 1fr));
    gap: 8px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__options--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* Colour tiles: three across, swatch above the name. */
  #tss-gbx-{{ uid }} .tss-gbx__options--colours {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #tss-gbx-{{ uid }} .tss-gbx__options--colours .tss-gbx__tile {
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    min-height: 76px;
    padding: 10px 6px;
    text-align: center;
  }

  #tss-gbx-{{ uid }} .tss-gbx__options--colours .tss-gbx__swatch {
    width: 26px;
    height: 26px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__options--colours .tss-gbx__tile-text {
    align-items: center;
  }

  #tss-gbx-{{ uid }} .tss-gbx__mood {
    margin-top: 12px;
    font-family: var(--tss-serif);
    font-size: 18px;
    font-style: italic;
    line-height: 1.4;
    color: rgb(28 28 26 / 0.7);
  }

  #tss-gbx-{{ uid }} .tss-gbx__help {
    margin-top: 8px;
    font-size: 12px;
    color: rgb(28 28 26 / 0.55);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 10px 14px;
    border: 1px solid rgb(28 28 26 / 0.15);
    background: transparent;
    font-size: 13px;
    line-height: 1.35;
    color: var(--tss-ink);
    cursor: pointer;
    transition: border-color 0.3s var(--tss-ease), background-color 0.3s var(--tss-ease);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile:hover {
    border-color: rgb(28 28 26 / 0.4);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile:has(input:checked) {
    border-color: var(--tss-green);
    background: var(--tss-ivory-2);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile:has(input:focus-visible) {
    outline: 2px solid var(--tss-green);
    outline-offset: 2px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile:has(input:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  #tss-gbx-{{ uid }} .tss-gbx__mark {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(28 28 26 / 0.2);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile:has(input:checked) .tss-gbx__mark {
    background: var(--tss-gold);
  }

  #tss-gbx-{{ uid }} .tss-gbx__swatch {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgb(28 28 26 / 0.15);
    background: var(--swatch, transparent);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile-note {
    font-size: 11px;
    color: rgb(28 28 26 / 0.55);
  }

  /* Complete the gift: one row per extra, with an Add toggle. */
  #tss-gbx-{{ uid }} .tss-gbx__extras {
    display: grid;
    gap: 10px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border: 1px solid rgb(28 28 26 / 0.15);
    transition: border-color 0.3s var(--tss-ease), background-color 0.3s var(--tss-ease);
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra:has(.tss-gbx__add input:checked) {
    border-color: var(--tss-green);
    background: var(--tss-ivory-2);
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra-img {
    flex: none;
    display: block;
    width: 72px;
    height: 72px;
    object-fit: cover;
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra-name {
    font-size: 14px;
    font-weight: 500;
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra-note {
    font-size: 12px;
    line-height: 1.4;
    color: rgb(28 28 26 / 0.6);
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra-price {
    font-size: 13px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra-price s {
    margin-inline-start: 4px;
    color: rgb(28 28 26 / 0.45);
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra-badge {
    align-self: flex-start;
    margin-top: 2px;
    padding: 2px 8px;
    border-radius: 2px;
    background: var(--tss-green);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--tss-ivory);
  }

  /* ---------- hijab: photo beside name, price, swatches and stepper ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__hijab {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 12px 16px;
    align-items: stretch;
    padding: 12px;
    border: 1px solid rgb(28 28 26 / 0.15);
    transition: border-color 0.3s var(--tss-ease), background-color 0.3s var(--tss-ease);
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab[data-count]:not([data-count='0']) {
    border-color: var(--tss-green);
    background: var(--tss-ivory-2);
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-price .tss-gbx__extra-badge {
    align-self: center;
    margin-top: 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-foot .tss-gbx__stepper {
    margin-top: 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-tabs {
    display: flex;
    gap: 6px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-tab {
    min-width: 0;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgb(28 28 26 / 0.15);
    border-radius: 2px;
    background: transparent;
    font-family: var(--tss-sans);
    font-size: 12px;
    color: var(--tss-ink);
    cursor: pointer;
    transition: border-color 0.3s var(--tss-ease), background-color 0.3s var(--tss-ease);
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-tab[aria-pressed='true'] {
    border-color: var(--tss-green);
    background: var(--tss-green);
    color: var(--tss-ivory);
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-tab:focus-visible {
    outline: 2px solid var(--tss-gold);
    outline-offset: 2px;
  }

  /* The photo runs the full height of the name, price and swatches. */
  #tss-gbx-{{ uid }} .tss-gbx__hijab-media {
    position: relative;
    min-height: 128px;
    overflow: hidden;
    border: 1px solid rgb(28 28 26 / 0.1);
    background: #fff;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hijab-name {
    font-family: var(--tss-serif);
    font-size: 20px;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  #tss-gbx-{{ uid }} .tss-gbx__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hswatch {
    position: relative;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--tss-ivory-2) center / cover no-repeat;
    box-shadow: inset 0 0 0 1px rgb(28 28 26 / 0.08);
    cursor: pointer;
    transition: box-shadow 0.25s var(--tss-ease);
  }

  #tss-gbx-{{ uid }} .tss-gbx__hswatch[aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--tss-ivory), 0 0 0 3px var(--tss-gold);
  }

  #tss-gbx-{{ uid }} .tss-gbx__hswatch[hidden] {
    display: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hswatch:focus-visible {
    outline: 2px solid var(--tss-green);
    outline-offset: 4px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hswatch-badge {
    position: absolute;
    inset-block-start: -6px;
    inset-inline-end: -6px;
    display: grid;
    place-items: center;
    min-width: 16px;
    height: 16px;
    padding-inline: 3px;
    border-radius: 8px;
    background: var(--tss-gold);
    font-size: 9px;
    font-weight: 500;
    color: var(--tss-ivory);
  }

  #tss-gbx-{{ uid }} .tss-gbx__hswatch-badge[hidden] {
    display: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__stepper {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 10px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__stepper button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(26 74 58 / 0.2);
    border-radius: 2px;
    background: transparent;
    font-size: 18px;
    color: var(--tss-ink);
    cursor: pointer;
  }

  #tss-gbx-{{ uid }} .tss-gbx__stepper button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  #tss-gbx-{{ uid }} .tss-gbx__stepper output {
    width: 28px;
    font-size: 14px;
    text-align: center;
  }

  @media (max-width: 480px) {
    #tss-gbx-{{ uid }} .tss-gbx__hijab {
      grid-template-columns: 96px minmax(0, 1fr);
    }

    #tss-gbx-{{ uid }} .tss-gbx__hijab-media {
      min-height: 96px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tss-gbx-{{ uid }} .tss-gbx__hijab,
    #tss-gbx-{{ uid }} .tss-gbx__hijab-tab,
    #tss-gbx-{{ uid }} .tss-gbx__hswatch {
      transition: none;
    }
  }

  #tss-gbx-{{ uid }} .tss-gbx__extra-free {
    font-size: 12px;
    font-weight: 500;
    color: var(--tss-green);
  }

  #tss-gbx-{{ uid }} .tss-gbx__add {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 88px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--tss-green);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tss-green);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.3s var(--tss-ease), color 0.3s var(--tss-ease);
  }

  #tss-gbx-{{ uid }} .tss-gbx__add input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  #tss-gbx-{{ uid }} .tss-gbx__add:has(input:checked) {
    background: var(--tss-green);
    color: var(--tss-ivory);
  }

  #tss-gbx-{{ uid }} .tss-gbx__add:has(input:focus-visible) {
    outline: 2px solid var(--tss-gold);
    outline-offset: 2px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__add:has(input:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  #tss-gbx-{{ uid }} .tss-gbx__add-on,
  #tss-gbx-{{ uid }} .tss-gbx__add:has(input:checked) .tss-gbx__add-off {
    display: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__add:has(input:checked) .tss-gbx__add-on {
    display: inline;
  }

  #tss-gbx-{{ uid }} .tss-gbx__included {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    background: var(--tss-ivory-2);
    font-size: 12px;
    font-weight: 500;
    color: var(--tss-green);
    white-space: nowrap;
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile--card {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  #tss-gbx-{{ uid }} .tss-gbx__card-body {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 10px 14px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile:has(input:disabled) .tss-gbx__thumb {
    filter: grayscale(1);
  }

  /* Box count tiles: a gold outline with ink text until chosen, then the
     Order Now button's green and ivory with a gold edge. */
  #tss-gbx-{{ uid }} .tss-gbx__tile--solid {
    border-color: var(--tss-gold);
    background: transparent;
    color: var(--tss-ink);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile--solid:hover {
    border-color: var(--tss-gold);
    background: var(--tss-ivory-2);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile--solid:has(input:checked) {
    border-color: var(--tss-gold);
    background: var(--tss-green);
    box-shadow: inset 0 0 0 1px var(--tss-gold);
    color: var(--tss-ivory);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile--solid .tss-gbx__mark {
    background: rgb(184 134 11 / 0.35);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile--solid:has(input:checked) .tss-gbx__mark {
    background: var(--tss-gold);
  }

  #tss-gbx-{{ uid }} .tss-gbx__tile--solid .tss-gbx__tile-note {
    color: inherit;
    opacity: 0.8;
  }

  #tss-gbx-{{ uid }} .tss-gbx__sub {
    display: grid;
    gap: 6px;
    margin-top: 8px;
    padding-inline-start: 16px;
    border-inline-start: 1px solid var(--tss-gold);
  }

  #tss-gbx-{{ uid }} .tss-gbx__sub[hidden],
  #tss-gbx-{{ uid }} [data-only-one][hidden],
  #tss-gbx-{{ uid }} [data-only-two][hidden] {
    display: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__sub .tss-gbx__tile {
    border-color: transparent;
    background: rgb(28 28 26 / 0.03);
  }

  #tss-gbx-{{ uid }} .tss-gbx__box-label {
    margin-top: 20px;
    margin-bottom: 8px;
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgb(28 28 26 / 0.6);
  }

  #tss-gbx-{{ uid }} .tss-gbx__input {
    display: block;
    width: 100%;
    min-width: 0;
    border: 1px solid rgb(28 28 26 / 0.15);
    border-radius: 2px;
    background: transparent;
    padding: 14px 16px;
    font-family: var(--tss-sans);
    font-size: 14px;
    color: var(--tss-ink);
    transition: border-color 0.3s ease;
  }

  #tss-gbx-{{ uid }} .tss-gbx__input:focus {
    border-color: var(--tss-ink);
  }

  #tss-gbx-{{ uid }} .tss-gbx__input:focus-visible {
    outline: 2px solid var(--tss-gold);
    outline-offset: 2px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__input-label {
    display: block;
    margin-bottom: 8px;
  }

  /* ---------- summary ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__summary {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--tss-gold);
  }

  #tss-gbx-{{ uid }} .tss-gbx__lines {
    display: grid;
    gap: 8px;
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgb(28 28 26 / 0.1);
  }

  #tss-gbx-{{ uid }} .tss-gbx__lines:empty {
    display: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    line-height: 1.45;
    color: rgb(28 28 26 / 0.75);
  }

  #tss-gbx-{{ uid }} .tss-gbx__line > :first-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  #tss-gbx-{{ uid }} .tss-gbx__line > :last-child {
    white-space: nowrap;
  }

  #tss-gbx-{{ uid }} .tss-gbx__note {
    margin-top: 4px;
    font-size: 12px;
    color: rgb(28 28 26 / 0.55);
  }

  #tss-gbx-{{ uid }} .tss-gbx__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__total-label {
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgb(28 28 26 / 0.6);
  }

  #tss-gbx-{{ uid }} .tss-gbx__total-value {
    font-family: var(--tss-serif);
    font-size: 26px;
    font-weight: 500;
  }

  #tss-gbx-{{ uid }} .tss-gbx__hint {
    min-height: 1.5em;
    margin-top: 8px;
    font-size: 12px;
    color: rgb(28 28 26 / 0.6);
  }

  #tss-gbx-{{ uid }} .tss-gbx__hint[data-error='true'] {
    color: #8b1e1e;
  }

  #tss-gbx-{{ uid }} .tss-gbx__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 28px;
    border: 0;
    background: var(--tss-green);
    font-family: var(--tss-sans);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--tss-ivory);
    cursor: pointer;
    transition: background-color 0.3s var(--tss-ease);
  }

  #tss-gbx-{{ uid }} .tss-gbx__submit:hover {
    background: var(--tss-green-mid);
  }

  #tss-gbx-{{ uid }} .tss-gbx__submit:focus-visible {
    outline: 2px solid var(--tss-gold);
    outline-offset: 2px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__submit[aria-disabled='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  #tss-gbx-{{ uid }} .tss-gbx__summary .tss-gbx__submit {
    width: 100%;
    margin-top: 12px;
  }

  #tss-gbx-{{ uid }} .tss-gbx__trust {
    margin-top: 12px;
    font-size: 11px;
    color: rgb(28 28 26 / 0.55);
  }

  /* ---------- bar ---------- */
  #tss-gbx-{{ uid }} .tss-gbx__bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px var(--tss-gutter) calc(10px + env(safe-area-inset-bottom));
    border-top: 1px solid rgb(28 28 26 / 0.1);
    background: var(--tss-ivory);
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-line {
    overflow: hidden;
    font-size: 11px;
    color: rgb(28 28 26 / 0.6);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-line:empty {
    display: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar-total {
    font-family: var(--tss-serif);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.15;
  }

  #tss-gbx-{{ uid }} .tss-gbx__bar .tss-gbx__submit {
    flex: none;
  }

  #tss-gbx-{{ uid }} .tss-gbx__empty {
    padding: 80px var(--tss-gutter);
    text-align: center;
    color: rgb(28 28 26 / 0.6);
  }

  /* Room for the fixed bar goes at the page end, not between sections. */
  @media (max-width: 989px) {
    body:has(#tss-gbx-{{ uid }} .tss-gbx__bar) {
      padding-block-end: 80px;
    }
  }

  @media (min-width: 990px) {
    #tss-gbx-{{ uid }} .tss-gbx__layout {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 64px;
      align-items: start;
      padding: 40px 48px 0;
    }

    #tss-gbx-{{ uid }} .tss-gbx__media,
    #tss-gbx-{{ uid }} .tss-gbx__panel {
      position: sticky;
      top: 24px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__panel {
      padding: 0;
      max-width: 560px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__title {
      font-size: 56px;
    }

    #tss-gbx-{{ uid }} .tss-gbx__bar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tss-gbx-{{ uid }} .tss-gbx__rail {
      scroll-behavior: auto;
    }

    #tss-gbx-{{ uid }} .tss-gbx__dot::before,
    #tss-gbx-{{ uid }} .tss-gbx__tile,
    #tss-gbx-{{ uid }} .tss-gbx__tab,
    #tss-gbx-{{ uid }} .tss-gbx__extra,
    #tss-gbx-{{ uid }} .tss-gbx__add,
    #tss-gbx-{{ uid }} .tss-gbx__submit {
      transition: none;
    }
  }
</style>

<section
  id="tss-gbx-{{ uid }}"
  class="tss-section tss-gbx"
  aria-label="{{ title | escape }}"
>
  {%- if box == blank -%}
    <p class="tss-gbx__empty">{{ s.empty_text | escape }}</p>
  {%- else -%}
    <form
      id="tss-gbx-{{ uid }}-form"
      class="tss-gbx__layout"
      action="{{ routes.cart_add_url }}"
      method="post"
      data-form
    >
      <input type="hidden" name="quantity" value="1">

      <div class="tss-gbx__media">
        <div
          class="tss-gbx__rail"
          tabindex="0"
          role="region"
          aria-label="{{ box.title | escape }}"
          data-rail
        >
          {%- for media in box.media limit: 10 -%}
            <div class="tss-gbx__slide" data-media-id="{{ media.id }}">
              {%- liquid
                assign loading = 'lazy'
                if forloop.first
                  assign loading = 'eager'
                endif
              -%}
              {{
                media.preview_image
                | image_url: width: 2000
                | image_tag:
                  widths: '480,720,960,1280,1600,2000',
                  sizes: '(min-width: 990px) 55vw, 100vw',
                  loading: loading,
                  alt: media.alt | default: box.title
              }}
            </div>
          {%- endfor -%}
          {%- for block in colour_blocks -%}
            {%- if block.settings.image != blank -%}
              <div class="tss-gbx__slide" data-media-id="colour-{{ block.id }}">
                {%- liquid
                  assign loading = 'lazy'
                  if media_count == 0 and forloop.first
                    assign loading = 'eager'
                  endif
                -%}
                {{
                  block.settings.image
                  | image_url: width: 2000
                  | image_tag:
                    widths: '480,720,960,1280,1600,2000',
                    sizes: '(min-width: 990px) 55vw, 100vw',
                    loading: loading,
                    alt: block.settings.image.alt | default: block.settings.name
                }}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- for block in card_blocks -%}
            {%- if block.settings.image != blank -%}
              <div class="tss-gbx__slide" data-media-id="card-{{ block.id }}">
                {{
                  block.settings.image
                  | image_url: width: 2000
                  | image_tag:
                    widths: '480,720,960,1280,1600,2000',
                    sizes: '(min-width: 990px) 55vw, 100vw',
                    loading: 'lazy',
                    alt: block.settings.image.alt | default: block.settings.card
                }}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if slide_count == 0 -%}
            <div class="tss-gbx__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>

        {%- if slide_count > 1 -%}
          <div class="tss-gbx__dots">
            {%- for i in (1..slide_count) -%}
              <button
                type="button"
                class="tss-gbx__dot"
                aria-label="{{ s.image_label | escape }} {{ i }} / {{ slide_count }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                data-dot="{{ forloop.index0 }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="tss-gbx__panel">
        {%- if s.eyebrow != blank -%}
          <p class="tss-eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="tss-gbx__title">{{ title | escape }}</h1>
        {%- if s.subtitle != blank -%}
          <p class="tss-gbx__subtitle">{{ s.subtitle | escape }}</p>
        {%- endif -%}
        {%- if s.lede != blank -%}
          <p class="tss-gbx__lede">{{ s.lede | escape }}</p>
        {%- endif -%}

        <div class="tss-gbx__price-row">
          <p class="tss-gbx__price" data-price>{{ current.price | money }}</p>
          {%- if s.proof != blank -%}
            <p class="tss-gbx__proof">{{ s.proof | escape }}</p>
          {%- endif -%}
        </div>

        {%- if inside_count > 0 -%}
          <a
            class="tss-gbx__inside"
            href="#{{ s.inside_anchor | default: 'inside' | handleize }}"
          >
            <span class="tss-gbx__inside-head">
              <span class="tss-gbx__inside-label">{{ s.inside_label | escape }}</span>
              {%- if s.inside_link_label != blank -%}
                <span class="tss-gbx__inside-link">{{ s.inside_link_label | escape }}</span>
              {%- endif -%}
            </span>
            <span class="tss-gbx__inside-items" style="--tss-gbx-inside: {{ inside_count }}">
              {%- for block in inside_blocks -%}
                {%- if block.settings.image != blank or block.settings.name != blank -%}
                  <span class="tss-gbx__inside-item" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      {{-
                        block.settings.image
                        | image_url: width: 240
                        | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '(min-width: 990px) 100px, 18vw', alt: ''
                      -}}
                    {%- else -%}
                      <span class="tss-gbx__inside-blank" aria-hidden="true"></span>
                    {%- endif -%}
                    {{- block.settings.name | escape -}}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </span>
          </a>
        {%- endif -%}

        {%- if s.allow_two -%}
          <fieldset class="tss-gbx__step">
            <legend class="tss-gbx__legend">
              <span class="tss-gbx__num" aria-hidden="true">{{ step_count | prepend: '0' }}</span>
              {{- s.count_label | escape -}}
            </legend>
            <div class="tss-gbx__options tss-gbx__options--two">
              <label class="tss-gbx__tile tss-gbx__tile--solid">
                <input type="radio" name="tss-gbx-{{ uid }}-count" value="1" checked data-count>
                <span class="tss-gbx__mark" aria-hidden="true"></span>
                <span class="tss-gbx__tile-text">
                  {{- s.one_label | escape -}}
                  <span class="tss-gbx__tile-note" data-count-price="1">{{ current.price | money }}</span>
                </span>
              </label>
              <label class="tss-gbx__tile tss-gbx__tile--solid">
                <input type="radio" name="tss-gbx-{{ uid }}-count" value="2" data-count>
                <span class="tss-gbx__mark" aria-hidden="true"></span>
                <span class="tss-gbx__tile-text">
                  {{- s.two_label | escape -}}
                  <span class="tss-gbx__tile-note">
                    {%- if has_perfume and s.two_note != blank -%}
                      {{ s.two_note | escape }} ·
                    {% endif -%}
                    <span data-count-price="2">{{ current.price | times: 2 | money }}</span>
                  </span>
                </span>
              </label>
            </div>
          </fieldset>

          {%- comment -%} Each box is set up on its own tab; shown with two boxes. {%- endcomment -%}
          <div class="tss-gbx__tabs" role="tablist" aria-label="{{ s.count_label | escape }}" data-only-two hidden>
            {%- for slot in (1..2) -%}
              <button
                type="button"
                class="tss-gbx__tab"
                id="tss-gbx-{{ uid }}-tab-{{ slot }}"
                role="tab"
                aria-controls="tss-gbx-{{ uid }}-box-{{ slot }}"
                aria-selected="{% if slot == 1 %}true{% else %}false{% endif %}"
                tabindex="{% if slot == 1 %}0{% else %}-1{% endif %}"
                data-tab="{{ slot }}"
              >
                {%- if slot == 1 -%}{{ s.box_one_label | escape }}{%- else -%}{{ s.box_two_label | escape }}{%- endif -%}
                <span data-tab-colour="{{ slot }}"></span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          The box colour: colour blocks, the product's variants, or — with
          neither — a hidden choice and no step.
        {%- endcomment -%}
        {%- capture colours_one -%}
          {%- render 'tss-gift-box-colours',
            box: box,
            current: current,
            colours: colour_blocks,
            slot: 1,
            name: '',
            colour_property: colour_property,
            sold_out_label: s.sold_out_label
          -%}
        {%- endcapture -%}
        {%- if s.allow_two -%}
          {%- capture colours_two -%}
            {%- render 'tss-gift-box-colours',
              box: box,
              current: current,
              colours: colour_blocks,
              slot: 2,
              name: colour_two_name,
              colour_property: colour_property,
              sold_out_label: s.sold_out_label
            -%}
          {%- endcapture -%}
        {%- endif -%}

        {%- for slot in (1..panel_count) -%}
          {%- liquid
            if slot == 1
              assign box_suffix = s.box_one_label
              assign colours_html = colours_one
              assign card_name = 'properties[' | append: card_property | append: ']'
              assign scent_name = scent_group_one
            else
              assign box_suffix = s.box_two_label
              assign colours_html = colours_two
              assign card_name = 'tss-gbx-' | append: uid | append: '-card-2'
              assign scent_name = scent_group_two
            endif
          -%}
          <div
            class="tss-gbx__box"
            id="tss-gbx-{{ uid }}-box-{{ slot }}"
            data-box-panel="{{ slot }}"
            {% if slot == 2 %}
              hidden
            {% endif %}
          >
            {%- if show_colours -%}
              <fieldset class="tss-gbx__step">
                <legend class="tss-gbx__legend">
                  <span class="tss-gbx__num" aria-hidden="true">{{ step_colour | prepend: '0' }}</span>
                  {{- s.colour_label | escape }}
                  <span class="tss-gbx__optional" data-only-two hidden>· {{ box_suffix | escape }}</span>
                </legend>
                <div class="tss-gbx__options tss-gbx__options--colours" data-colours="{{ slot }}">{{ colours_html }}</div>
                <p class="tss-gbx__mood" data-mood-out="{{ slot }}" {% if first_mood == blank %}hidden{% endif %}>
                  {{- first_mood | escape -}}
                </p>
              </fieldset>
            {%- else -%}
              <div data-colours="{{ slot }}" hidden>{{ colours_html }}</div>
            {%- endif -%}

            {%- if card_options.size > 0 -%}
              <fieldset class="tss-gbx__step">
                <legend class="tss-gbx__legend">
                  <span class="tss-gbx__num" aria-hidden="true">{{ step_card | prepend: '0' }}</span>
                  {{- s.card_label | escape }}
                  <span class="tss-gbx__optional" data-only-two hidden>· {{ box_suffix | escape }}</span>
                </legend>
                <div class="tss-gbx__options tss-gbx__options--two" data-cards="{{ slot }}">
                  {%- for card in card_options -%}
                    {%- assign card = card | strip -%}
                    {%- if card != blank -%}
                      {%- liquid
                        # A box variant named like this card shows its image; a Card image
                        # block with the same name overrides it.
                        assign card_media = ''
                        assign card_key = card | downcase
                        for variant in box.variants
                          assign variant_key = variant.title | strip | downcase
                          if variant_key == card_key
                            assign card_media = variant.featured_media.id
                            break
                          endif
                        endfor
                        for block in card_blocks
                          assign block_key = block.settings.card | strip | downcase
                          if block_key == card_key and block.settings.image != blank
                            assign card_media = 'card-' | append: block.id
                            break
                          endif
                        endfor
                      -%}
                      <label class="tss-gbx__tile">
                        <input
                          type="radio"
                          name="{{ card_name | escape }}"
                          value="{{ card | escape }}"
                          {% if card_media != blank %}
                            data-media="{{ card_media }}"
                          {% endif %}
                          {% if forloop.first %}
                            checked
                          {% endif %}
                        >
                        <span class="tss-gbx__mark" aria-hidden="true"></span>
                        <span class="tss-gbx__tile-text">{{ card | escape }}</span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endif -%}

            {%- if s.name_label != blank -%}
              <fieldset class="tss-gbx__step">
                <legend class="tss-gbx__legend">
                  <span class="tss-gbx__num" aria-hidden="true">{{ step_name | prepend: '0' }}</span>
                  {{- s.name_label | escape }}
                  <span class="tss-gbx__optional">{{ s.optional_label | escape }}</span>
                  <span class="tss-gbx__optional" data-only-two hidden>· {{ box_suffix | escape }}</span>
                </legend>
                <input
                  id="tss-gbx-{{ uid }}-name-{{ slot }}"
                  class="tss-gbx__input"
                  type="text"
                  {% if slot == 1 %}
                    name="properties[{{ name_property | escape }}]"
                  {% endif %}
                  placeholder="{{ s.name_placeholder | escape }}"
                  maxlength="40"
                  autocomplete="off"
                  aria-label="{{ s.name_label | escape }}"
                  {% if s.name_help != blank %}
                    aria-describedby="tss-gbx-{{ uid }}-name-help-{{ slot }}"
                  {% endif %}
                  data-box-name="{{ slot }}"
                >
                {%- if s.name_help != blank -%}
                  <p class="tss-gbx__help" id="tss-gbx-{{ uid }}-name-help-{{ slot }}">{{ s.name_help | escape }}</p>
                {%- endif -%}
              </fieldset>
            {%- endif -%}

            {%- comment -%} With two boxes each gets a free perfume; a choice shows only when there are several scents. {%- endcomment -%}
            {%- if has_perfume and s.allow_two -%}
              <div data-scent-group hidden>
                <p class="tss-gbx__box-label" id="tss-gbx-{{ uid }}-scent-{{ slot }}">{{ box_suffix | escape }} · {{ s.scent_label | escape }}</p>
                <div class="tss-gbx__options tss-gbx__options--two" role="radiogroup" aria-labelledby="tss-gbx-{{ uid }}-scent-{{ slot }}">
                  {%- render 'tss-gift-box-scents',
                    collection: perfume_collection,
                    product: perfume,
                    slot: slot,
                    name: scent_name,
                    image: perfume_image,
                    label: perfume_label_text,
                    note: s.free_label,
                    show_price: false
                  -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if has_perfume or miswak != blank or has_hijab -%}
          <fieldset class="tss-gbx__step">
            <legend class="tss-gbx__legend">
              <span class="tss-gbx__num" aria-hidden="true">{{ step_extras | prepend: '0' }}</span>
              {{- s.addons_label | escape }}
              <span class="tss-gbx__optional">{{ s.optional_label | escape }}</span>
            </legend>

            <div class="tss-gbx__extras">
              {%- if has_perfume -%}
                <div class="tss-gbx__extra">
                  {%- if perfume_image != blank -%}
                    {{- perfume_image | image_url: width: 216 | image_tag: class: 'tss-gbx__extra-img', loading: 'lazy', widths: '72, 144, 216', sizes: '72px', alt: '' -}}
                  {%- endif -%}
                  <div class="tss-gbx__extra-text">
                    <span class="tss-gbx__extra-name">{{ perfume_label_text | escape }}</span>
                    {%- if s.perfume_text != blank -%}
                      <span class="tss-gbx__extra-note">{{ s.perfume_text | escape }}</span>
                    {%- endif -%}
                    <span class="tss-gbx__extra-price" data-only-one>
                      {%- if perfume_prices_vary -%}
                        {%- assign perfume_from = perfume_price | money -%}
                        {{ 'content.price_from' | t: price: perfume_from }}
                      {%- else -%}
                        + {{ perfume_price | money }}
                      {%- endif -%}
                    </span>
                    {%- if s.perfume_free_text != blank -%}
                      <span class="tss-gbx__extra-free" data-only-two hidden>{{ s.perfume_free_text | escape }}</span>
                    {%- endif -%}
                  </div>
                  <label class="tss-gbx__add" data-only-one>
                    <input type="checkbox" aria-label="{{ s.add_label | escape }} {{ perfume_label_text | escape }}" data-perfume-toggle>
                    <span class="tss-gbx__add-off" aria-hidden="true">{{ s.add_label | escape }}</span>
                    <span class="tss-gbx__add-on" aria-hidden="true">✓ {{ s.added_label | escape }}</span>
                  </label>
                  <span class="tss-gbx__included" data-only-two hidden>✓ {{ s.included_label | escape }}</span>
                </div>
                <div class="tss-gbx__sub" role="radiogroup" aria-label="{{ s.scent_label | escape }}" data-perfume-scents hidden>
                  {%- render 'tss-gift-box-scents',
                    collection: perfume_collection,
                    product: perfume,
                    slot: 0,
                    name: scent_group,
                    image: perfume_image,
                    label: perfume_label_text,
                    show_price: perfume_prices_vary
                  -%}
                </div>
              {%- endif -%}

              {%- if miswak != blank -%}
                <div class="tss-gbx__extra">
                  {%- if miswak_image != blank -%}
                    {{- miswak_image | image_url: width: 216 | image_tag: class: 'tss-gbx__extra-img', loading: 'lazy', widths: '72, 144, 216', sizes: '72px', alt: '' -}}
                  {%- endif -%}
                  <div class="tss-gbx__extra-text">
                    <span class="tss-gbx__extra-name">{{ miswak_label_text | escape }}</span>
                    {%- if s.miswak_text != blank -%}
                      <span class="tss-gbx__extra-note">{{ s.miswak_text | escape }}</span>
                    {%- endif -%}
                    <span class="tss-gbx__extra-price">
                      {%- if miswak.available -%}
                        + {{ miswak.price | money }}
                      {%- else -%}
                        {{ s.sold_out_label | escape }}
                      {%- endif -%}
                    </span>
                  </div>
                  <label class="tss-gbx__add">
                    <input
                      type="checkbox"
                      value="{{ miswak.selected_or_first_available_variant.id }}"
                      data-price="{{ miswak.price }}"
                      aria-label="{{ s.add_label | escape }} {{ miswak_label_text | escape }}"
                      data-miswak
                      {% unless miswak.available %}
                        disabled
                      {% endunless %}
                    >
                    <span class="tss-gbx__add-off" aria-hidden="true">{{ s.add_label | escape }}</span>
                    <span class="tss-gbx__add-on" aria-hidden="true">✓ {{ s.added_label | escape }}</span>
                  </label>
                </div>
              {%- endif -%}

              {%- if has_hijab -%}
                {%- comment -%}
                  Hijab: photo with the fabric switch (Pashmina / Cherry) under
                  it; beside it the chosen colour's name and price, small round
                  swatches for the chosen fabric and a stepper. Each colour keeps
                  its own count, shown as a badge on its swatch; every counted
                  colour is its own line.
                {%- endcomment -%}
                <div class="tss-gbx__hijab" data-hijab>
                  <div class="tss-gbx__hijab-media">
                    <img alt="" width="600" height="600" loading="lazy" data-hijab-img hidden>
                  </div>
                  <div class="tss-gbx__hijab-body">
                    <span class="tss-gbx__hijab-name" data-hijab-name>{{ hijab_label_text | escape }}</span>
                    <div class="tss-gbx__hijab-price">
                      <span class="tss-gbx__extra-price">
                        <span data-hijab-sale></span>
                        {%- if s.hijab_discount > 0 %} <s data-hijab-full></s>{% endif -%}
                      </span>
                      {%- if s.hijab_badge != blank and s.hijab_discount > 0 -%}
                        <span class="tss-gbx__extra-badge">
                          {{- s.hijab_badge | replace: '[percent]', s.hijab_discount | escape -}}
                        </span>
                      {%- endif -%}
                    </div>

                    <div class="tss-gbx__swatches" role="group" aria-label="{{ s.hijab_choice_label | escape }}">
                      {%- assign first_open = true -%}
                      {%- for g in (1..2) -%}
                        {%- liquid
                          # Group 1 is the first fabric (collection, or one product);
                          # group 2 the second fabric's collection.
                          assign group_from_collection = false
                          assign group_items = nil
                          if g == 1
                            assign group_collection = hijab_collection
                            assign group_lines = hijab_swatch_lines
                            if hijab_collection != blank and hijab_collection.products_count > 0
                              assign group_from_collection = true
                              assign group_items = hijab_collection.products
                            elsif hijab != blank
                              assign group_items = hijab.handle | split: ','
                            endif
                          else
                            assign group_collection = s.hijab_collection_2
                            assign group_lines = s.hijab_swatch_colours_2 | newline_to_br | split: '<br />'
                            if group_collection != blank and group_collection.products_count > 0
                              assign group_from_collection = true
                              assign group_items = group_collection.products
                            endif
                          endif
                          if group_items == nil
                            continue
                          endif
                        -%}
                        {%- for entry in group_items limit: 50 -%}
                          {%- liquid
                            assign item = entry
                            unless group_from_collection
                              assign item = all_products[entry]
                            endunless
                            if hijab_exclude != blank
                              assign item_title = item.title | downcase
                              if item_title contains hijab_exclude
                                continue
                              endif
                            endif
                          -%}
                          {%- for variant in item.variants -%}
                            {%- liquid
                              unless variant.available
                                continue
                              endunless
                              assign piece_name = item.title
                              unless item.has_only_default_variant
                                if group_from_collection
                                  assign piece_name = item.title | append: ' ' | append: variant.title
                                else
                                  assign piece_name = variant.title
                                endif
                              endunless
                              assign piece_image = variant.featured_image | default: item.featured_image
                              assign piece_max = 99
                              if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
                                assign piece_max = variant.inventory_quantity | at_least: 0
                              endif
                              assign piece_sale = variant.price | times: hijab_keep | divided_by: 100

                              # The longest colour name found in the piece name wins, so
                              # "Mint Green" is not painted as "Mint".
                              assign piece_colour = ''
                              assign best_size = 0
                              assign piece_lower = piece_name | downcase
                              for line in group_lines
                                assign pair = line | split: ':'
                                if pair.size < 2
                                  continue
                                endif
                                assign colour_name = pair[0] | strip | downcase
                                if colour_name != blank and colour_name.size > best_size and piece_lower contains colour_name
                                  assign best_size = colour_name.size
                                  assign piece_colour = pair[1] | strip | remove: ';' | remove: '"'
                                endif
                              endfor
                              if piece_colour == blank
                                for value in item.options_with_values.first.values
                                  if value == variant.option1 and value.swatch.color
                                    assign piece_colour = value.swatch.color
                                  endif
                                endfor
                              endif
                            -%}
                            <button
                              type="button"
                              class="tss-gbx__hswatch"
                              aria-pressed="{% if first_open %}true{% else %}false{% endif %}"
                              aria-label="{{ piece_name | escape }}"
                              {% if piece_colour != blank %}
                                style="background-color: {{ piece_colour | escape }};"
                              {% elsif piece_image %}
                                style="background-image: url('{{ piece_image | image_url: width: 80, height: 80, crop: 'center' }}');"
                              {% endif %}
                              data-hijab-swatch
                              data-hijab-group="{{ g }}"
                              data-variant="{{ variant.id }}"
                              data-name="{{ piece_name | escape }}"
                              data-price="{{ piece_sale }}"
                              data-full="{{ variant.price }}"
                              data-max="{{ piece_max }}"
                              {% if piece_image %}
                                data-large="{{ piece_image | image_url: width: 600 }}"
                              {% endif %}
                              {% if g != 1 %}
                                hidden
                              {% endif %}
                            >
                              <span class="tss-gbx__hswatch-badge" data-badge hidden></span>
                            </button>
                            {%- assign first_open = false -%}
                          {%- endfor -%}
                        {%- endfor -%}
                      {%- endfor -%}
                    </div>
                  </div>
                  {%- comment -%} Fabric switch and stepper share one row under the card. {%- endcomment -%}
                  <div class="tss-gbx__hijab-foot">
                    {%- if hijab_group_count > 1 -%}
                      <div class="tss-gbx__hijab-tabs" role="group" aria-label="{{ s.hijab_fabric_label | escape }}">
                        {%- for g in (1..2) -%}
                          {%- liquid
                            if g == 1
                              assign tab_label = s.hijab_tab_1 | default: hijab_collection.title
                            else
                              assign tab_label = s.hijab_tab_2 | default: s.hijab_collection_2.title
                            endif
                          -%}
                          <button
                            type="button"
                            class="tss-gbx__hijab-tab"
                            aria-pressed="{% if g == 1 %}true{% else %}false{% endif %}"
                            data-hijab-tab="{{ g }}"
                          >
                            {{- tab_label | escape -}}
                          </button>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                    {%- if first_open -%}
                      <span class="tss-gbx__extra-note">{{ s.sold_out_label | escape }}</span>
                    {%- else -%}
                      <div class="tss-gbx__stepper">
                        <button type="button" aria-label="{{ s.remove_one_label | escape }}" data-hijab-dec>−</button>
                        <output aria-live="polite" data-hijab-qty>0</output>
                        <button type="button" aria-label="{{ s.add_one_label | escape }}" data-hijab-inc>+</button>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </fieldset>
        {%- endif -%}

        <div class="tss-gbx__summary">
          <ul class="tss-gbx__lines" data-lines></ul>
          <div class="tss-gbx__total">
            <span class="tss-gbx__total-label">{{ s.total_label | escape }}</span>
            <span class="tss-gbx__total-value" data-total>{{ current.price | money }}</span>
          </div>
          {%- if s.delivery_note != blank -%}
            <p class="tss-gbx__note">{{ s.delivery_note | escape }}</p>
          {%- endif -%}
          <p class="tss-gbx__hint" role="status" data-hint></p>
          <button type="submit" class="tss-gbx__submit" data-submit>{{ s.button_label | escape }}</button>
          {%- if s.trust_line != blank -%}
            <p class="tss-gbx__trust">{{ s.trust_line | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    </form>

    <div class="tss-gbx__bar">
      <div class="tss-gbx__bar-info">
        <p class="tss-gbx__bar-line" data-bar-line></p>
        <p class="tss-gbx__bar-total" data-total>{{ current.price | money }}</p>
      </div>
      <button type="submit" form="tss-gbx-{{ uid }}-form" class="tss-gbx__submit" data-submit>
        {{- s.button_label | escape -}}
      </button>
    </div>
  {%- endif -%}
</section>

{%- if box != blank -%}
  <script>
    (function () {
      var root = document.getElementById('tss-gbx-{{ uid }}');
      if (!root || root.hasAttribute('data-ready')) return;
      root.setAttribute('data-ready', '');

      var ADD_URL = {{ routes.cart_add_url | append: '.js' | json }};
      var CART_URL = {{ routes.cart_url | json }};
      var AFTER_ADD = {{ s.after_add | json }};
      var MONEY_FORMAT = {{ shop.money_format | strip_html | json }};
      var COLOUR = {{ colour_property | json }};
      var CARD = {{ card_property | json }};
      var PERFUME = {{ perfume_property | json }};
      var NAME = {{ name_property | json }};
      var LINK = {{ s.link_property | default: 'For' | json }};
      var HAS_PERFUME = {{ has_perfume | json }};
      var T = {
        adding: {{ s.adding_label | json }},
        error: {{ s.error_text | json }},
        free: {{ s.free_label | json }},
        box: {{ s.box_label | default: 'Box' | json }},
        boxOne: {{ s.box_one_label | json }},
        boxTwo: {{ s.box_two_label | json }},
        two: {{ s.two_label | json }},
        twoNote: {{ s.two_note | json }},
        perfume: {{ perfume_label_text | json }},
        miswak: {{ miswak_label_text | json }},
        hijab: {{ hijab_label_text | json }},
        offer: {% if s.hijab_discount > 0 %}{{ s.hijab_badge | replace: '[percent]', s.hijab_discount | json }}{% else %}''{% endif %}
      };
      var OFFER = {{ s.hijab_offer_property | default: 'Offer' | json }};

      var form = root.querySelector('[data-form]');
      var rail = root.querySelector('[data-rail]');
      var dots = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
      var submits = Array.prototype.slice.call(root.querySelectorAll('[data-submit]'));
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-tab]'));
      var totals = root.querySelectorAll('[data-total]');
      var price = root.querySelector('[data-price]');
      var hint = root.querySelector('[data-hint]');
      var lines = root.querySelector('[data-lines]');
      var barLine = root.querySelector('[data-bar-line]');
      var perfumeToggle = root.querySelector('[data-perfume-toggle]');
      var scents = root.querySelector('[data-perfume-scents]');
      var miswak = root.querySelector('[data-miswak]');
      var hijabCard = root.querySelector('[data-hijab]');
      var hijabSwatches = Array.prototype.slice.call(root.querySelectorAll('[data-hijab-swatch]'));
      var hijabImg = root.querySelector('[data-hijab-img]');
      var hijabName = root.querySelector('[data-hijab-name]');
      var hijabSale = root.querySelector('[data-hijab-sale]');
      var hijabFull = root.querySelector('[data-hijab-full]');
      var hijabQtyOut = root.querySelector('[data-hijab-qty]');
      var hijabDec = root.querySelector('[data-hijab-dec]');
      var hijabInc = root.querySelector('[data-hijab-inc]');
      var hijabTabs = Array.prototype.slice.call(root.querySelectorAll('[data-hijab-tab]'));
      var hijabQty = {};
      var hijabActive = hijabSwatches[0] || null;
      var hijabGroup = hijabActive ? hijabActive.getAttribute('data-hijab-group') : '1';
      var labels = submits.map(function (b) { return b.textContent; });
      var active = 1;
      var busy = false;

      // Shopify's money_format is a Liquid fragment, not a number format.
      function money(cents) {
        var value = (cents || 0) / 100;
        function withCommas(n) {
          var parts = n.split('.');
          parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
          return parts.join('.');
        }
        return String(MONEY_FORMAT).replace(/\{\{\s*(\w+)\s*\}\}/, function (_, token) {
          switch (token) {
            case 'amount_no_decimals':
              return withCommas(String(Math.round(value)));
            case 'amount_with_comma_separator':
              return withCommas(value.toFixed(2)).replace(/,/g, ' ').replace('.', ',');
            case 'amount_no_decimals_with_comma_separator':
              return withCommas(String(Math.round(value))).replace(/,/g, '.');
            case 'amount_no_decimals_with_space_separator':
              return withCommas(String(Math.round(value))).replace(/,/g, ' ');
            default:
              return withCommas(value.toFixed(2));
          }
        });
      }

      function picked(selector) {
        return root.querySelector(selector + ' input:checked');
      }

      function count() {
        var input = root.querySelector('[data-count]:checked');
        return input ? parseInt(input.value, 10) : 1;
      }

      function cents(input) {
        return input ? parseInt(input.getAttribute('data-price'), 10) || 0 : 0;
      }

      function panel(slot) {
        return root.querySelector('[data-box-panel="' + slot + '"]');
      }

      // "Navy Floral, Nikah Dua" for one box.
      function describe(slot) {
        var colour = picked('[data-colours="' + slot + '"]');
        var card = picked('[data-cards="' + slot + '"]');
        var parts = [];
        if (colour) parts.push(colour.getAttribute('data-title'));
        if (card) parts.push(card.value);
        return parts.join(', ');
      }

      function state() {
        var two = count() === 2;
        var first = picked('[data-colours="1"]');
        var second = two ? picked('[data-colours="2"]') : null;
        var scent = !two && perfumeToggle && perfumeToggle.checked ? picked('[data-perfume-scents]') : null;
        var addMiswak = !!(miswak && miswak.checked);
        // Every hijab colour with a count, in swatch order.
        var hijabs = hijabSwatches
          .map(function (el) { return { el: el, qty: hijabQty[el.getAttribute('data-variant')] || 0 }; })
          .filter(function (h) { return h.qty > 0; });
        var hijabTotal = hijabs.reduce(function (sum, h) { return sum + cents(h.el) * h.qty; }, 0);
        var total = cents(first) + cents(second) + cents(scent) + (addMiswak ? cents(miswak) : 0) + hijabTotal;
        return { two: two, first: first, second: second, scent: scent, miswak: addMiswak, hijabs: hijabs, total: total };
      }

      function addLine(label, value) {
        var item = document.createElement('li');
        var name = document.createElement('span');
        var amount = document.createElement('span');
        item.className = 'tss-gbx__line';
        name.textContent = label;
        amount.textContent = value;
        item.appendChild(name);
        item.appendChild(amount);
        lines.appendChild(item);
      }

      function renderLines(st) {
        if (!lines) return;
        lines.textContent = '';
        if (st.two) {
          addLine(T.boxOne + ': ' + describe(1), money(cents(st.first)));
          addLine(T.boxTwo + ': ' + describe(2), money(cents(st.second || st.first)));
          if (HAS_PERFUME) addLine('2 × ' + T.perfume, T.free);
        } else {
          addLine(T.box + ': ' + describe(1), money(cents(st.first)));
          if (st.scent) {
            var several = scents && scents.querySelectorAll('input').length > 1;
            addLine(several ? T.perfume + ' – ' + st.scent.getAttribute('data-title') : T.perfume, money(cents(st.scent)));
          }
        }
        if (st.miswak) addLine(T.miswak, money(cents(miswak)));
        st.hijabs.forEach(function (h) {
          var label = hijabSwatches.length > 1 ? h.el.getAttribute('data-name') : T.hijab;
          addLine(label + (h.qty > 1 ? ' × ' + h.qty : ''), money(cents(h.el) * h.qty));
        });
      }

      function render() {
        var st = state();
        if (!st.two) active = 1;

        root.querySelectorAll('[data-only-one]').forEach(function (el) { el.hidden = st.two; });
        root.querySelectorAll('[data-only-two]').forEach(function (el) { el.hidden = !st.two; });

        // Two boxes turn the box panels into tabs; one box shows the first panel only.
        [1, 2].forEach(function (slot) {
          var el = panel(slot);
          if (!el) return;
          el.hidden = active !== slot;
          if (st.two) {
            el.setAttribute('role', 'tabpanel');
            el.setAttribute('aria-labelledby', 'tss-gbx-{{ uid }}-tab-' + slot);
          } else {
            el.removeAttribute('role');
            el.removeAttribute('aria-labelledby');
          }
        });
        tabs.forEach(function (tab) {
          var slot = parseInt(tab.getAttribute('data-tab'), 10);
          var colour = picked('[data-colours="' + slot + '"]');
          var label = tab.querySelector('[data-tab-colour]');
          tab.setAttribute('aria-selected', slot === active ? 'true' : 'false');
          tab.tabIndex = slot === active ? 0 : -1;
          if (label) label.textContent = colour ? ' · ' + colour.getAttribute('data-title') : '';
        });

        root.querySelectorAll('[data-mood-out]').forEach(function (el) {
          var colour = picked('[data-colours="' + el.getAttribute('data-mood-out') + '"]');
          var mood = (colour && colour.getAttribute('data-mood')) || '';
          el.textContent = mood;
          el.hidden = !mood;
        });

        // A single scent needs no choice; it stays checked behind the scenes.
        root.querySelectorAll('[data-scent-group]').forEach(function (group) {
          group.hidden = !st.two || group.querySelectorAll('input').length < 2;
        });
        if (scents) {
          scents.hidden = st.two || !(perfumeToggle && perfumeToggle.checked) || scents.querySelectorAll('input').length < 2;
        }

        // The hijab card shows the active colour: photo, name, prices and its count.
        if (hijabCard && hijabActive) {
          var activeId = hijabActive.getAttribute('data-variant');
          var activeQty = hijabQty[activeId] || 0;
          var large = hijabActive.getAttribute('data-large');
          if (hijabImg && large) {
            if (hijabImg.getAttribute('src') !== large) hijabImg.src = large;
            hijabImg.hidden = false;
          }
          if (hijabName) hijabName.textContent = hijabActive.getAttribute('data-name');
          if (hijabSale) hijabSale.textContent = '+ ' + money(cents(hijabActive));
          if (hijabFull) hijabFull.textContent = money(parseInt(hijabActive.getAttribute('data-full'), 10));
          if (hijabQtyOut) hijabQtyOut.textContent = activeQty;
          if (hijabDec) hijabDec.disabled = activeQty <= 0;
          if (hijabInc) hijabInc.disabled = activeQty >= (parseInt(hijabActive.getAttribute('data-max'), 10) || 99);
          hijabTabs.forEach(function (tab) {
            tab.setAttribute('aria-pressed', tab.getAttribute('data-hijab-tab') === hijabGroup ? 'true' : 'false');
          });
          hijabSwatches.forEach(function (el) {
            var qty = hijabQty[el.getAttribute('data-variant')] || 0;
            var badge = el.querySelector('[data-badge]');
            el.hidden = el.getAttribute('data-hijab-group') !== hijabGroup;
            el.setAttribute('aria-pressed', el === hijabActive ? 'true' : 'false');
            if (badge) {
              badge.textContent = qty;
              badge.hidden = qty === 0;
            }
          });
          hijabCard.setAttribute('data-count', st.hijabs.reduce(function (sum, h) { return sum + h.qty; }, 0));
        }

        var text = money(st.total);
        totals.forEach(function (el) { el.textContent = text; });
        if (price && st.first) price.textContent = money(cents(st.first));

        var one = root.querySelector('[data-count-price="1"]');
        var pair = root.querySelector('[data-count-price="2"]');
        if (one && st.first) one.textContent = money(cents(st.first));
        if (pair && st.first) {
          var other = picked('[data-colours="2"]');
          pair.textContent = money(cents(st.first) + cents(other || st.first));
        }

        renderLines(st);
        if (barLine) {
          barLine.textContent = st.two
            ? [T.two, HAS_PERFUME ? T.twoNote : ''].filter(Boolean).join(' · ')
            : describe(1);
        }

        submits.forEach(function (b, i) {
          b.setAttribute('aria-disabled', busy || !st.first ? 'true' : 'false');
          b.textContent = busy ? T.adding : labels[i];
        });
      }

      /* ---------- tabs ---------- */
      function selectTab(slot, focus) {
        active = slot;
        render();
        if (focus) {
          var tab = root.querySelector('[data-tab="' + slot + '"]');
          if (tab) tab.focus();
        }
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          selectTab(parseInt(tab.getAttribute('data-tab'), 10), false);
        });
        tab.addEventListener('keydown', function (event) {
          var keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
          if (keys.indexOf(event.key) === -1) return;
          event.preventDefault();
          var next = event.key === 'Home' ? 1 : event.key === 'End' ? 2 : active === 1 ? 2 : 1;
          selectTab(next, true);
        });
      });

      /* ---------- hijab ---------- */
      hijabSwatches.forEach(function (el) {
        el.addEventListener('click', function () {
          hijabActive = el;
          render();
        });
      });

      // Switching fabric shows its swatches and picks its first colour.
      hijabTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var group = tab.getAttribute('data-hijab-tab');
          if (group === hijabGroup) return;
          var first = hijabSwatches.filter(function (el) {
            return el.getAttribute('data-hijab-group') === group;
          })[0];
          if (!first) return;
          hijabGroup = group;
          hijabActive = first;
          render();
        });
      });

      function stepHijab(delta) {
        if (!hijabActive) return;
        var id = hijabActive.getAttribute('data-variant');
        var max = parseInt(hijabActive.getAttribute('data-max'), 10) || 99;
        hijabQty[id] = Math.min(max, Math.max(0, (hijabQty[id] || 0) + delta));
        hint.removeAttribute('data-error');
        hint.textContent = '';
        render();
      }

      if (hijabDec) hijabDec.addEventListener('click', function () { stepHijab(-1); });
      if (hijabInc) hijabInc.addEventListener('click', function () { stepHijab(1); });

      /* ---------- gallery ---------- */
      function goTo(index) {
        var slide = rail.children[index];
        if (slide) rail.scrollTo({ left: slide.offsetLeft - rail.offsetLeft });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goTo(parseInt(dot.getAttribute('data-dot'), 10));
        });
      });

      if (dots.length) {
        rail.addEventListener('scroll', function () {
          var index = Math.round(rail.scrollLeft / rail.clientWidth);
          dots.forEach(function (dot, i) {
            dot.setAttribute('aria-current', i === index ? 'true' : 'false');
          });
        }, { passive: true });
      }

      function showVariantMedia(input) {
        var id = input && input.getAttribute('data-media');
        if (!id) return;
        var slide = rail.querySelector('[data-media-id="' + id + '"]');
        if (slide) goTo(Array.prototype.indexOf.call(rail.children, slide));
      }

      form.addEventListener('change', function (event) {
        var target = event.target;
        if (target.closest('[data-colours], [data-cards]')) showVariantMedia(target);
        hint.removeAttribute('data-error');
        hint.textContent = '';
        render();
      });

      /* ---------- order ---------- */
      // A colour block rides as a property; a variant colour is the line's id.
      function boxLine(colour, card, scent, slot) {
        var properties = {};
        var name = root.querySelector('[data-box-name="' + slot + '"]');
        var nameValue = name ? name.value.trim() : '';
        if (colour.hasAttribute('data-property')) properties[COLOUR] = colour.value;
        if (card) properties[CARD] = card.value;
        if (nameValue) properties[NAME] = nameValue;
        if (scent) properties[PERFUME] = scent.value + ' (' + T.free + ')';
        return { id: parseInt(colour.getAttribute('data-variant'), 10), quantity: 1, properties: properties };
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var st = state();
        if (busy || !st.first) return;

        var items = [];
        if (st.two) {
          items.push(boxLine(st.first, picked('[data-cards="1"]'), root.querySelector('[data-scent="1"]:checked'), 1));
          items.push(boxLine(st.second || st.first, picked('[data-cards="2"]'), root.querySelector('[data-scent="2"]:checked'), 2));
        } else {
          items.push(boxLine(st.first, picked('[data-cards="1"]'), null, 1));
          if (st.scent) {
            var link = {};
            link[LINK] = st.first.getAttribute('data-title');
            items.push({ id: parseInt(st.scent.value, 10), quantity: 1, properties: link });
          }
        }
        if (st.miswak) items.push({ id: parseInt(miswak.value, 10), quantity: 1 });
        st.hijabs.forEach(function (h) {
          var hijabProps = {};
          hijabProps[LINK] = st.first.getAttribute('data-title');
          if (T.offer) hijabProps[OFFER] = T.offer;
          items.push({ id: parseInt(h.el.getAttribute('data-variant'), 10), quantity: h.qty, properties: hijabProps });
        });

        busy = true;
        render();

        fetch(ADD_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: items })
        })
          .then(function (response) {
            return response.json().then(function (body) {
              if (!response.ok) throw new Error(body.description || body.message || T.error);
              return body;
            });
          })
          .then(function () {
            window.location.href = AFTER_ADD === 'checkout' ? '/checkout' : CART_URL;
          })
          .catch(function (error) {
            busy = false;
            hint.setAttribute('data-error', 'true');
            hint.textContent = (error && error.message) || T.error;
            render();
          });
      });

      // Returning with the back button restores the page from cache mid-submit.
      window.addEventListener('pageshow', function (event) {
        if (!event.persisted) return;
        busy = false;
        render();
      });

      render();
    })();
  </script>
{%- endif -%}

