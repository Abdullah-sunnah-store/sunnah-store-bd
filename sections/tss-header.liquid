{% comment %}
  TSS — Header
  Fixed stack: emerald utility bar (region toggle + rotating notice), an
  optional gift-box link bar, then an ivory bar holding the menu trigger,
  serif wordmark, search and bag.
  Hides on scroll down, returns on scroll up.
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign menu = linklists[s.menu]

  # The gift-box bar adds its height to the fixed stack, so the spacer and
  # --header-height grow with it.
  assign show_offer = false
  if s.show_offer and s.offer_link != blank
    assign show_offer = true
  endif

  assign promo_h = 0
  if s.show_promo and s.promo_text != blank
    assign promo_h = 36
  endif

  assign show_nav = false
  if s.show_desktop_nav and menu.links.size > 0
    assign show_nav = true
  endif
-%}

<style>
  #tss-header-{{ uid }} {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    transition: transform 0.4s ease-out;
  }

  #tss-header-{{ uid }}[data-hidden='true'] {
    transform: translateY(-100%);
  }

  #tss-header-{{ uid }} .tss-head__utility {
    display: flex;
    height: 32px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--tss-green);
    padding-inline: var(--tss-gutter);
    color: var(--tss-ivory);
  }

  #tss-header-{{ uid }} .tss-head__notices {
    position: relative;
    height: 16px;
    flex: 1;
    overflow: hidden;
    text-align: center;
  }

  #tss-header-{{ uid }} .tss-head__notice {
    position: absolute;
    inset: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--tss-sans);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgb(245 240 232 / 0.7);
    opacity: 0;
    transition: opacity 0.6s var(--tss-ease);
  }

  #tss-header-{{ uid }} .tss-head__notice.is-active {
    opacity: 1;
  }

  #tss-header-{{ uid }} .tss-head__bar {
    display: flex;
    height: 56px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgb(8 41 30 / 0.12);
    background: var(--tss-ivory);
    padding-inline: 12px;
  }

  #tss-header-{{ uid }} .tss-head__icon {
    display: flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--tss-ink);
    cursor: pointer;
    text-decoration: none;
    position: relative;
  }

  #tss-header-{{ uid }} .tss-head__icon .tss-icon {
    width: 20px;
    height: 20px;
  }

  #tss-header-{{ uid }} .tss-head__actions {
    display: flex;
    align-items: center;
  }

  #tss-header-{{ uid }} .tss-head__wordmark {
    font-family: var(--tss-serif);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--tss-green);
    text-decoration: none;
  }

  #tss-header-{{ uid }} .tss-head__logo {
    display: block;
    max-height: 32px;
    width: auto;
  }

  #tss-header-{{ uid }} .tss-head__count {
    position: absolute;
    top: 8px;
    right: 6px;
    min-width: 16px;
    height: 16px;
    border-radius: 8px;
    background: var(--tss-gold);
    color: var(--tss-green-dark);
    font-size: 10px;
    font-weight: 500;
    line-height: 16px;
    text-align: center;
  }

  /* ---------- desktop menu bar ----------
     On wide screens the ivory bar carries the lot on one line: wordmark left,
     menu centred, search and bag right. Hidden below 64rem, where the
     hamburger and its drawer still do the work. */
  #tss-header-{{ uid }} .tss-head__nav {
    display: none;
  }

  /* ---------- gift-box bar ---------- */
  #tss-header-{{ uid }} .tss-head__promo {
    position: relative;
    display: flex;
    height: 36px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    overflow: hidden;
    border-bottom: 1px solid rgb(8 41 30 / 0.12);
    background: {{ s.promo_bg | default: '#fafafa' }};
    padding-inline: var(--tss-gutter);
    font-family: var(--tss-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--tss-ink);
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  #tss-header-{{ uid }} .tss-head__promo:hover {
    background: {{ s.promo_bg_hover | default: '#edf5e8' }};
  }

  #tss-header-{{ uid }} .tss-head__promo:focus-visible {
    outline: 2px solid var(--tss-green-mid);
    outline-offset: -3px;
  }

  #tss-header-{{ uid }} .tss-head__promo::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(255 255 255 / 0) 50%, rgb(255 255 255 / 0.4) 70%, rgb(255 255 255 / 0) 80%);
    transform: translateX(-100%);
    pointer-events: none;
  }

  #tss-header-{{ uid }} .tss-head__promo:hover::before {
    animation: tss-head-shine 2s ease-in-out infinite;
  }

  #tss-header-{{ uid }} .tss-head__promo-text {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  #tss-header-{{ uid }} .tss-head__promo-arrow {
    display: grid;
    flex: none;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: var(--tss-ink);
    color: #fff;
    font-size: 12px;
  }

  #tss-header-{{ uid }} .tss-head__promo-arrow:dir(rtl) {
    transform: scaleX(-1);
  }

  /* ---------- offer badge (menu + drawer) ---------- */
  .tss-head__badge {
    display: inline-block;
    border-radius: 999px;
    background: {{ s.offer_bg | default: '#b8860b' }};
    padding: 4px 9px;
    font-family: var(--tss-sans);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06em;
    color: {{ s.offer_color | default: '#ffffff' }};
    white-space: nowrap;
    animation: tss-head-bounce 1.2s ease-in-out infinite;
  }

  .tss-head__badge-img {
    display: block;
    height: 22px;
    width: auto;
    animation: tss-head-bounce 1.2s ease-in-out infinite;
  }

  /* Hops up and back with a gold glow at the top of each hop. */
  @keyframes tss-head-bounce {
    0%, 100% { transform: translateY(0); filter: drop-shadow(0 0 0 rgb(212 168 48 / 0)); }
    50% { transform: translateY(-5px); filter: drop-shadow(0 4px 6px rgb(212 168 48 / 0.7)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tss-head__badge,
    .tss-head__badge-img {
      animation: none;
    }
  }

  /* Two classes, so it wins over the drawer link's display: block further down. */
  #tss-drawer-{{ uid }} .tss-drawer__link.tss-drawer__offer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  @keyframes tss-head-shine {
    0% { transform: translateX(-100%); }
    50%, 100% { transform: translateX(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    #tss-header-{{ uid }} .tss-head__promo:hover::before {
      animation: none;
    }
  }

  /* Spacer so page content clears the fixed stack */
  .tss-head__spacer-{{ uid }} {
    height: {{ 88 | plus: promo_h }}px;
  }

  {%- if promo_h > 0 -%}
    body {
      --header-height: {{ 88 | plus: promo_h }}px;
    }
  {%- endif -%}

  @media (min-width: 64rem) {
    /* Equal outer columns, so the menu sits on the centre of the bar rather
       than on whatever the wordmark leaves over. */
    #tss-header-{{ uid }}[data-nav='true'] .tss-head__bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
      height: 64px;
      gap: 24px;
      padding-inline: max(var(--tss-gutter), calc((100% - var(--tss-max)) / 2));
    }

    #tss-header-{{ uid }}[data-nav='true'] .tss-head__icon--menu {
      display: none;
    }

    #tss-header-{{ uid }}[data-nav='true'] .tss-head__wordmark {
      grid-column: 1;
      align-self: center;
      justify-self: start;
      min-width: 0;
      white-space: nowrap;
    }

    #tss-header-{{ uid }}[data-nav='true'] .tss-head__actions {
      grid-column: 3;
      align-self: center;
      justify-self: end;
    }

    #tss-header-{{ uid }} .tss-head__nav {
      display: flex;
      grid-column: 2;
      min-width: 0;
      height: 100%;
    }

    #tss-header-{{ uid }} .tss-head__list {
      display: flex;
      height: 100%;
      /* Full-height items, so a submenu opens flush under the bar. */
      align-items: stretch;
      justify-content: center;
      /* Tightens on narrower desktops so a long menu still fits on one line. */
      gap: clamp(14px, 2vw, 32px);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    #tss-header-{{ uid }} .tss-head__item {
      position: relative;
      display: flex;
    }

    /* A menu with a third level spreads the full width of the header, so it
       measures itself against the fixed stack rather than its own trigger. */
    #tss-header-{{ uid }} .tss-head__item--deep {
      position: static;
    }

    #tss-header-{{ uid }} .tss-head__link {
      display: flex;
      box-sizing: border-box;
      height: 100%;
      align-items: center;
      gap: 5px;
      padding: 0;
      border-bottom: 2px solid transparent;
      font-family: var(--tss-sans);
      font-size: 11px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      white-space: nowrap;
      color: var(--tss-green);
      text-decoration: none;
      transition: color 0.4s ease, border-color 0.4s ease;
    }

    #tss-header-{{ uid }} .tss-head__link svg {
      flex: 0 0 auto;
      transition: transform 0.3s var(--tss-ease);
    }

    #tss-header-{{ uid }} .tss-head__item:hover .tss-head__link,
    #tss-header-{{ uid }} .tss-head__link:focus-visible {
      border-bottom-color: var(--tss-gold);
      color: var(--tss-gold);
    }

    #tss-header-{{ uid }} .tss-head__item:hover .tss-head__link svg,
    #tss-header-{{ uid }} .tss-head__item:focus-within .tss-head__link svg {
      transform: rotate(180deg);
    }

    /* Kept focusable rather than hidden, so tabbing out of the parent opens it. */
    #tss-header-{{ uid }} .tss-head__sub {
      position: absolute;
      top: 100%;
      z-index: 1;
      border: 1px solid rgb(8 41 30 / 0.12);
      border-top: 0;
      background: var(--tss-ivory);
      opacity: 0;
      pointer-events: none;
      transform: translateY(6px);
      transition: opacity 0.35s var(--tss-ease), transform 0.35s var(--tss-ease);
    }

    #tss-header-{{ uid }} .tss-head__item:hover .tss-head__sub,
    #tss-header-{{ uid }} .tss-head__item:focus-within .tss-head__sub {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    /* One level down: a short list under the word itself. */
    #tss-header-{{ uid }} .tss-head__sub--list {
      left: 50%;
      translate: -50% 0;
      width: max-content;
      min-width: 200px;
      max-width: min(90vw, 340px);
      padding: 8px 0;
    }

    /* Two levels down: the full width of the bar, columns centred in it. */
    #tss-header-{{ uid }} .tss-head__sub--wide {
      left: 0;
      right: 0;
      border-inline: 0;
      padding: 28px max(var(--tss-gutter), calc((100% - var(--tss-max)) / 2)) 32px;
    }

    #tss-header-{{ uid }} .tss-head__cols {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px 48px;
    }

    #tss-header-{{ uid }} .tss-head__col {
      min-width: 150px;
    }

    #tss-header-{{ uid }} .tss-head__col-title {
      display: block;
      padding-bottom: 10px;
      font-family: var(--tss-sans);
      font-size: 10px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: rgb(184 134 11 / 0.9);
      text-decoration: none;
      transition: color 0.4s ease;
    }

    #tss-header-{{ uid }} .tss-head__col-title:hover {
      color: var(--tss-gold);
    }

    #tss-header-{{ uid }} .tss-head__sub-link {
      display: block;
      padding: 7px 20px;
      font-family: var(--tss-serif);
      font-size: 16px;
      line-height: 1.3;
      color: var(--tss-green);
      text-decoration: none;
      transition: color 0.4s ease;
    }

    #tss-header-{{ uid }} .tss-head__col .tss-head__sub-link {
      padding: 5px 0;
      font-size: 15px;
      color: rgb(28 28 26 / 0.72);
    }

    #tss-header-{{ uid }} .tss-head__sub-link:hover {
      color: var(--tss-gold);
    }

    {%- if show_nav -%}
      .tss-head__spacer-{{ uid }} {
        height: {{ 96 | plus: promo_h }}px;
      }

      /* base.css reads this for its own sticky offsets. */
      body {
        --header-height: {{ 96 | plus: promo_h }}px;
      }
    {%- endif -%}
  }

  /* Drawer */
  #tss-drawer-{{ uid }} {
    position: fixed;
    inset: 0;
    z-index: 60;
    visibility: hidden;
    pointer-events: none;
  }

  #tss-drawer-{{ uid }}[data-open='true'] {
    visibility: visible;
    pointer-events: auto;
  }

  #tss-drawer-{{ uid }} .tss-drawer__scrim {
    position: absolute;
    inset: 0;
    background: rgb(5 30 22 / 0.5);
    opacity: 0;
    transition: opacity 0.4s var(--tss-ease);
  }

  #tss-drawer-{{ uid }}[data-open='true'] .tss-drawer__scrim {
    opacity: 1;
  }

  #tss-drawer-{{ uid }} .tss-drawer__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: min(86vw, 380px);
    background: var(--tss-ivory);
    padding: 24px var(--tss-gutter);
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.5s var(--tss-ease);
  }

  #tss-drawer-{{ uid }}[data-open='true'] .tss-drawer__panel {
    transform: none;
  }

  #tss-drawer-{{ uid }} .tss-drawer__close {
    margin-bottom: 24px;
    border: 0;
    background: transparent;
    padding: 0;
    font-family: var(--tss-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(28 28 26 / 0.5);
    cursor: pointer;
  }

  #tss-drawer-{{ uid }} .tss-drawer__link {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid rgb(8 41 30 / 0.1);
    font-family: var(--tss-serif);
    font-size: 22px;
    color: var(--tss-green);
    text-decoration: none;
    transition: color 0.4s ease;
  }

  #tss-drawer-{{ uid }} .tss-drawer__link:hover {
    color: var(--tss-gold);
  }

  /* Submenus are collapsed until their parent is tapped. <details> carries the
     open/closed state and the expanded semantics on its own. */
  #tss-drawer-{{ uid }} .tss-drawer__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    list-style: none;
  }

  #tss-drawer-{{ uid }} .tss-drawer__summary::-webkit-details-marker {
    display: none;
  }

  #tss-drawer-{{ uid }} .tss-drawer__summary svg {
    flex: 0 0 auto;
    transition: transform 0.3s var(--tss-ease);
  }

  #tss-drawer-{{ uid }} .tss-drawer__group[open] .tss-drawer__summary svg {
    transform: rotate(180deg);
  }

  #tss-drawer-{{ uid }} .tss-drawer__subs {
    padding: 4px 0 12px;
  }

  #tss-drawer-{{ uid }} .tss-drawer__sub {
    display: block;
    padding: 8px 0 8px 16px;
    font-size: 14px;
    font-weight: 300;
    color: rgb(28 28 26 / 0.7);
    text-decoration: none;
  }

  #tss-drawer-{{ uid }} .tss-drawer__sub:hover {
    color: var(--tss-gold);
  }

  /* "View all [group]" call to action at the top of each open group. */
  #tss-drawer-{{ uid }} .tss-drawer__all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    margin-block: 8px 10px;
    margin-inline-start: 16px;
    padding: 10px 18px;
    border: 1px solid var(--tss-green);
    border-radius: 999px;
    background: var(--tss-green);
    color: var(--tss-ivory, #f5f0e6);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  #tss-drawer-{{ uid }} .tss-drawer__all:hover,
  #tss-drawer-{{ uid }} .tss-drawer__all:focus-visible {
    background: transparent;
    color: var(--tss-green);
  }

  #tss-drawer-{{ uid }} .tss-drawer__all-arrow {
    transition: transform 0.3s ease;
  }

  #tss-drawer-{{ uid }} .tss-drawer__all:hover .tss-drawer__all-arrow {
    transform: translateX(3px);
  }

  [dir='rtl'] #tss-drawer-{{ uid }} .tss-drawer__all-arrow {
    transform: scaleX(-1);
  }

  @media (prefers-reduced-motion: reduce) {
    #tss-drawer-{{ uid }} .tss-drawer__all,
    #tss-drawer-{{ uid }} .tss-drawer__all-arrow {
      transition: none;
    }
  }

  #tss-drawer-{{ uid }} .tss-drawer__sub.tss-drawer__summary {
    display: flex;
  }

  #tss-drawer-{{ uid }} .tss-drawer__child[open] > .tss-drawer__summary svg {
    transform: rotate(180deg);
  }

  /* The outer rule rotates every chevron in an open group; keep closed
     third-level chevrons pointing down. */
  #tss-drawer-{{ uid }} .tss-drawer__child:not([open]) > .tss-drawer__summary svg {
    transform: none;
  }

  #tss-drawer-{{ uid }} .tss-drawer__child[open] > .tss-drawer__summary {
    color: var(--tss-green);
  }

  #tss-drawer-{{ uid }} .tss-drawer__grandsubs {
    padding-bottom: 6px;
  }

  #tss-drawer-{{ uid }} .tss-drawer__grandsub {
    padding-block: 6px;
    padding-inline-start: 32px;
    font-size: 13px;
  }

  /* Search overlay — full-screen ivory sheet over the header: close top right,
     a single ruled input, then suggested searches and a popular-products rail
     until the shopper types, when live product and collection results take
     their place. */
  #tss-search-{{ uid }} {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background: var(--tss-ivory);
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.35s var(--tss-ease), visibility 0.35s;
  }

  #tss-search-{{ uid }}[data-open='true'] {
    visibility: visible;
    opacity: 1;
  }

  #tss-search-{{ uid }} .tss-search__top,
  #tss-search-{{ uid }} .tss-search__inner {
    box-sizing: border-box;
    width: 100%;
    max-width: calc(var(--tss-max) + (2 * var(--tss-gutter)));
    margin-inline: auto;
    padding-inline: var(--tss-gutter);
  }

  #tss-search-{{ uid }} .tss-search__top {
    flex-shrink: 0;
    padding-top: 12px;
  }

  #tss-search-{{ uid }} .tss-search__close-row {
    display: flex;
    justify-content: flex-end;
  }

  #tss-search-{{ uid }} .tss-search__close {
    display: flex;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--tss-ink);
    cursor: pointer;
  }

  #tss-search-{{ uid }} form {
    position: relative;
    display: flex;
    align-items: center;
    padding-bottom: 4px;
  }

  #tss-search-{{ uid }} .tss-search__glass {
    position: absolute;
    left: 0;
    display: flex;
    color: var(--tss-ink);
    pointer-events: none;
  }

  #tss-search-{{ uid }} input {
    width: 100%;
    height: 44px;
    padding: 0 36px 0 28px;
    border: 0;
    border-radius: 0;
    background: transparent;
    font-family: var(--tss-sans);
    font-size: 20px;
    color: var(--tss-ink);
    -webkit-appearance: none;
    appearance: none;
  }

  #tss-search-{{ uid }} input::placeholder {
    color: rgb(28 28 26 / 0.4);
  }

  #tss-search-{{ uid }} input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  #tss-search-{{ uid }} input:focus {
    outline: none;
  }

  #tss-search-{{ uid }} .tss-search__rule {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: rgb(26 74 58 / 0.25);
    transition: background 0.3s;
  }

  #tss-search-{{ uid }} input:focus ~ .tss-search__rule {
    background: var(--tss-gold);
  }

  #tss-search-{{ uid }} .tss-search__clear {
    position: absolute;
    right: -8px;
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: rgb(28 28 26 / 0.5);
    cursor: pointer;
  }

  #tss-search-{{ uid }} .tss-search__clear[hidden],
  #tss-search-{{ uid }} [data-view][hidden] {
    display: none;
  }

  #tss-search-{{ uid }} .tss-search__body {
    flex: 1;
    overflow-x: hidden;
    overflow-y: auto;
    padding-bottom: 64px;
    overscroll-behavior: contain;
  }

  #tss-search-{{ uid }} .tss-search__label {
    margin: 24px 0 4px;
    font-family: var(--tss-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--tss-gold);
  }

  #tss-search-{{ uid }} .tss-search__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #tss-search-{{ uid }} .tss-search__suggest {
    display: flex;
    height: 48px;
    align-items: center;
    justify-content: space-between;
    font-family: var(--tss-serif);
    font-size: 17px;
    color: var(--tss-ink);
    text-decoration: none;
  }

  #tss-search-{{ uid }} .tss-search__suggest svg {
    color: var(--tss-gold);
    transition: transform 0.3s var(--tss-ease);
  }

  #tss-search-{{ uid }} .tss-search__suggest:hover svg {
    transform: translateX(3px);
  }

  /* Popular rail: 40vw cards that bleed off the right on phones, four across
     from 64rem up. */
  #tss-search-{{ uid }} .tss-search__rail {
    display: flex;
    gap: 16px;
    margin-inline: calc(var(--tss-gutter) * -1);
    padding: 0 var(--tss-gutter) 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--tss-gutter);
    scrollbar-width: none;
  }

  #tss-search-{{ uid }} .tss-search__rail::-webkit-scrollbar {
    display: none;
  }

  #tss-search-{{ uid }} .tss-search__card {
    flex: 0 0 40vw;
    scroll-snap-align: start;
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 64rem) {
    #tss-search-{{ uid }} .tss-search__card {
      flex-basis: calc((100% - (2 * var(--tss-gutter)) - (3 * 16px)) / 4);
    }
  }

  #tss-search-{{ uid }} .tss-search__card-media {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--tss-ivory-2);
  }

  #tss-search-{{ uid }} .tss-search__card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--tss-ease);
  }

  @media (hover: hover) {
    #tss-search-{{ uid }} .tss-search__card:hover img {
      transform: scale(1.04);
    }
  }

  #tss-search-{{ uid }} .tss-search__vendor {
    margin: 12px 0 0;
    font-family: var(--tss-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(28 28 26 / 0.55);
  }

  #tss-search-{{ uid }} .tss-search__title {
    display: -webkit-box;
    margin: 4px 0 0;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-family: var(--tss-serif);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--tss-ink);
  }

  #tss-search-{{ uid }} .tss-search__price {
    margin: 4px 0 0;
    font-family: var(--tss-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--tss-gold);
  }

  /* Live results: 72px rows, thumbnail, vendor over title, price right. The
     typed term stays full ink; the rest of the title dims around it. */
  #tss-search-{{ uid }} .tss-search__row {
    display: flex;
    height: 72px;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid rgb(8 41 30 / 0.12);
    color: inherit;
    text-decoration: none;
  }

  #tss-search-{{ uid }} .tss-search__thumb {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    overflow: hidden;
    background: var(--tss-ivory-2);
  }

  #tss-search-{{ uid }} .tss-search__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #tss-search-{{ uid }} .tss-search__row-text {
    flex: 1;
    min-width: 0;
  }

  #tss-search-{{ uid }} .tss-search__row .tss-search__vendor {
    margin: 0;
  }

  #tss-search-{{ uid }} .tss-search__row .tss-search__title {
    display: block;
    margin: 2px 0 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-weight: 400;
    color: rgb(28 28 26 / 0.6);
  }

  #tss-search-{{ uid }} .tss-search__row .tss-search__title mark {
    background: none;
    color: var(--tss-ink);
  }

  #tss-search-{{ uid }} .tss-search__row .tss-search__price {
    flex-shrink: 0;
    margin: 0;
    font-size: 13px;
  }

  #tss-search-{{ uid }} .tss-search__all {
    display: inline-block;
    margin-top: 24px;
  }

  #tss-search-{{ uid }} .tss-search__empty {
    margin: 24px 0 0;
    font-family: var(--tss-serif);
    font-size: 17px;
    color: rgb(28 28 26 / 0.6);
  }
</style>

<div id="tss-header-{{ uid }}" class="tss-section" data-hidden="false" data-nav="{{ show_nav }}">
  {%- if s.show_utility -%}
    <div class="tss-head__utility">
      {% render 'tss-region-toggle' %}

      {%- if section.blocks.size > 0 -%}
        <div class="tss-head__notices" data-tss-notices data-interval="{{ s.notice_seconds | default: 5 | times: 1000 }}">
          {%- for block in section.blocks -%}
            <span class="tss-head__notice{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              {{- block.settings.text | escape -}}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if promo_h > 0 -%}
    <a class="tss-head__promo" href="{{ s.promo_link | default: routes.root_url }}">
      {%- if s.promo_icon != blank -%}
        <span aria-hidden="true">{{ s.promo_icon | escape }}</span>
      {%- endif -%}
      <span class="tss-head__promo-text">{{ s.promo_text | escape }}</span>
      <span class="tss-head__promo-arrow" aria-hidden="true">➔</span>
    </a>
  {%- endif -%}

  <header class="tss-head__bar">
    <button
      type="button"
      class="tss-head__icon tss-head__icon--menu"
      aria-label="Open menu"
      aria-expanded="false"
      data-tss-open="drawer"
    >
      {% render 'tss-icon', icon: 'menu', size: 20, stroke: 1.5 %}
    </button>

    <a href="{{ routes.root_url }}" class="tss-head__wordmark" aria-label="{{ shop.name | escape }}, home">
      {%- if s.logo != blank -%}
        {{ s.logo | image_url: width: 400 | image_tag: class: 'tss-head__logo', alt: shop.name }}
      {%- else -%}
        {{- s.wordmark | default: shop.name | escape -}}
      {%- endif -%}
    </a>

    {%- if show_nav -%}
      <nav class="tss-head__nav" aria-label="Main">
        <ul class="tss-head__list">
          {%- for link in menu.links -%}
            {%- liquid
              assign deep = false
              for child in link.links
                if child.links.size > 0
                  assign deep = true
                endif
              endfor
            -%}
            <li class="tss-head__item{% if deep %} tss-head__item--deep{% endif %}">
              <a href="{{ link.url }}" class="tss-head__link"{% if link.current %} aria-current="page"{% endif %}>
                <span>{{ link.title | escape }}</span>
                {%- if link.links.size > 0 -%}
                  {% render 'tss-icon', icon: 'chevron-down', size: 12, stroke: 1.5 %}
                {%- endif -%}
              </a>

              {%- if link.links.size > 0 -%}
                {%- if deep -%}
                  <div class="tss-head__sub tss-head__sub--wide">
                    <div class="tss-head__cols">
                      {%- for child in link.links -%}
                        <div class="tss-head__col">
                          <a href="{{ child.url }}" class="tss-head__col-title">{{ child.title | escape }}</a>
                          {%- for grandchild in child.links -%}
                            <a href="{{ grandchild.url }}" class="tss-head__sub-link">
                              {{- grandchild.title | escape -}}
                            </a>
                          {%- endfor -%}
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- else -%}
                  <div class="tss-head__sub tss-head__sub--list">
                    {%- for child in link.links -%}
                      <a href="{{ child.url }}" class="tss-head__sub-link">{{ child.title | escape }}</a>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endfor -%}
          {%- if show_offer -%}
            <li class="tss-head__item">
              <a href="{{ s.offer_link }}" class="tss-head__link" aria-label="{{ s.offer_label | default: s.offer_badge | escape }}">
                {%- if s.offer_image != blank -%}
                  {{ s.offer_image | image_url: height: 66 | image_tag: class: 'tss-head__badge-img', height: 22, alt: '' }}
                {%- else -%}
                  <span class="tss-head__badge">{{ s.offer_badge | escape }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="tss-head__actions">
      <button type="button" class="tss-head__icon" aria-label="Search" data-tss-open="search">
        {% render 'tss-icon', icon: 'search', size: 20, stroke: 1.5 %}
      </button>

      <a href="{{ routes.cart_url }}" class="tss-head__icon" aria-label="Your bag">
        {% render 'tss-icon', icon: 'shopping-bag', size: 20, stroke: 1.5 %}
        {%- if cart.item_count > 0 -%}
          <span class="tss-head__count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </header>

</div>

<div class="tss-head__spacer-{{ uid }}" aria-hidden="true"></div>

{%- comment -%} Menu drawer {%- endcomment -%}
<div id="tss-drawer-{{ uid }}" class="tss-section" data-open="false" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="tss-drawer__scrim" data-tss-close></div>
  <div class="tss-drawer__panel">
    <button type="button" class="tss-drawer__close" data-tss-close>Close</button>
    <nav>
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <details class="tss-drawer__group">
            <summary class="tss-drawer__link tss-drawer__summary">
              <span>{{ link.title | escape }}</span>
              {% render 'tss-icon', icon: 'chevron-down', size: 18, stroke: 1.5 %}
            </summary>
            <div class="tss-drawer__subs">
              {%- for child in link.links -%}
                {%- if child.links.size > 0 -%}
                  {%- comment -%} Third level: its own collapsible group, led by a link to the child page. {%- endcomment -%}
                  <details class="tss-drawer__child">
                    <summary class="tss-drawer__sub tss-drawer__summary">
                      <span>{{ child.title | escape }}</span>
                      {% render 'tss-icon', icon: 'chevron-down', size: 14, stroke: 1.5 %}
                    </summary>
                    <div class="tss-drawer__grandsubs">
                      <a href="{{ child.url }}" class="tss-drawer__sub tss-drawer__grandsub">
                        {{- 'actions.view_all' | t }} {{ child.title | escape -}}
                      </a>
                      {%- for grandchild in child.links -%}
                        <a href="{{ grandchild.url }}" class="tss-drawer__sub tss-drawer__grandsub">
                          {{- grandchild.title | escape -}}
                        </a>
                      {%- endfor -%}
                    </div>
                  </details>
                {%- else -%}
                  <a href="{{ child.url }}" class="tss-drawer__sub">{{ child.title | escape }}</a>
                {%- endif -%}
              {%- endfor -%}
              {%- comment -%} Close each group with a call to action for the parent page. {%- endcomment -%}
              {%- if link.url != blank and link.url != '#' -%}
                <a href="{{ link.url }}" class="tss-drawer__all">
                  <span>{{- 'actions.view_all' | t }} {{ link.title | escape -}}</span>
                  <span class="tss-drawer__all-arrow" aria-hidden="true">→</span>
                </a>
              {%- endif -%}
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" class="tss-drawer__link">{{ link.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- if show_offer -%}
        <a href="{{ s.offer_link }}" class="tss-drawer__link tss-drawer__offer">
          <span>{{ s.offer_label | default: s.offer_badge | escape }}</span>
          {%- if s.offer_image != blank -%}
            {{ s.offer_image | image_url: height: 66 | image_tag: class: 'tss-head__badge-img', height: 22, alt: '' }}
          {%- else -%}
            <span class="tss-head__badge" aria-hidden="true">{{ s.offer_badge | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </nav>
  </div>
</div>

{%- comment -%} Search overlay {%- endcomment -%}
{%- liquid
  assign search_terms = s.search_suggestions | newline_to_br | split: '<br />'
  assign popular = s.search_popular
  if popular == blank
    assign popular = collections.all
  endif
-%}
<div
  id="tss-search-{{ uid }}"
  class="tss-section"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
  data-suggest-url="{{ routes.predictive_search_url }}"
  data-search-url="{{ routes.search_url }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
>
  <div class="tss-search__top">
    <div class="tss-search__close-row">
      <button type="button" class="tss-search__close" aria-label="Close search" data-tss-close>
        {% render 'tss-icon', icon: 'x', size: 20, stroke: 1.5 %}
      </button>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search">
      <label for="tss-search-input-{{ uid }}" class="tss-sr-only">Search</label>
      <span class="tss-search__glass">
        {% render 'tss-icon', icon: 'search', size: 16, stroke: 1.5 %}
      </span>
      <input
        id="tss-search-input-{{ uid }}"
        type="search"
        name="q"
        placeholder="{{ s.search_placeholder | default: 'Search the house.' | escape }}"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      >
      <span class="tss-search__rule" aria-hidden="true"></span>
      <button type="button" class="tss-search__clear" aria-label="Clear search" data-tss-clear hidden>
        {% render 'tss-icon', icon: 'x', size: 14, stroke: 1.5 %}
      </button>
    </form>
  </div>

  <div class="tss-search__body">
    <div class="tss-search__inner">
      <div data-view="idle">
        {%- if s.search_suggestions != blank -%}
          <p class="tss-search__label">Suggested</p>
          <ul class="tss-search__list">
            {%- for term in search_terms -%}
              {%- assign term = term | strip -%}
              {%- if term != blank -%}
                <li>
                  <a class="tss-search__suggest" href="{{ routes.search_url }}?q={{ term | url_encode }}">
                    <span>{{ term | escape }}</span>
                    {% render 'tss-icon', icon: 'chevron-right', size: 16, stroke: 1.5 %}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.show_search_popular and popular.products_count > 0 -%}
          <p class="tss-search__label">Popular right now</p>
          <div class="tss-search__rail">
            {%- for product in popular.products limit: 8 -%}
              <a class="tss-search__card" href="{{ product.url }}">
                <div class="tss-search__card-media">
                  {%- if product.featured_image -%}
                    {{
                      product.featured_image
                      | image_url: width: 1200
                      | image_tag:
                        widths: '300,450,600,900,1200',
                        sizes: '(min-width: 64rem) 300px, 40vw',
                        loading: 'lazy',
                        alt: product.featured_image.alt | default: product.title
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                {%- if product.vendor != blank -%}
                  <p class="tss-search__vendor">{{ product.vendor | escape }}</p>
                {%- endif -%}
                <h3 class="tss-search__title">{{ product.title | escape }}</h3>
                <p class="tss-search__price">{{ product.price | money }}</p>
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div data-view="results" hidden aria-live="polite"></div>
    </div>
  </div>
</div>

<script>
  (function () {
    var header = document.getElementById('tss-header-{{ uid }}');
    if (!header || header.__tssBound) return;
    header.__tssBound = true;

    var drawer = document.getElementById('tss-drawer-{{ uid }}');
    var search = document.getElementById('tss-search-{{ uid }}');

    function open(el) {
      if (!el) return;
      el.setAttribute('data-open', 'true');
      document.documentElement.style.overflow = 'hidden';
      var field = el.querySelector('input[type="search"]');
      if (field) setTimeout(function () { field.focus(); }, 120);
    }

    function closeAll() {
      [drawer, search].forEach(function (el) {
        if (el) el.setAttribute('data-open', 'false');
      });
      document.documentElement.style.overflow = '';
    }

    header.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-tss-open]');
      if (!trigger) return;
      open(trigger.getAttribute('data-tss-open') === 'search' ? search : drawer);
    });

    [drawer, search].forEach(function (el) {
      if (!el) return;
      el.addEventListener('click', function (e) {
        if (e.target.closest('[data-tss-close]')) closeAll();
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAll();
    });

    {% raw %}
    // Live search — Shopify's predictive search JSON, debounced. An empty
    // field shows the suggested terms and popular rail again.
    if (search) {
      var field = search.querySelector('input[type="search"]');
      var clear = search.querySelector('[data-tss-clear]');
      var idle = search.querySelector('[data-view="idle"]');
      var results = search.querySelector('[data-view="results"]');
      var moneyFormat = search.getAttribute('data-money-format') || '{{ amount }}';
      var timer = null;
      var pending = null;

      function esc(str) {
        return String(str == null ? '' : str).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function money(value) {
        var n = parseFloat(value);
        if (isNaN(n)) return '';
        function group(num, decimals, thousands, point) {
          var parts = num.toFixed(decimals).split('.');
          parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands);
          return parts.join(point);
        }
        return moneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/, function (_, key) {
          if (key === 'amount_no_decimals') return group(n, 0, ',', '.');
          if (key === 'amount_with_comma_separator') return group(n, 2, '.', ',');
          if (key === 'amount_no_decimals_with_comma_separator') return group(n, 0, '.', ',');
          if (key === 'amount_with_apostrophe_separator') return group(n, 2, "'", '.');
          return group(n, 2, ',', '.');
        });
      }

      // Keeps the typed term full ink and dims the rest of the title.
      function highlight(title, q) {
        var i = title.toLowerCase().indexOf(q.toLowerCase());
        if (i < 0) return esc(title);
        return esc(title.slice(0, i)) + '<mark>' + esc(title.slice(i, i + q.length)) + '</mark>' + esc(title.slice(i + q.length));
      }

      function img(src, alt) {
        if (!src) return '';
        var sep = src.indexOf('?') > -1 ? '&' : '?';
        return '<img src="' + esc(src + sep + 'width=240') + '" alt="' + esc(alt) + '" loading="lazy" width="56" height="56">';
      }

      function row(item, q, withPrice) {
        var image = item.featured_image ? item.featured_image.url : item.image;
        return (
          '<a class="tss-search__row" href="' + esc(item.url) + '">' +
            '<div class="tss-search__thumb">' + img(image, item.title) + '</div>' +
            '<div class="tss-search__row-text">' +
              (item.vendor ? '<p class="tss-search__vendor">' + esc(item.vendor) + '</p>' : '') +
              '<h3 class="tss-search__title">' + highlight(item.title, q) + '</h3>' +
            '</div>' +
            (withPrice ? '<span class="tss-search__price">' + esc(money(item.price)) + '</span>' : '') +
          '</a>'
        );
      }

      function render(q, data) {
        var r = (data && data.resources && data.resources.results) || {};
        var products = r.products || [];
        var cols = r.collections || [];
        var html = '';
        if (products.length) {
          html += '<section><p class="tss-search__label">Products</p>';
          products.forEach(function (p) { html += row(p, q, true); });
          html += '</section>';
        }
        if (cols.length) {
          html += '<section><p class="tss-search__label">Collections</p>';
          cols.forEach(function (c) { html += row(c, q, false); });
          html += '</section>';
        }
        if (!html) {
          html = '<p class="tss-search__empty">Nothing in the house for “' + esc(q) + '” yet.</p>';
        } else {
          html +=
            '<a class="tss-search__all tss-link-gold" href="' +
            esc(search.getAttribute('data-search-url') + '?q=' + encodeURIComponent(q)) +
            '">View all results →</a>';
        }
        results.innerHTML = html;
      }

      function show(q) {
        var has = q.length > 0;
        clear.hidden = !has;
        idle.hidden = has;
        results.hidden = !has;
      }

      function run() {
        var q = field.value.trim();
        show(q);
        if (!q) return;
        if (pending) pending.abort();
        pending = new AbortController();
        var url =
          search.getAttribute('data-suggest-url') +
          '.json?q=' + encodeURIComponent(q) +
          '&resources[type]=product,collection' +
          '&resources[limit]=6' +
          '&resources[options][unavailable_products]=last';
        fetch(url, { signal: pending.signal })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (field.value.trim() === q) render(q, data);
          })
          .catch(function () {});
      }

      field.addEventListener('input', function () {
        clearTimeout(timer);
        if (!field.value.trim()) {
          show('');
          return;
        }
        timer = setTimeout(run, 180);
      });

      clear.addEventListener('click', function () {
        field.value = '';
        show('');
        field.focus();
      });
    }
    {% endraw %}

    // Hide on scroll down, reveal on scroll up
    var last = window.scrollY;
    var ticking = false;
    window.addEventListener(
      'scroll',
      function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          var y = window.scrollY;
          var down = y > last && y > 120;
          header.setAttribute('data-hidden', String(down));
          last = y;
          ticking = false;
        });
      },
      { passive: true }
    );

    // Rotating utility notices
    var stage = header.querySelector('[data-tss-notices]');
    if (stage) {
      var notices = stage.querySelectorAll('.tss-head__notice');
      if (notices.length > 1) {
        var i = 0;
        setInterval(function () {
          notices[i].classList.remove('is-active');
          i = (i + 1) % notices.length;
          notices[i].classList.add('is-active');
        }, parseInt(stage.getAttribute('data-interval'), 10) || 5000);
      }
    }
  })();
</script>

