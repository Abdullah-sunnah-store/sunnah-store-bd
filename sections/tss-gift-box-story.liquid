{% comment %}
  TSS — Gift box story
  The reading half of a gift box page, under TSS — Gift box, in the same
  centred column. Each block is one band split by hairlines; its heading is
  the eyebrow followed by the title in a lighter colour ("Kind words.
  Opened, and then kept."):

    review   · consecutive reviews share one heading and stack as quotes
    others   · a sideways row of products from a collection, e.g. other boxes
    faq      · consecutive questions share one heading, each a <details>
    contents · what is inside, numbered, one line each ("Name | note"); item
               images turn the list into a numbered photo grid
    colours  · up to three colours with a swatch and a short story
    dua      · an Arabic du'a card in Amiri with its translation
    delivery · label and value rows ("Label | value")
    bulk     · a call for bulk or corporate orders with an outline link

  @example
  <!-- templates/page.hafezi-gift-box.json, directly after the tss-gift-box section -->
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign has_dua = false
  for block in section.blocks
    if block.type == 'dua'
      assign has_dua = true
    endif
  endfor
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&display=swap">
{%- if has_dua -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap">
{%- endif -%}

<style>
  #tss-gbs-{{ uid }} {
    --gbs-page: #efe9e1;
    --gbs-bg: #faf7f2;
    --gbs-ink: #2b2320;
    --gbs-ink-2: #4a423c;
    --gbs-muted: #6f675f;
    --gbs-soft: #8a8178;
    --gbs-line: #e6dfd5;
    --gbs-green: #1b4332;
    --gbs-tint: #f2ece3;
    --gbs-gold: #c9a86a;
    --gbs-sans: 'Outfit', system-ui, -apple-system, sans-serif;
    --gbs-serif: 'Cormorant Garamond', Georgia, serif;
    --gbs-pad: 24px;

    background: var(--gbs-page);
    font-family: var(--gbs-sans);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--gbs-ink);
  }

  #tss-gbs-{{ uid }} .tss-gbs__inner {
    max-width: {{ s.column_width }}px;
    margin-inline: auto;
    padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;
    background: var(--gbs-bg);
  }

  #tss-gbs-{{ uid }} a {
    color: var(--gbs-green);
  }

  #tss-gbs-{{ uid }} a:hover {
    color: var(--gbs-ink);
  }

  #tss-gbs-{{ uid }} .tss-gbs__band {
    padding: 32px var(--gbs-pad);
    border-top: 1px solid var(--gbs-line);
  }

  #tss-gbs-{{ uid }} .tss-gbs__band:first-child {
    padding-top: 8px;
    border-top: 0;
  }

  #tss-gbs-{{ uid }} .tss-gbs__band--bleed {
    padding-inline: 0;
  }

  #tss-gbs-{{ uid }} .tss-gbs__band--bleed > .tss-gbs__head,
  #tss-gbs-{{ uid }} .tss-gbs__band--bleed > .tss-gbs__title {
    padding-inline: var(--gbs-pad);
  }

  #tss-gbs-{{ uid }} .tss-gbs__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  #tss-gbs-{{ uid }} .tss-gbs__head .tss-gbs__title {
    margin: 0;
  }

  #tss-gbs-{{ uid }} .tss-gbs__title {
    margin: 0 0 20px;
    font-family: var(--gbs-serif);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--gbs-ink);
    overflow-wrap: anywhere;
  }

  #tss-gbs-{{ uid }} .tss-gbs__title-note {
    color: var(--gbs-soft);
  }

  #tss-gbs-{{ uid }} .tss-gbs__more {
    flex: none;
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
  }

  #tss-gbs-{{ uid }} .tss-gbs__text {
    margin: -8px 0 20px;
    color: var(--gbs-ink-2);
  }

  /* ---------- lists ---------- */
  #tss-gbs-{{ uid }} .tss-gbs__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__row {
    display: flex;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--gbs-line);
  }

  #tss-gbs-{{ uid }} .tss-gbs__row:last-child {
    border-bottom: 1px solid var(--gbs-line);
  }

  #tss-gbs-{{ uid }} .tss-gbs__num {
    flex: none;
    width: 24px;
    font-size: 13px;
    color: var(--gbs-muted);
  }

  #tss-gbs-{{ uid }} .tss-gbs__row-body {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  #tss-gbs-{{ uid }} .tss-gbs__row-name {
    display: block;
    margin: 0;
    font-weight: 400;
  }

  #tss-gbs-{{ uid }} .tss-gbs__row-note {
    display: block;
    margin: 0;
    font-size: 13px;
    color: var(--gbs-muted);
  }

  /* ---------- contents with photos ---------- */
  #tss-gbs-{{ uid }} .tss-gbs__photo {
    margin-bottom: 20px;
    overflow: hidden;
    border-radius: 12px;
  }

  #tss-gbs-{{ uid }} .tss-gbs__photo img,
  #tss-gbs-{{ uid }} .tss-gbs__item-img {
    display: block;
    width: 100%;
    height: auto;
  }

  #tss-gbs-{{ uid }} .tss-gbs__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__item {
    min-width: 0;
  }

  #tss-gbs-{{ uid }} .tss-gbs__item-img,
  #tss-gbs-{{ uid }} .tss-gbs__item-blank {
    aspect-ratio: 1;
    border-radius: 10px;
    object-fit: cover;
  }

  #tss-gbs-{{ uid }} .tss-gbs__item-blank {
    display: block;
    background: var(--gbs-tint);
  }

  #tss-gbs-{{ uid }} .tss-gbs__item .tss-gbs__row-name {
    margin-top: 10px;
  }

  /* ---------- colours ---------- */
  #tss-gbs-{{ uid }} .tss-gbs__colours {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__colour-chip {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    background: var(--chip);
  }

  #tss-gbs-{{ uid }} .tss-gbs__colour-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #tss-gbs-{{ uid }} .tss-gbs__colour-name {
    margin: 12px 0 0;
    font-size: 15px;
    font-weight: 400;
  }

  #tss-gbs-{{ uid }} .tss-gbs__colour-text {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--gbs-muted);
  }

  /* ---------- du'a ---------- */
  #tss-gbs-{{ uid }} .tss-gbs__card {
    margin: 0;
    padding: 40px var(--gbs-pad);
    border-radius: 12px;
    background: #14110e;
    color: #ede6dc;
  }

  #tss-gbs-{{ uid }} .tss-gbs__arabic {
    margin: 0;
    font-family: 'Amiri', serif;
    font-size: 30px;
    line-height: 1.9;
    text-align: center;
    color: var(--gbs-gold);
  }

  #tss-gbs-{{ uid }} .tss-gbs__translation {
    margin: 24px 0 0;
    font-family: var(--gbs-serif);
    font-size: 20px;
    font-style: italic;
    line-height: 1.35;
  }

  #tss-gbs-{{ uid }} .tss-gbs__source {
    margin-top: 12px;
    font-size: 12px;
    color: #c4beb6;
  }

  /* ---------- reviews ---------- */
  #tss-gbs-{{ uid }} .tss-gbs__reviews {
    margin: -12px 0 0;
    padding: 0;
    list-style: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__review {
    margin: 0;
    padding: 20px 0;
    border-bottom: 1px solid var(--gbs-line);
  }

  #tss-gbs-{{ uid }} .tss-gbs__quote {
    margin: 0;
    font-family: var(--gbs-serif);
    font-size: 20px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  #tss-gbs-{{ uid }} .tss-gbs__who {
    margin-top: 8px;
    font-size: 13px;
    color: var(--gbs-muted);
  }

  /* ---------- other products ---------- */
  #tss-gbs-{{ uid }} .tss-gbs__rail {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0 var(--gbs-pad);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gbs-pad);
    scrollbar-width: none;
    list-style: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__rail::-webkit-scrollbar {
    display: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__rail:focus-visible {
    outline: 2px solid var(--gbs-green);
    outline-offset: -2px;
  }

  #tss-gbs-{{ uid }} .tss-gbs__product {
    flex: 0 0 62%;
    min-width: 0;
    scroll-snap-align: start;
  }

  #tss-gbs-{{ uid }} .tss-gbs__product a {
    display: block;
    color: var(--gbs-ink);
    text-decoration: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__product a:focus-visible {
    outline: 2px solid var(--gbs-green);
    outline-offset: 2px;
  }

  #tss-gbs-{{ uid }} .tss-gbs__product-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 10px;
    object-fit: cover;
    background: var(--gbs-tint);
  }

  #tss-gbs-{{ uid }} .tss-gbs__product-name {
    display: block;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  #tss-gbs-{{ uid }} .tss-gbs__product-price {
    display: block;
    font-size: 13px;
    color: var(--gbs-muted);
  }

  /* ---------- bulk ---------- */
  #tss-gbs-{{ uid }} .tss-gbs__panel {
    padding: 28px var(--gbs-pad);
    border-radius: 12px;
    background: var(--gbs-tint);
  }

  #tss-gbs-{{ uid }} .tss-gbs__outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border: 1px solid var(--gbs-green);
    border-radius: 12px;
    font-size: 15px;
    font-weight: 400;
    color: var(--gbs-green);
    text-decoration: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__outline:focus-visible {
    outline: 2px solid var(--gbs-green);
    outline-offset: 2px;
  }

  /* ---------- faq ---------- */
  #tss-gbs-{{ uid }} .tss-gbs__faq details {
    border-bottom: 1px solid var(--gbs-line);
  }

  #tss-gbs-{{ uid }} .tss-gbs__faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    padding: 16px 0;
    font-weight: 400;
    cursor: pointer;
    list-style: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__faq summary::-webkit-details-marker {
    display: none;
  }

  #tss-gbs-{{ uid }} .tss-gbs__faq summary::after {
    content: '+';
    flex: none;
    font-size: 18px;
    font-weight: 300;
    color: var(--gbs-soft);
    transition: transform 0.2s ease;
  }

  #tss-gbs-{{ uid }} .tss-gbs__faq details[open] summary::after {
    transform: rotate(45deg);
  }

  #tss-gbs-{{ uid }} .tss-gbs__faq summary:focus-visible {
    outline: 2px solid var(--gbs-green);
    outline-offset: 2px;
  }

  #tss-gbs-{{ uid }} .tss-gbs__answer {
    padding-bottom: 16px;
    color: var(--gbs-ink-2);
  }

  #tss-gbs-{{ uid }} .tss-gbs__answer p {
    margin: 0;
  }

  #tss-gbs-{{ uid }} .tss-gbs__answer p + p {
    margin-top: 10px;
  }

  #tss-gbs-{{ uid }} .tss-gbs__mark {
    margin: 0;
    padding: 24px var(--gbs-pad) 8px;
    font-family: var(--gbs-serif);
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.32em;
  }

  /* Desktop: full width, as wide as the gift box above it. */
  @media (min-width: 990px) {
    #tss-gbs-{{ uid }} {
      --gbs-pad: 0px;
      background: var(--gbs-bg);
    }

    /* Same measure as the TSS header and the gift box above. */
    #tss-gbs-{{ uid }} .tss-gbs__inner {
      max-width: calc(var(--tss-max) + 2 * var(--tss-gutter));
      padding-inline: var(--tss-gutter);
      background: transparent;
    }

    #tss-gbs-{{ uid }} .tss-gbs__band {
      padding-block: 56px;
    }

    #tss-gbs-{{ uid }} .tss-gbs__band:first-child {
      padding-top: 16px;
    }

    #tss-gbs-{{ uid }} .tss-gbs__title {
      margin-bottom: 28px;
      font-size: 36px;
    }

    #tss-gbs-{{ uid }} .tss-gbs__head {
      margin-bottom: 24px;
    }

    #tss-gbs-{{ uid }} .tss-gbs__reviews {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
      margin-top: 0;
    }

    #tss-gbs-{{ uid }} .tss-gbs__review {
      height: 100%;
      padding: 24px 0 0;
      border-top: 1px solid var(--gbs-line);
      border-bottom: 0;
    }

    #tss-gbs-{{ uid }} .tss-gbs__quote {
      font-size: 22px;
    }

    #tss-gbs-{{ uid }} .tss-gbs__rail {
      gap: 24px;
      scroll-padding-inline: 0;
    }

    #tss-gbs-{{ uid }} .tss-gbs__product {
      flex-basis: calc((100% - 72px) / 4);
    }

    #tss-gbs-{{ uid }} .tss-gbs__product a:hover .tss-gbs__product-name {
      text-decoration: underline;
    }

    /* Questions run the full width; the answer keeps a readable line length. */
    #tss-gbs-{{ uid }} .tss-gbs__answer {
      max-width: 72ch;
    }

    #tss-gbs-{{ uid }} .tss-gbs__faq summary {
      font-size: 17px;
    }

    #tss-gbs-{{ uid }} .tss-gbs__items {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 28px 20px;
    }

    #tss-gbs-{{ uid }} .tss-gbs__colours {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }

    #tss-gbs-{{ uid }} .tss-gbs__card,
    #tss-gbs-{{ uid }} .tss-gbs__panel {
      padding: 56px 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tss-gbs-{{ uid }} .tss-gbs__faq summary::after {
      transition: none;
    }
  }
</style>

{%- comment -%} Heading for a band: the eyebrow, then the title in a lighter colour. {%- endcomment -%}
<section id="tss-gbs-{{ uid }}" class="tss-section tss-gbs">
  <div class="tss-gbs__inner">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign prev_type = ''
        if forloop.index0 > 0
          assign prev_index = forloop.index0 | minus: 1
          assign prev_type = section.blocks[prev_index].type
        endif
        assign next_type = section.blocks[forloop.index].type

        assign head_main = b.eyebrow
        assign head_note = b.title
        if block.type == 'review'
          assign head_main = s.reviews_eyebrow
          assign head_note = s.reviews_title
        elsif block.type == 'faq'
          assign head_main = s.faq_eyebrow
          assign head_note = s.faq_title
        endif
        if head_main == blank
          assign head_main = head_note
          assign head_note = ''
        endif
      -%}
      {%- capture heading -%}
        {%- if head_main != blank -%}
          <h2 class="tss-gbs__title">
            {{- head_main | escape -}}
            {%- if head_note != blank %} <span class="tss-gbs__title-note">{{ head_note | escape }}</span>{% endif -%}
          </h2>
        {%- endif -%}
      {%- endcapture -%}

      {%- case block.type -%}
        {%- when 'contents' -%}
          {%- assign rows = b.rows | newline_to_br | split: '<br />' -%}
          <div
            class="tss-gbs__band"
            {% if b.anchor != blank %}
              id="{{ b.anchor | handleize }}"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {{ heading }}
            {%- if b.text != blank -%}<p class="tss-gbs__text">{{ b.text | escape }}</p>{%- endif -%}
            {%- if b.image != blank -%}
              <div class="tss-gbs__photo">
                {{-
                  b.image
                  | image_url: width: 1440
                  | image_tag:
                    loading: 'lazy',
                    widths: '480, 720, 960, 1440',
                    sizes: '(min-width: 720px) 480px, 100vw',
                    alt: b.image.alt
                -}}
              </div>
            {%- endif -%}
            {%- liquid
              assign has_item_images = false
              assign item_total = 0
              for row in rows
                assign parts = row | strip | split: '|'
                if parts[0] != blank
                  assign item_total = item_total | plus: 1
                  assign image_key = 'item_' | append: item_total | append: '_image'
                  if b[image_key] != blank
                    assign has_item_images = true
                  endif
                endif
              endfor
            -%}
            <ol class="{% if has_item_images %}tss-gbs__items{% else %}tss-gbs__list{% endif %}">
              {%- assign pin = 0 -%}
              {%- for row in rows -%}
                {%- assign parts = row | strip | split: '|' -%}
                {%- if parts[0] != blank -%}
                  {%- liquid
                    assign pin = pin | plus: 1
                    assign image_key = 'item_' | append: pin | append: '_image'
                    assign item_image = b[image_key]
                  -%}
                  {%- if has_item_images -%}
                    <li class="tss-gbs__item">
                      {%- if item_image != blank -%}
                        {{-
                          item_image
                          | image_url: width: 600
                          | image_tag:
                            class: 'tss-gbs__item-img',
                            loading: 'lazy',
                            widths: '240, 360, 480, 600',
                            sizes: '(min-width: 720px) 230px, 50vw',
                            alt: ''
                        -}}
                      {%- else -%}
                        <span class="tss-gbs__item-blank" aria-hidden="true"></span>
                      {%- endif -%}
                      <span class="tss-gbs__row-name">{{ parts[0] | strip | escape }}</span>
                      {%- if parts[1] != blank -%}
                        <span class="tss-gbs__row-note">{{ parts[1] | strip | escape }}</span>
                      {%- endif -%}
                    </li>
                  {%- else -%}
                    <li class="tss-gbs__row">
                      <span class="tss-gbs__num" aria-hidden="true">{% if pin < 10 %}0{% endif %}{{ pin }}</span>
                      <span class="tss-gbs__row-body">
                        <span class="tss-gbs__row-name">{{ parts[0] | strip | escape }}</span>
                        {%- if parts[1] != blank -%}
                          <span class="tss-gbs__row-note">{{ parts[1] | strip | escape }}</span>
                        {%- endif -%}
                      </span>
                    </li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ol>
          </div>

        {%- when 'delivery' -%}
          <div class="tss-gbs__band" {{ block.shopify_attributes }}>
            {{ heading }}
            {%- if b.text != blank -%}<p class="tss-gbs__text">{{ b.text | escape }}</p>{%- endif -%}
            {%- assign rows = b.rows | newline_to_br | split: '<br />' -%}
            <dl class="tss-gbs__list">
              {%- for row in rows -%}
                {%- assign parts = row | strip | split: '|' -%}
                {%- if parts[0] != blank -%}
                  <div class="tss-gbs__row">
                    <div class="tss-gbs__row-body">
                      <dt class="tss-gbs__row-name">{{ parts[0] | strip | escape }}</dt>
                      {%- if parts[1] != blank -%}
                        <dd class="tss-gbs__row-note">{{ parts[1] | strip | escape }}</dd>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </dl>
          </div>

        {%- when 'colours' -%}
          <div class="tss-gbs__band" {{ block.shopify_attributes }}>
            {{ heading }}
            {%- if b.text != blank -%}<p class="tss-gbs__text">{{ b.text | escape }}</p>{%- endif -%}
            <ul class="tss-gbs__colours">
              {%- for i in (1..3) -%}
                {%- liquid
                  assign name_key = 'colour_' | append: i | append: '_name'
                  assign hex_key = 'colour_' | append: i | append: '_hex'
                  assign text_key = 'colour_' | append: i | append: '_text'
                  assign image_key = 'colour_' | append: i | append: '_image'
                -%}
                {%- if b[name_key] != blank -%}
                  <li>
                    <div class="tss-gbs__colour-chip" style="--chip: {{ b[hex_key] }}">
                      {%- if b[image_key] != blank -%}
                        {{-
                          b[image_key]
                          | image_url: width: 1200
                          | image_tag:
                            class: 'tss-gbs__colour-img',
                            loading: 'lazy',
                            widths: '400, 600, 800, 1200',
                            sizes: '(min-width: 720px) 430px, 100vw',
                            alt: b[name_key]
                        -}}
                      {%- endif -%}
                    </div>
                    <h3 class="tss-gbs__colour-name">{{ b[name_key] | escape }}</h3>
                    {%- if b[text_key] != blank -%}
                      <p class="tss-gbs__colour-text">{{ b[text_key] | escape }}</p>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>

        {%- when 'dua' -%}
          <div class="tss-gbs__band" {{ block.shopify_attributes }}>
            {{ heading }}
            <figure class="tss-gbs__card">
              {%- if b.arabic != blank -%}
                <p class="tss-gbs__arabic" lang="ar" dir="rtl">{{ b.arabic | escape }}</p>
              {%- endif -%}
              {%- if b.translation != blank -%}
                <blockquote class="tss-gbs__translation">{{ b.translation | escape }}</blockquote>
              {%- endif -%}
              {%- if b.source != blank -%}
                <figcaption class="tss-gbs__source">{{ b.source | escape }}</figcaption>
              {%- endif -%}
            </figure>
          </div>

        {%- when 'review' -%}
          {%- if prev_type != 'review' -%}
            <div class="tss-gbs__band">
              {{ heading }}
              <ul class="tss-gbs__reviews">
          {%- endif -%}
          <li {{ block.shopify_attributes }}>
            <figure class="tss-gbs__review">
              <blockquote class="tss-gbs__quote">{{ b.quote | escape }}</blockquote>
              <figcaption class="tss-gbs__who">
                {{- b.name | escape -}}
                {%- if b.place != blank %} · {{ b.place | escape }}{% endif -%}
              </figcaption>
            </figure>
          </li>
          {%- if next_type != 'review' -%}
              </ul>
            </div>
          {%- endif -%}

        {%- when 'others' -%}
          {%- liquid
            # Picked products win; otherwise the collection's own.
            assign others = b.collection
            assign skip = b.exclude
            assign items = b.products
            if items == blank or items.size == 0
              assign items = others.products
            endif
            assign more_url = b.link | default: others.url
          -%}
          {%- if items != blank and items.size > 0 -%}
            <div class="tss-gbs__band tss-gbs__band--bleed" {{ block.shopify_attributes }}>
              <div class="tss-gbs__head">
                {%- assign heading_main = b.title | default: others.title -%}
                <h2 class="tss-gbs__title">{{ heading_main | escape }}</h2>
                {%- if b.link_label != blank and more_url != blank -%}
                  <a class="tss-gbs__more" href="{{ more_url }}">{{ b.link_label | escape }}</a>
                {%- endif -%}
              </div>
              <ul class="tss-gbs__rail" tabindex="0" role="region" aria-label="{{ heading_main | escape }}">
                {%- assign shown = 0 -%}
                {%- for product in items limit: 24 -%}
                  {%- liquid
                    if skip != blank and product.id == skip.id
                      continue
                    endif
                    if shown >= b.limit
                      break
                    endif
                    assign shown = shown | plus: 1
                  -%}
                  <li class="tss-gbs__product">
                    <a href="{{ product.url }}">
                      {%- if product.featured_image -%}
                        {{-
                          product.featured_image
                          | image_url: width: 720
                          | image_tag:
                            class: 'tss-gbs__product-img',
                            loading: 'lazy',
                            widths: '240, 360, 480, 720',
                            sizes: '(min-width: 720px) 280px, 62vw',
                            alt: ''
                        -}}
                      {%- else -%}
                        <span class="tss-gbs__product-img" aria-hidden="true"></span>
                      {%- endif -%}
                      <span class="tss-gbs__product-name">{{ product.title | escape }}</span>
                      <span class="tss-gbs__product-price">{{ product.price | money }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

        {%- when 'bulk' -%}
          <div class="tss-gbs__band" {{ block.shopify_attributes }}>
            <div class="tss-gbs__panel">
              {{ heading }}
              {%- if b.text != blank -%}<p class="tss-gbs__text">{{ b.text | escape }}</p>{%- endif -%}
              {%- if b.button_label != blank and b.button_link != blank -%}
                <a
                  class="tss-gbs__outline"
                  href="{{ b.button_link }}"
                  {% if b.button_link contains '://' %}
                    target="_blank" rel="noopener"
                  {% endif %}
                >
                  {{- b.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </div>

        {%- when 'faq' -%}
          {%- if prev_type != 'faq' -%}
            <div class="tss-gbs__band">
              {{ heading }}
              <div class="tss-gbs__faq">
          {%- endif -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ b.question | escape }}</summary>
            <div class="tss-gbs__answer">{{ b.answer }}</div>
          </details>
          {%- if next_type != 'faq' -%}
              </div>
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}

    {%- if s.footer_mark != blank -%}
      <p class="tss-gbs__mark">{{ s.footer_mark | escape }}</p>
    {%- endif -%}
  </div>
</section>

