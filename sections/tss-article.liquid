{% comment %}
  TSS — Journal article
  The reading page for a blog post: eyebrow, serif title, standfirst, a capped
  featured image and the article body set in a single reading column.

  The body is merchant rich text, so every element inside it is styled by tag
  from .tss-article__body rather than by class.
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id

  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_minutes = word_count | divided_by: 200 | at_least: 1

  case s.image_ratio
    when 'portrait'
      assign image_ratio = '4 / 5'
    when 'square'
      assign image_ratio = '1 / 1'
    when 'landscape'
      assign image_ratio = '3 / 2'
    when 'wide'
      assign image_ratio = '16 / 9'
    else
      assign image_ratio = article.image.aspect_ratio | default: 1.5
  endcase
-%}

<style>
  #tss-article-{{ uid }} {
    --tss-article-measure: {{ s.content_width | default: 680 }}px;

    background: var(--tss-ivory);
    padding-block: {{ s.mobile_padding_top | default: 48 }}px {{ s.mobile_padding_bottom | default: 40 }}px;
  }

  #tss-article-{{ uid }} .tss-article__col {
    max-width: calc(var(--tss-article-measure) + (2 * var(--tss-gutter)));
    margin-inline: auto;
    padding-inline: var(--tss-gutter);
  }

  #tss-article-{{ uid }} .tss-article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  #tss-article-{{ uid }} .tss-article__meta a {
    text-decoration: none;
  }

  #tss-article-{{ uid }} .tss-article__meta a:hover {
    color: var(--tss-green-mid);
  }

  #tss-article-{{ uid }} .tss-article__title {
    margin-top: 16px;
    max-width: 20ch;
    font-family: var(--tss-serif);
    font-size: {{ s.title_size_mobile | default: 40 }}px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: normal;
    text-transform: none;
    text-wrap: balance;
    color: var(--tss-ink);
  }

  #tss-article-{{ uid }} .tss-article__lede {
    margin-top: 20px;
    font-family: var(--tss-serif);
    font-size: 19px;
    font-style: italic;
    line-height: 1.6;
    text-wrap: pretty;
    color: rgb(28 28 26 / 0.75);
  }

  #tss-article-{{ uid }} .tss-article__rule {
    margin: 32px 0 0;
    border: 0;
    border-top: 1px solid rgb(8 41 30 / 0.12);
  }

  /* Featured image: full bleed on phones, capped and centred from tablet up so
     a portrait upload can no longer fill the whole screen. */
  #tss-article-{{ uid }} .tss-article__hero {
    margin: 32px auto 0;
    max-width: {{ s.image_width | default: 960 }}px;
    background: var(--tss-ivory-2);
  }

  #tss-article-{{ uid }} .tss-article__hero img {
    width: 100%;
    height: auto;
    aspect-ratio: {{ image_ratio }};
    object-fit: cover;
  }

  /* ---------- body ---------- */
  #tss-article-{{ uid }} .tss-article__body {
    margin-top: 32px;
    min-width: 0;
    font-family: var(--tss-serif);
    font-size: {{ s.body_size_mobile | default: 19 }}px;
    line-height: 1.75;
    overflow-wrap: break-word;
    color: var(--tss-ink);
  }

  #tss-article-{{ uid }} .tss-article__body > :first-child {
    margin-top: 0;
  }

  #tss-article-{{ uid }} .tss-article__body p,
  #tss-article-{{ uid }} .tss-article__body ul,
  #tss-article-{{ uid }} .tss-article__body ol,
  #tss-article-{{ uid }} .tss-article__body table {
    margin-top: 22px;
    text-wrap: pretty;
  }

  #tss-article-{{ uid }} .tss-article__body h2,
  #tss-article-{{ uid }} .tss-article__body h3,
  #tss-article-{{ uid }} .tss-article__body h4,
  #tss-article-{{ uid }} .tss-article__body h5,
  #tss-article-{{ uid }} .tss-article__body h6 {
    margin: 48px 0 0;
    padding: 0;
    font-family: var(--tss-serif);
    font-size: {{ s.heading_size_mobile | default: 26 }}px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: normal;
    text-transform: none;
    text-wrap: balance;
    color: var(--tss-ink);
  }

  #tss-article-{{ uid }} .tss-article__body h2 + p,
  #tss-article-{{ uid }} .tss-article__body h3 + p,
  #tss-article-{{ uid }} .tss-article__body h4 + p {
    margin-top: 16px;
  }

  #tss-article-{{ uid }} .tss-article__body h3 {
    font-size: calc({{ s.heading_size_mobile | default: 26 }}px * 0.85);
    font-weight: 500;
  }

  #tss-article-{{ uid }} .tss-article__body h4,
  #tss-article-{{ uid }} .tss-article__body h5,
  #tss-article-{{ uid }} .tss-article__body h6 {
    font-size: 1em;
    font-weight: 600;
  }

  #tss-article-{{ uid }} .tss-article__body a {
    color: var(--tss-ink);
    text-decoration: underline;
    text-decoration-color: var(--tss-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.4s ease;
  }

  #tss-article-{{ uid }} .tss-article__body a:hover {
    color: var(--tss-green-mid);
  }

  /* .tss-section strips list markers; an article needs them back. */
  #tss-article-{{ uid }} .tss-article__body ul,
  #tss-article-{{ uid }} .tss-article__body ol {
    padding-inline-start: 1.2em;
  }

  #tss-article-{{ uid }} .tss-article__body ul {
    list-style: disc;
  }

  #tss-article-{{ uid }} .tss-article__body ol {
    list-style: decimal;
  }

  #tss-article-{{ uid }} .tss-article__body li + li {
    margin-top: 8px;
  }

  #tss-article-{{ uid }} .tss-article__body li::marker {
    color: var(--tss-gold);
  }

  #tss-article-{{ uid }} .tss-article__body blockquote {
    margin: 40px auto;
    max-width: 24ch;
    font-size: 26px;
    font-style: italic;
    line-height: 1.3;
    text-align: center;
    text-wrap: pretty;
  }

  #tss-article-{{ uid }} .tss-article__body blockquote::before {
    content: '';
    display: block;
    width: 40px;
    height: 1px;
    margin: 0 auto 24px;
    background: var(--tss-gold);
  }

  #tss-article-{{ uid }} .tss-article__body blockquote p {
    margin-top: 12px;
  }

  #tss-article-{{ uid }} .tss-article__body img,
  #tss-article-{{ uid }} .tss-article__body video,
  #tss-article-{{ uid }} .tss-article__body iframe {
    display: block;
    max-width: 100%;
    margin: 32px auto;
  }

  #tss-article-{{ uid }} .tss-article__body img,
  #tss-article-{{ uid }} .tss-article__body video {
    height: auto;
  }

  #tss-article-{{ uid }} .tss-article__body p > img:only-child {
    margin-block: 10px;
  }

  #tss-article-{{ uid }} .tss-article__body figure {
    margin-top: 32px;
  }

  #tss-article-{{ uid }} .tss-article__body figcaption {
    margin-top: 10px;
    font-family: var(--tss-sans);
    font-size: 12px;
    line-height: 1.5;
    color: rgb(28 28 26 / 0.55);
  }

  #tss-article-{{ uid }} .tss-article__body hr {
    margin: 48px 0;
    border: 0;
    border-top: 1px solid rgb(8 41 30 / 0.12);
  }

  #tss-article-{{ uid }} .tss-article__body table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: var(--tss-sans);
    font-size: 14px;
  }

  #tss-article-{{ uid }} .tss-article__body th,
  #tss-article-{{ uid }} .tss-article__body td {
    border-bottom: 1px solid rgb(8 41 30 / 0.12);
    padding: 10px 12px;
    text-align: start;
  }

  /* ---------- sign-off, tags, back link ---------- */
  #tss-article-{{ uid }} .tss-article__author {
    margin-top: 40px;
    font-family: var(--tss-serif);
    font-size: 22px;
    font-style: italic;
    line-height: 1.2;
    color: var(--tss-green-mid);
  }

  #tss-article-{{ uid }} .tss-article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
  }

  #tss-article-{{ uid }} .tss-article__tags a {
    border: 1px solid rgb(8 41 30 / 0.18);
    border-radius: 2px;
    padding: 6px 12px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    color: rgb(28 28 26 / 0.7);
    transition: border-color 0.4s ease, color 0.4s ease;
  }

  #tss-article-{{ uid }} .tss-article__tags a:hover {
    border-color: var(--tss-green-mid);
    color: var(--tss-green-mid);
  }

  #tss-article-{{ uid }} .tss-article__back {
    margin-top: 40px;
  }

  #tss-article-{{ uid }} .tss-article__apps:not(:empty) {
    margin-top: 40px;
  }

  /* ---------- comments ---------- */
  #tss-article-{{ uid }} .tss-article__comments {
    margin-top: 56px;
    border-top: 1px solid rgb(8 41 30 / 0.12);
    padding-top: 40px;
  }

  #tss-article-{{ uid }} .tss-article__comments h2 {
    font-family: var(--tss-serif);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: normal;
    text-transform: none;
  }

  #tss-article-{{ uid }} .tss-article__comment-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-block: 24px 40px;
  }

  #tss-article-{{ uid }} .tss-article__comment {
    font-size: 15px;
    line-height: 1.65;
  }

  #tss-article-{{ uid }} .tss-article__comment-by {
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(28 28 26 / 0.55);
  }

  #tss-article-{{ uid }} .tss-article__pagination {
    display: flex;
    justify-content: center;
    gap: 12px;
    font-size: 14px;
  }

  @media screen and (min-width: 40rem) {
    #tss-article-{{ uid }} .tss-article__hero {
      max-width: calc({{ s.image_width | default: 960 }}px + (2 * var(--tss-gutter)));
      padding-inline: var(--tss-gutter);
      background: transparent;
    }
  }

  @media screen and (min-width: 64rem) {
    #tss-article-{{ uid }} {
      padding-block: {{ s.padding_top | default: 72 }}px {{ s.padding_bottom | default: 64 }}px;
    }

    #tss-article-{{ uid }} .tss-article__title {
      margin-top: 20px;
      font-size: {{ s.title_size | default: 56 }}px;
    }

    #tss-article-{{ uid }} .tss-article__lede {
      margin-top: 24px;
      font-size: 22px;
    }

    #tss-article-{{ uid }} .tss-article__rule {
      margin-top: 40px;
    }

    #tss-article-{{ uid }} .tss-article__hero,
    #tss-article-{{ uid }} .tss-article__body {
      margin-top: 40px;
    }

    #tss-article-{{ uid }} .tss-article__body {
      font-size: {{ s.body_size | default: 20 }}px;
    }

    #tss-article-{{ uid }} .tss-article__body h2,
    #tss-article-{{ uid }} .tss-article__body h3 {
      margin-top: 56px;
    }

    #tss-article-{{ uid }} .tss-article__body h2 {
      font-size: {{ s.heading_size | default: 32 }}px;
    }

    #tss-article-{{ uid }} .tss-article__body h3 {
      font-size: calc({{ s.heading_size | default: 32 }}px * 0.8);
    }

    #tss-article-{{ uid }} .tss-article__body blockquote {
      margin-block: 56px;
      font-size: 30px;
    }
  }
</style>

<article id="tss-article-{{ uid }}" class="tss-section" aria-labelledby="tss-article-title-{{ uid }}">
  <header class="tss-article__col">
    <p class="tss-eyebrow tss-article__meta">
      {%- if s.show_blog and blog.title != blank -%}
        <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
      {%- endif -%}
      {%- if s.show_date -%}
        {%- if s.show_blog and blog.title != blank -%}
          <span aria-hidden="true">·</span>
        {%- endif -%}
        <span>{{ article.published_at | time_tag: format: 'date' }}</span>
      {%- endif -%}
      {%- if s.show_read_time -%}
        {%- if s.show_date or s.show_blog -%}
          <span aria-hidden="true">·</span>
        {%- endif -%}
        <span>{{ read_minutes }} {{ s.read_time_label | default: 'min' | escape }}</span>
      {%- endif -%}
    </p>

    <h1 class="tss-article__title" id="tss-article-title-{{ uid }}">{{ article.title | escape }}</h1>

    {%- if s.show_excerpt and article.excerpt != blank -%}
      <p class="tss-article__lede">{{ article.excerpt | strip_html | strip }}</p>
    {%- endif -%}

    {%- unless s.show_image and article.image -%}
      <hr class="tss-article__rule">
    {%- endunless -%}
  </header>

  {%- if s.show_image and article.image -%}
    <div class="tss-article__hero">
      {% render 'tss-image',
        image: article.image,
        class: 'tss-article__hero-img',
        widths: '480,640,800,960',
        sizes: '(min-width: 64rem) 960px, 100vw',
        alt: article.title,
        loading: 'eager',
        priority: true
      %}
    </div>
  {%- endif -%}

  <div class="tss-article__col">
    <div class="tss-article__body">
      {{ article.content }}
    </div>

    {%- if s.show_author and article.author != blank -%}
      <p class="tss-article__author">{{ article.author | escape }}</p>
    {%- endif -%}

    {%- if s.show_tags and article.tags.size > 0 -%}
      <ul class="tss-article__tags">
        {%- for tag in article.tags -%}
          <li>
            <a href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.back_label != blank -%}
      <p class="tss-article__back">
        <a href="{{ blog.url }}" class="tss-link-gold">{{ s.back_label | escape }}</a>
      </p>
    {%- endif -%}

    <div class="tss-article__apps">{% content_for 'blocks' %}</div>

    {%- if blog.comments_enabled? -%}
      <div class="tss-article__comments">
        <h2>{{ 'blogs.article.comments_heading' | t: count: article.comments_count }}</h2>

        {%- paginate article.comments by 10 -%}
          <div class="tss-article__comment-list">
            {%- for comment in article.comments -%}
              <div class="tss-article__comment">
                {{ comment.content }}
                <p class="tss-article__comment-by">
                  {{ comment.author | escape }}
                  {{ 'blogs.article.comment_author_separator' | t }}
                  {{ comment.created_at | time_tag: format: 'date' }}
                </p>
              </div>
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="tss-article__pagination">{{ paginate | default_pagination }}</div>
          {%- endif -%}
        {%- endpaginate -%}

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {%- endif -%}
  </div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "TSS · Article",
  "tag": "section",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_blog", "label": "Show blog name", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_read_time", "label": "Show reading time", "default": true },
    { "type": "text", "id": "read_time_label", "label": "Reading time label", "default": "min read" },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt under the title",
      "default": true
    },
    { "type": "header", "content": "Featured image" },
    { "type": "checkbox", "id": "show_image", "label": "Show featured image", "default": true },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "adapt", "label": "Original" },
        { "value": "portrait", "label": "Portrait 4:5" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape 3:2" },
        { "value": "wide", "label": "Wide 16:9" }
      ],
      "default": "landscape"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image max width (desktop)",
      "min": 600,
      "max": 1280,
      "step": 40,
      "unit": "px",
      "default": 960
    },
    { "type": "header", "content": "Text" },
    {
      "type": "range",
      "id": "content_width",
      "label": "Reading column width",
      "min": 520,
      "max": 880,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size (desktop)",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size (mobile)",
      "min": 26,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size (desktop)",
      "min": 15,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body text size (mobile)",
      "min": 15,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Body heading size (desktop)",
      "min": 22,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Body heading size (mobile)",
      "min": 20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    { "type": "header", "content": "Footer" },
    { "type": "checkbox", "id": "show_author", "label": "Show author sign-off", "default": false },
    { "type": "checkbox", "id": "show_tags", "label": "Show tags", "default": false },
    { "type": "text", "id": "back_label", "label": "Back link label", "info": "Leave empty to hide." },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
