{% comment %}
  TSS 03 — Discovered This Month
  Snap-scrolling rail of maker cards: 3:4 clip-revealed portrait, serif name,
  light description and a gold "Discover" link. Gold progress bar beneath.
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<style>
  #tss-makers-{{ uid }} {
    background: var(--tss-ivory);
    padding-block: {{ s.padding_top | default: 80 }}px {{ s.padding_bottom | default: 80 }}px;
  }

  /* Mobile block padding, on the same 768px breakpoint the Sunnah Collection
     Cards section uses, so the three sections share one rhythm on phones. */
  @media screen and (max-width: 768px) {
    #tss-makers-{{ uid }} {
      padding-block: {{ s.mobile_padding_top | default: 40 }}px {{ s.mobile_padding_bottom | default: 40 }}px;
    }
  }

  #tss-makers-{{ uid }} .tss-makers__rail-wrap {
    margin-top: 48px;
  }

  /* Below the desktop breakpoint the rail runs full width and the opening
     gutter comes from a margin on the first card. Padding on a flex scroll
     container is not honoured, which is what left the cards flush against the
     screen edge; a flex item's own margin always is. Only the start edge is
     inset, so the next card still bleeds off the right as it should.
     Desktop is untouched — there .tss-rail centres itself at --tss-max. */
  @media screen and (max-width: 63.999rem) {
    #tss-makers-{{ uid }} .tss-rail {
      padding-inline: 0;
      scroll-padding-inline-start: var(--tss-gutter);
    }

    #tss-makers-{{ uid }} .tss-rail > :first-child {
      margin-inline-start: var(--tss-gutter);
    }

    #tss-makers-{{ uid }} .tss-progress {
      margin-inline: var(--tss-gutter);
    }
  }

  #tss-makers-{{ uid }} .tss-makers__name {
    margin-top: 20px;
    font-family: var(--tss-serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--tss-ink);
  }

  #tss-makers-{{ uid }} .tss-makers__desc {
    margin-top: 8px;
    max-width: 34ch;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.65;
    color: rgb(28 28 26 / 0.7);
  }

  #tss-makers-{{ uid }} .tss-makers__link {
    margin-top: 16px;
  }
</style>

<section
  id="tss-makers-{{ uid }}"
  class="tss-section"
  aria-labelledby="tss-makers-heading-{{ uid }}"
>
  <div id="tss-makers-heading-{{ uid }}">
    {% render 'tss-head', eyebrow: s.eyebrow, title: s.title, lede: s.lede %}
  </div>

  <div class="tss-makers__rail-wrap">
    <div
      class="tss-rail"
      role="region"
      tabindex="0"
      aria-label="{{ s.rail_label | default: 'Makers we discovered this month' | escape }}"
      data-progress="tss-makers-progress-{{ uid }}"
    >
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article {{ block.shopify_attributes }}>
          <div class="tss-clip">
            <div>
              {% render 'tss-image',
                image: b.image,
                asset: b.image_asset,
                sizes: '(min-width: 64rem) 24vw, (min-width: 40rem) 46vw, 78vw',
                alt: b.name
              %}
            </div>
          </div>

          <div class="tss-rise">
            {%- if b.name != blank -%}
              <h3 class="tss-makers__name">{{ b.name | escape }}</h3>
            {%- endif -%}
            {%- if b.description != blank -%}
              <p class="tss-makers__desc">{{ b.description | escape }}</p>
            {%- endif -%}
            {%- if b.link_label != blank -%}
              <div class="tss-makers__link">
                <a href="{{ b.link | default: '#' }}" class="tss-link-gold">{{ b.link_label | escape }}</a>
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="tss-progress" id="tss-makers-progress-{{ uid }}" aria-hidden="true">
      <span></span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TSS 03 · Makers",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Discovered This Month" },
    {
      "type": "textarea",
      "id": "title",
      "label": "Headline",
      "info": "Each line reveals separately.",
      "default": "Brands we found\nthis month"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "Every maker in our house is met, visited and chosen by hand — a small few each month, for the care they refuse to hurry. We photograph and fulfil each one ourselves."
    },
    { "type": "text", "id": "rail_label", "label": "Carousel label", "default": "Makers we discovered this month" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "maker",
      "name": "Maker",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (portrait)" },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback theme asset",
          "info": "Filename in assets/. Used when no image is picked above."
        },
        { "type": "text", "id": "name", "label": "Maker name", "default": "Amina Atelier" },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Hand-poured attar in blown glass — chosen for a patience most houses have forgotten."
        },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover →" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TSS 03 · Makers",
      "blocks": [
        { "type": "maker" },
        { "type": "maker" },
        { "type": "maker" },
        { "type": "maker" }
      ]
    }
  ]
}
{% endschema %}
