{% comment %}
  TSS — Kiswah Edition (landing page + frame chooser)
  Built after the "Kiswah Edition" desktop and mobile design references.
  Sections, top to bottom: hero gallery with a dark panel; the craft; five frames,
  five rooms; the Complete Edition; the chooser (frames, "ready to give",
  add-ons, perks and summary); see them on your wall first (WhatsApp); FAQ.

  Blocks
  - slide: a hero photo with its caption.
  - frame: a Kiswah product with its short name, meaning, size and the room it
    belongs in (room photo, label and line). Frames appear in block order.
  - addon: an optional product ("Complete the prayer corner").
  - faq: a question and its answer.

  Perks are shown in a box and carried on the order as line properties; the
  free hanging needs the matching automatic discount in Shopify (buy N frames
  from the collection, get the hanging service free).
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign hanging = s.hanging_product
  assign hang_free_at = s.hang_free_at | default: 0
  assign plaque_at = s.plaque_at | default: 0

  assign frame_count = 0
  assign from_price = 0
  assign all_price = 0
  for block in section.blocks
    if block.type == 'frame' and block.settings.product != blank
      assign v = block.settings.product.selected_or_first_available_variant
      assign frame_count = frame_count | plus: 1
      assign all_price = all_price | plus: v.price
      if from_price == 0 or v.price < from_price
        assign from_price = v.price
      endif
    endif
  endfor

  for block in section.blocks
    case block.type
      when 'craft'
        assign cb = block
      when 'rooms'
        assign rb = block
      when 'complete'
        assign xb = block
      when 'viewing'
        assign vb = block
    endcase
  endfor

  assign from_money = from_price | money_without_trailing_zeros
  assign wa_number = vb.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign wa_text = vb.settings.whatsapp_message | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500&display=swap"
>

<style>
  #kw-{{ uid }} {
    --kw-bg: #f7f3ea;
    --kw-ink: #1c2420;
    --kw-green: #0f2a1f;
    --kw-green-mid: #1e4a37;
    --kw-gold: #d9c9a3;
    --kw-card: #fffdf8;
    --kw-line: #e4dccb;
    --kw-line-2: #d8cfbd;
    --kw-muted: #5e6660;
    --kw-text-2: #3f4741;
    --kw-text-3: #4a524c;
    --kw-panel: #efe8da;
    --kw-img: #f3eee4;
    --kw-serif: 'Cormorant Garamond', Georgia, serif;
    --kw-sans: 'Jost', system-ui, sans-serif;
    background: var(--kw-bg);
    color: var(--kw-ink);
    font-family: var(--kw-sans);
    font-size: 15px;
    line-height: 1.5;
  }

  #kw-{{ uid }} *,
  #kw-{{ uid }} *::before,
  #kw-{{ uid }} *::after {
    box-sizing: border-box;
  }

  #kw-{{ uid }} img {
    display: block;
    max-width: 100%;
  }

  #kw-{{ uid }} a {
    color: var(--kw-green-mid);
  }

  #kw-{{ uid }} button,
  #kw-{{ uid }} input,
  #kw-{{ uid }} textarea {
    font-family: inherit;
  }

  #kw-{{ uid }} .kw-serif {
    font-family: var(--kw-serif);
    font-weight: 500;
  }

  #kw-{{ uid }} .kw-eyebrow {
    display: block;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--kw-muted);
  }

  #kw-{{ uid }} .kw-h2 {
    margin: 0;
    font-family: var(--kw-serif);
    font-weight: 500;
    font-size: 48px;
    line-height: 1.05;
  }

  #kw-{{ uid }} .kw-wrap {
    max-width: 1240px;
    margin: 96px auto 0;
    padding: 0 48px;
  }

  #kw-{{ uid }} .kw-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 32px;
    border: 0;
    border-radius: 2px;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, opacity 0.2s;
  }

  #kw-{{ uid }} .kw-btn--light {
    background: var(--kw-bg);
    color: var(--kw-green);
  }

  #kw-{{ uid }} .kw-btn--light:hover {
    background: #ffffff;
  }

  #kw-{{ uid }} .kw-btn--dark {
    background: var(--kw-green-mid);
    color: var(--kw-bg);
  }

  #kw-{{ uid }} .kw-btn--dark:hover {
    background: var(--kw-green);
  }

  #kw-{{ uid }} .kw-btn--line {
    border: 1px solid var(--kw-ink);
    background: transparent;
    color: var(--kw-ink);
  }

  #kw-{{ uid }} .kw-btn--line:hover {
    background: var(--kw-ink);
    color: var(--kw-bg);
  }

  #kw-{{ uid }} .kw-only-mob {
    display: none;
  }

  /* ---------- hero ---------- */
  #kw-{{ uid }} .kw-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    min-height: 640px;
  }

  #kw-{{ uid }} .kw-stage {
    position: relative;
    min-height: 640px;
    overflow: hidden;
    background: var(--kw-img);
    touch-action: pan-y;
  }

  #kw-{{ uid }} .kw-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  #kw-{{ uid }} .kw-slide[data-active] {
    opacity: 1;
  }

  #kw-{{ uid }} .kw-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #kw-{{ uid }} .kw-stage-foot {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    pointer-events: none;
  }

  #kw-{{ uid }} .kw-caption,
  #kw-{{ uid }} .kw-count {
    padding: 7px 12px;
    border-radius: 2px;
    background: rgb(15 42 31 / 0.82);
    color: var(--kw-bg);
    font-size: 13px;
    white-space: nowrap;
  }

  #kw-{{ uid }} .kw-thumbs {
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }

  #kw-{{ uid }} .kw-thumb {
    flex: none;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--kw-img);
    opacity: 0.7;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  #kw-{{ uid }} .kw-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
  }

  #kw-{{ uid }} .kw-thumb:hover {
    opacity: 1;
  }

  #kw-{{ uid }} .kw-thumb[aria-current='true'] {
    opacity: 1;
    outline: 2px solid var(--kw-gold);
    outline-offset: 2px;
  }

  #kw-{{ uid }} .kw-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(247 243 234 / 0.9);
    color: var(--kw-ink);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  #kw-{{ uid }} .kw-arrow:hover {
    background: var(--kw-green);
    color: var(--kw-bg);
  }

  #kw-{{ uid }} .kw-arrow--prev {
    left: 16px;
  }

  #kw-{{ uid }} .kw-arrow--next {
    right: 16px;
  }

  #kw-{{ uid }} .kw-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 80px 72px;
    background: var(--kw-green);
    color: var(--kw-bg);
  }

  #kw-{{ uid }} .kw-panel .kw-eyebrow {
    letter-spacing: 0.18em;
    color: var(--kw-gold);
  }

  #kw-{{ uid }} .kw-h1 {
    margin: 0;
    font-family: var(--kw-serif);
    font-weight: 500;
    font-size: 64px;
    line-height: 1;
  }

  #kw-{{ uid }} .kw-from {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 12px;
  }

  #kw-{{ uid }} .kw-from-price {
    font-family: var(--kw-serif);
    font-size: 36px;
    font-weight: 600;
  }

  #kw-{{ uid }} .kw-from-note {
    font-size: 15px;
    color: #c9d2cc;
  }

  #kw-{{ uid }} .kw-hero-ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 4px;
  }

  #kw-{{ uid }} .kw-hero-ctas .kw-btn {
    min-height: 56px;
    padding: 0 36px;
    white-space: nowrap;
  }

  #kw-{{ uid }} .kw-panel a.kw-link {
    color: var(--kw-bg);
    font-size: 15px;
    white-space: nowrap;
  }

  /* ---------- craft ---------- */
  #kw-{{ uid }} .kw-craft {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  #kw-{{ uid }} .kw-craft-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }

  #kw-{{ uid }} .kw-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #kw-{{ uid }} .kw-body {
    margin: 0;
    color: var(--kw-text-2);
    font-size: 17px;
  }

  #kw-{{ uid }} .kw-body p {
    margin: 0;
  }

  #kw-{{ uid }} .kw-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 8px;
  }

  #kw-{{ uid }} .kw-fact {
    padding-top: 12px;
    border-top: 1px solid var(--kw-line-2);
  }

  #kw-{{ uid }} .kw-fact-t {
    display: block;
    font-family: var(--kw-serif);
    font-size: 24px;
    line-height: 1.15;
  }

  #kw-{{ uid }} .kw-fact-s {
    font-size: 14px;
    color: var(--kw-muted);
  }

  /* ---------- rooms ---------- */
  #kw-{{ uid }} .kw-rooms {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  #kw-{{ uid }} .kw-room {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  #kw-{{ uid }} .kw-room img,
  #kw-{{ uid }} .kw-room .kw-ph {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
    background: var(--kw-img);
  }

  #kw-{{ uid }} .kw-room-label {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--kw-muted);
  }

  #kw-{{ uid }} .kw-room-name {
    font-family: var(--kw-serif);
    font-size: 22px;
    line-height: 1.1;
  }

  #kw-{{ uid }} .kw-room-line {
    font-size: 13px;
    color: var(--kw-text-3);
  }

  /* ---------- complete edition ---------- */
  #kw-{{ uid }} .kw-complete {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding: 40px 44px;
    border-radius: 3px;
    border: 1px solid var(--kw-gold);
    background: var(--kw-bg);
    color: var(--kw-ink);
  }

  #kw-{{ uid }} .kw-complete-imgs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  #kw-{{ uid }} .kw-complete-imgs img,
  #kw-{{ uid }} .kw-complete-imgs .kw-ph {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    border: 1px solid var(--kw-line);
    border-radius: 3px;
    background: var(--kw-img);
  }

  /* blend the product photo's own off-white backdrop into the section background */
  #kw-{{ uid }} .kw-complete-imgs img {
    background: transparent;
    filter: brightness(1.1);
    mix-blend-mode: multiply;
    /* pre-compensated so that after the filter + multiply it renders as --kw-line, matching the frame cards */
    border-color: #d6d2c9;
  }

  #kw-{{ uid }} .kw-complete .kw-eyebrow {
    color: #9a7b3c;
  }

  #kw-{{ uid }} .kw-complete h2 {
    margin: 0;
    font-family: var(--kw-serif);
    font-weight: 500;
    font-size: 42px;
    line-height: 1.05;
    color: var(--kw-green);
  }

  #kw-{{ uid }} .kw-complete p {
    margin: 0;
    color: var(--kw-text-2);
  }

  #kw-{{ uid }} .kw-complete-price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  #kw-{{ uid }} .kw-complete-price span:first-child {
    font-family: var(--kw-serif);
    font-size: 34px;
    font-weight: 600;
  }

  #kw-{{ uid }} .kw-complete-price span:last-child {
    font-size: 13px;
    color: #9a7b3c;
  }

  #kw-{{ uid }} .kw-complete .kw-btn {
    max-width: 260px;
    width: 100%;
  }

  /* ---------- chooser ---------- */
  #kw-{{ uid }} .kw-chooser {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 40px;
    align-items: start;
    scroll-margin-top: 24px;
  }

  #kw-{{ uid }} .kw-main {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  #kw-{{ uid }} .kw-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  #kw-{{ uid }} .kw-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--kw-line);
    border-radius: 3px;
    background: var(--kw-card);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  #kw-{{ uid }} .kw-card[data-selected] {
    border-color: var(--kw-green-mid);
    box-shadow: inset 0 0 0 1px var(--kw-green-mid);
  }

  #kw-{{ uid }} .kw-card-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: var(--kw-img);
  }

  #kw-{{ uid }} .kw-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    padding: 14px;
  }

  #kw-{{ uid }} .kw-card-name {
    font-family: var(--kw-serif);
    font-size: 23px;
    line-height: 1.1;
  }

  #kw-{{ uid }} .kw-card-meaning {
    font-size: 13px;
    color: var(--kw-text-3);
  }

  #kw-{{ uid }} .kw-card-size {
    font-size: 13px;
    color: var(--kw-muted);
  }

  #kw-{{ uid }} .kw-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }

  #kw-{{ uid }} .kw-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--kw-line-2);
    border-radius: 2px;
  }

  #kw-{{ uid }} .kw-stepper button {
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--kw-ink);
    font-size: 18px;
    cursor: pointer;
  }

  #kw-{{ uid }} .kw-stepper button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  #kw-{{ uid }} .kw-stepper output {
    min-width: 22px;
    font-weight: 500;
    text-align: center;
  }

  #kw-{{ uid }} .kw-soldout {
    font-size: 13px;
    color: var(--kw-muted);
  }

  #kw-{{ uid }} .kw-notsure {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    padding: 22px;
    border: 1px dashed var(--kw-line-2);
    border-radius: 3px;
    background: var(--kw-panel);
  }

  #kw-{{ uid }} .kw-notsure-t {
    font-family: var(--kw-serif);
    font-size: 24px;
    line-height: 1.15;
  }

  #kw-{{ uid }} .kw-notsure-s {
    font-size: 14px;
    color: var(--kw-text-3);
  }

  #kw-{{ uid }} .kw-notsure a {
    font-size: 14px;
    font-weight: 500;
  }

  #kw-{{ uid }} .kw-small {
    font-size: 13px;
    color: var(--kw-muted);
  }

  #kw-{{ uid }} .kw-subhead {
    font-family: var(--kw-serif);
    font-size: 28px;
    line-height: 1.15;
  }

  #kw-{{ uid }} .kw-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 18px;
  }

  #kw-{{ uid }} .kw-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px;
    border: 1px solid var(--kw-line);
    border-radius: 3px;
    background: var(--kw-card);
  }

  #kw-{{ uid }} .kw-check {
    flex: none;
    margin-top: 3px;
  }

  #kw-{{ uid }} .kw-item-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  #kw-{{ uid }} .kw-item-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-weight: 500;
  }

  #kw-{{ uid }} .kw-incl {
    color: var(--kw-green-mid);
    font-weight: 400;
    font-size: 14px;
    white-space: nowrap;
  }

  #kw-{{ uid }} .kw-item-text {
    font-size: 13px;
    color: var(--kw-text-3);
  }

  #kw-{{ uid }} .kw-input {
    width: 100%;
    min-height: 46px;
    margin-top: 8px;
    padding: 0 12px;
    border: 1px solid var(--kw-line-2);
    border-radius: 2px;
    background: var(--kw-bg);
    color: var(--kw-ink);
    font-size: 15px;
  }

  #kw-{{ uid }} .kw-input:focus {
    outline: 2px solid var(--kw-green-mid);
    outline-offset: 1px;
  }

  #kw-{{ uid }} .kw-toggle {
    flex: none;
    min-width: 88px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--kw-ink);
    border-radius: 2px;
    background: transparent;
    color: var(--kw-ink);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  #kw-{{ uid }} .kw-toggle[aria-pressed='true'] {
    border-color: var(--kw-green-mid);
    background: var(--kw-green-mid);
    color: var(--kw-bg);
  }

  #kw-{{ uid }} .kw-toggle:disabled {
    border-color: var(--kw-green-mid);
    background: transparent;
    color: var(--kw-green-mid);
    cursor: default;
  }

  #kw-{{ uid }} .kw-addons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  #kw-{{ uid }} .kw-addon {
    align-items: center;
    padding: 12px;
  }

  #kw-{{ uid }} .kw-addon img,
  #kw-{{ uid }} .kw-addon .kw-ph {
    flex: none;
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 2px;
    background: var(--kw-img);
  }

  /* ---------- perks + summary ---------- */
  #kw-{{ uid }} .kw-aside {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 104px;
  }

  #kw-{{ uid }} .kw-box {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border: 1px solid var(--kw-line);
    border-radius: 3px;
    background: var(--kw-card);
  }

  #kw-{{ uid }} .kw-perks-title {
    font-size: 13px;
    font-weight: 500;
  }

  #kw-{{ uid }} .kw-perk {
    display: flex;
    gap: 10px;
    font-size: 14px;
    color: var(--kw-muted);
  }

  #kw-{{ uid }} .kw-perk b {
    font-weight: 500;
  }

  #kw-{{ uid }} .kw-perk[data-on] {
    color: var(--kw-ink);
  }

  #kw-{{ uid }} .kw-dot {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }

  #kw-{{ uid }} .kw-dot circle {
    fill: transparent;
    stroke: #b9af9b;
    stroke-width: 1.5;
  }

  #kw-{{ uid }} .kw-dot path {
    opacity: 0;
  }

  #kw-{{ uid }} .kw-perk[data-on] .kw-dot circle {
    fill: var(--kw-green-mid);
    stroke: var(--kw-green-mid);
  }

  #kw-{{ uid }} .kw-perk[data-on] .kw-dot path {
    opacity: 1;
  }

  #kw-{{ uid }} .kw-next {
    margin: 2px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--kw-line);
    font-size: 13px;
    font-weight: 500;
    color: var(--kw-green-mid);
  }

  #kw-{{ uid }} .kw-sum {
    gap: 9px;
    padding: 20px;
  }

  #kw-{{ uid }} .kw-lines {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #kw-{{ uid }} .kw-line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
    color: var(--kw-text-2);
  }

  #kw-{{ uid }} .kw-line[data-free] span:last-child {
    color: var(--kw-green-mid);
  }

  #kw-{{ uid }} .kw-lines:empty {
    display: none;
  }

  #kw-{{ uid }} .kw-empty {
    font-size: 14px;
    color: var(--kw-muted);
  }

  #kw-{{ uid }} .kw-rule {
    height: 1px;
    margin: 2px 0;
    background: var(--kw-line);
  }

  #kw-{{ uid }} .kw-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  #kw-{{ uid }} .kw-total span:first-child {
    font-weight: 500;
  }

  #kw-{{ uid }} .kw-total span:last-child {
    font-family: var(--kw-serif);
    font-size: 32px;
    font-weight: 600;
  }

  #kw-{{ uid }} .kw-order {
    width: 100%;
    min-height: 56px;
    margin-top: 6px;
  }

  #kw-{{ uid }} .kw-order[aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  #kw-{{ uid }} .kw-error {
    margin: 0;
    font-size: 13px;
    color: #a3352b;
  }

  #kw-{{ uid }} .kw-error:empty {
    display: none;
  }

  #kw-{{ uid }} .kw-pay {
    font-size: 13px;
    color: var(--kw-text-3);
    text-align: center;
  }

  /* ---------- viewing ---------- */
  #kw-{{ uid }} .kw-viewing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    overflow: hidden;
    border-radius: 3px;
    background: var(--kw-panel);
    scroll-margin-top: 24px;
  }

  #kw-{{ uid }} .kw-viewing-img {
    width: 100%;
    height: 100%;
    min-height: 380px;
    object-fit: cover;
  }

  #kw-{{ uid }} .kw-viewing-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 48px;
  }

  #kw-{{ uid }} .kw-viewing h2 {
    margin: 0;
    font-family: var(--kw-serif);
    font-weight: 500;
    font-size: 44px;
    line-height: 1.05;
  }

  #kw-{{ uid }} .kw-viewing .kw-btn {
    max-width: 280px;
    margin-top: 6px;
  }

  /* ---------- faq ---------- */
  #kw-{{ uid }} .kw-faq {
    max-width: 820px;
  }

  #kw-{{ uid }} .kw-faq h2 {
    margin: 0 0 16px;
    font-family: var(--kw-serif);
    font-weight: 500;
    font-size: 40px;
    text-align: center;
  }

  #kw-{{ uid }} .kw-q {
    border-bottom: 1px solid var(--kw-line);
  }

  #kw-{{ uid }} .kw-q summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 18px 0;
    font-family: var(--kw-serif);
    font-size: 22px;
    list-style: none;
    cursor: pointer;
  }

  #kw-{{ uid }} .kw-q summary::-webkit-details-marker {
    display: none;
  }

  #kw-{{ uid }} .kw-q summary::after {
    content: '+';
    flex: none;
    font-family: var(--kw-sans);
    font-size: 20px;
    color: var(--kw-green-mid);
  }

  #kw-{{ uid }} .kw-q[open] summary::after {
    content: '−';
  }

  #kw-{{ uid }} .kw-a {
    margin-top: -8px;
    padding-bottom: 18px;
    color: var(--kw-text-3);
  }

  #kw-{{ uid }} .kw-a p {
    margin: 0;
  }

  #kw-{{ uid }} .kw-end {
    height: 96px;
  }

  /* ---------- mobile bar ---------- */
  #kw-{{ uid }} .kw-bar {
    display: none;
  }

  #kw-{{ uid }} .kw-ph {
    display: block;
  }

  @media (max-width: 989px) {
    #kw-{{ uid }} .kw-only-desk {
      display: none;
    }

    #kw-{{ uid }} .kw-only-mob {
      display: flex;
    }

    #kw-{{ uid }} .kw-wrap {
      margin-top: 56px;
      padding: 0 20px;
    }

    #kw-{{ uid }} .kw-h2 {
      font-size: 36px;
    }

    #kw-{{ uid }} .kw-hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    #kw-{{ uid }} .kw-stage {
      min-height: 0;
      aspect-ratio: 39 / 46;
    }

    #kw-{{ uid }} .kw-stage-foot {
      left: 16px;
      right: 16px;
      bottom: 16px;
    }

    #kw-{{ uid }} .kw-stage-foot .kw-thumbs {
      display: none;
    }

    #kw-{{ uid }} .kw-count {
      display: block;
    }

    #kw-{{ uid }} .kw-arrow {
      width: 40px;
      height: 40px;
      margin-top: -20px;
    }

    #kw-{{ uid }} .kw-arrow--prev {
      left: 10px;
    }

    #kw-{{ uid }} .kw-arrow--next {
      right: 10px;
    }

    #kw-{{ uid }} .kw-strip {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 4px;
      padding: 4px;
      background: var(--kw-green);
    }

    #kw-{{ uid }} .kw-strip .kw-thumb {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }

    #kw-{{ uid }} .kw-panel {
      padding: 32px 24px 40px;
    }

    #kw-{{ uid }} .kw-h1 {
      font-size: 46px;
    }

    #kw-{{ uid }} .kw-from-price {
      font-size: 32px;
    }

    #kw-{{ uid }} .kw-hero-ctas {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      margin-top: 16px;
    }

    #kw-{{ uid }} .kw-panel a.kw-link {
      text-align: center;
    }

    #kw-{{ uid }} .kw-craft {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    #kw-{{ uid }} .kw-craft > .kw-stack {
      display: contents;
    }

    #kw-{{ uid }} .kw-craft .kw-eyebrow {
      order: -3;
      margin-bottom: 8px;
    }

    #kw-{{ uid }} .kw-craft .kw-h2 {
      order: -2;
      margin-bottom: 20px;
    }

    #kw-{{ uid }} .kw-craft-img {
      order: -1;
      margin-bottom: 20px;
    }

    #kw-{{ uid }} .kw-body {
      font-size: 16px;
    }

    #kw-{{ uid }} .kw-facts {
      gap: 10px;
      margin-top: 20px;
    }

    #kw-{{ uid }} .kw-fact {
      padding-top: 0;
      border-top: 0;
    }

    #kw-{{ uid }} .kw-fact-t {
      font-size: 22px;
    }

    #kw-{{ uid }} .kw-fact-s {
      font-size: 13px;
    }

    #kw-{{ uid }} .kw-rooms {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    #kw-{{ uid }} .kw-room {
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      column-gap: 16px;
      row-gap: 2px;
      align-items: start;
    }

    #kw-{{ uid }} .kw-room img,
    #kw-{{ uid }} .kw-room .kw-ph {
      grid-row: 1 / 4;
      width: 132px;
      height: 132px;
      aspect-ratio: auto;
    }

    #kw-{{ uid }} .kw-room-label {
      margin-top: 28px;
      font-size: 12px;
    }

    #kw-{{ uid }} .kw-room-name {
      font-size: 24px;
    }

    #kw-{{ uid }} .kw-room-line {
      font-size: 14px;
    }

    #kw-{{ uid }} .kw-complete {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 28px 18px;
    }

    #kw-{{ uid }} .kw-complete > .kw-stack {
      display: contents;
    }

    #kw-{{ uid }} .kw-complete .kw-eyebrow {
      order: -3;
    }

    #kw-{{ uid }} .kw-complete h2 {
      order: -2;
      font-size: 34px;
    }

    #kw-{{ uid }} .kw-complete-imgs {
      order: -1;
      gap: 6px;
    }

    #kw-{{ uid }} .kw-complete .kw-btn {
      max-width: none;
    }

    #kw-{{ uid }} .kw-chooser {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    #kw-{{ uid }} .kw-cards {
      grid-template-columns: minmax(0, 1fr);
    }

    #kw-{{ uid }} .kw-card-img {
      aspect-ratio: 39 / 30;
    }

    #kw-{{ uid }} .kw-card-body {
      padding: 16px 18px 18px;
    }

    #kw-{{ uid }} .kw-card-name {
      font-size: 28px;
    }

    #kw-{{ uid }} .kw-card-meaning {
      font-size: 14px;
    }

    #kw-{{ uid }} .kw-card-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
    }

    #kw-{{ uid }} .kw-stepper {
      background: var(--kw-bg);
    }

    #kw-{{ uid }} .kw-stepper button {
      width: 46px;
      height: 46px;
    }

    #kw-{{ uid }} .kw-addons {
      grid-template-columns: minmax(0, 1fr);
    }

    #kw-{{ uid }} .kw-viewing {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px 20px 22px;
    }

    #kw-{{ uid }} .kw-viewing-body {
      display: contents;
    }

    #kw-{{ uid }} .kw-viewing .kw-eyebrow {
      order: -3;
      margin-bottom: 10px;
    }

    #kw-{{ uid }} .kw-viewing h2 {
      order: -2;
      margin-bottom: 14px;
      font-size: 34px;
    }

    #kw-{{ uid }} .kw-viewing-img {
      order: -1;
      min-height: 0;
      aspect-ratio: 31 / 26;
      margin-bottom: 14px;
    }

    #kw-{{ uid }} .kw-viewing .kw-body {
      margin-bottom: 18px;
    }

    #kw-{{ uid }} .kw-viewing .kw-btn {
      max-width: none;
    }

    #kw-{{ uid }} .kw-faq h2 {
      text-align: start;
      font-size: 36px;
    }

    #kw-{{ uid }} .kw-q summary {
      font-size: 20px;
    }

    #kw-{{ uid }} .kw-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 10px 20px calc(10px + env(safe-area-inset-bottom));
      border-top: 1px solid var(--kw-line);
      background: var(--kw-bg);
    }

    #kw-{{ uid }} .kw-bar-line {
      display: block;
      font-size: 13px;
      color: var(--kw-green-mid);
    }

    #kw-{{ uid }} .kw-bar-total {
      font-family: var(--kw-serif);
      font-size: 24px;
      font-weight: 600;
      line-height: 1.1;
    }

    #kw-{{ uid }} .kw-bar .kw-btn {
      flex: none;
      min-height: 52px;
      padding: 0 24px;
    }
  }

  @media (min-width: 990px) {
    #kw-{{ uid }} .kw-strip,
    #kw-{{ uid }} .kw-count {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #kw-{{ uid }} .kw-slide {
      transition: none;
    }
  }
</style>

{%- capture check_svg -%}
  <svg class="kw-check" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#1E4A37"/><path d="m7 12 3.5 3.5L17 9" stroke="#FFFDF8" stroke-width="2.2" fill="none"/></svg>
{%- endcapture -%}
{%- capture dot_svg -%}
  <svg class="kw-dot" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5"/><path d="m7 12 3.5 3.5L17 9" stroke="#FFFDF8" stroke-width="2.2" fill="none"/></svg>
{%- endcapture -%}

<div id="kw-{{ uid }}" class="kw" data-kw>
  {%- comment -%} ---------- hero ---------- {%- endcomment -%}
  <section class="kw-hero" aria-label="{{ s.title | escape }}">
    <div>
      <div class="kw-stage" data-stage>
        {%- assign slide_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <figure class="kw-slide" data-slide="{{ slide_i }}" data-caption="{{ block.settings.caption | escape }}" {% if slide_i == 0 %}data-active{% endif %} {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- assign loading = 'lazy' -%}
                {%- if slide_i == 0 -%}{%- assign loading = 'eager' -%}{%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 56vw, 100vw', loading: loading, alt: block.settings.caption
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'kw-ph' }}
              {%- endif -%}
            </figure>
            {%- assign slide_i = slide_i | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if slide_i > 1 -%}
          <button type="button" class="kw-arrow kw-arrow--prev" data-go="-1" aria-label="{{ s.prev_label | default: 'Previous photo' | escape }}">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
          <button type="button" class="kw-arrow kw-arrow--next" data-go="1" aria-label="{{ s.next_label | default: 'Next photo' | escape }}">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
        {%- endif -%}
        <div class="kw-stage-foot">
          <span class="kw-caption" data-caption-text aria-live="polite"></span>
          <span class="kw-count" data-count></span>
          <div class="kw-thumbs">
            {%- assign thumb_i = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'slide' -%}
                <button type="button" class="kw-thumb" data-pick="{{ thumb_i }}" aria-label="{{ block.settings.caption | escape }}" aria-current="{% if thumb_i == 0 %}true{% else %}false{% endif %}">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  {%- endif -%}
                </button>
                {%- assign thumb_i = thumb_i | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
      <div class="kw-strip">
        {%- assign thumb_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <button type="button" class="kw-thumb" data-pick="{{ thumb_i }}" aria-label="{{ block.settings.caption | escape }}" aria-current="{% if thumb_i == 0 %}true{% else %}false{% endif %}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </button>
            {%- assign thumb_i = thumb_i | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="kw-panel">
      {%- if s.eyebrow != blank -%}<span class="kw-eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
      <h1 class="kw-h1">{{ s.title | escape }}</h1>
      <div class="kw-from">
        {%- if from_price > 0 -%}
          <span class="kw-from-price">{{ s.from_label | default: 'From' | escape }} {{ from_price | money_without_trailing_zeros }}</span>
        {%- endif -%}
        {%- if s.hero_note != blank -%}<span class="kw-from-note">{{ s.hero_note | escape }}</span>{%- endif -%}
      </div>
      <div class="kw-hero-ctas">
        <a class="kw-btn kw-btn--light" href="#kw-choose-{{ uid }}">{{ s.hero_cta | escape }}</a>
        {%- if vb.settings.heading != blank -%}
          <a class="kw-link" href="#kw-viewing-{{ uid }}">{{ s.hero_link | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- craft ---------- {%- endcomment -%}
  {%- if cb.settings.heading != blank -%}
    <section class="kw-wrap kw-craft">
      {%- if cb.settings.image != blank -%}
        {{
          cb.settings.image
          | image_url: width: 1200
          | image_tag: class: 'kw-craft-img', widths: '600, 900, 1200', sizes: '(min-width: 990px) 560px, 100vw', loading: 'lazy'
        }}
      {%- endif -%}
      <div class="kw-stack">
        {%- if cb.settings.eyebrow != blank -%}<span class="kw-eyebrow">{{ cb.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2 class="kw-h2">{{ cb.settings.heading | escape }}</h2>
        {%- if cb.settings.text != blank -%}<div class="kw-body">{{ cb.settings.text }}</div>{%- endif -%}
        {%- assign fact_lines = cb.settings.facts | newline_to_br | split: '<br />' -%}
        {%- if cb.settings.facts != blank -%}
          <div class="kw-facts">
            {%- for line in fact_lines -%}
              {%- assign parts = line | split: '|' -%}
              {%- assign ft = parts[0] | strip -%}
              {%- if ft != blank -%}
                <div class="kw-fact">
                  <span class="kw-fact-t">{{ ft | escape }}</span>
                  <span class="kw-fact-s">{{ parts[1] | strip | escape }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- five rooms ---------- {%- endcomment -%}
  {%- if rb.settings.heading != blank and frame_count > 0 -%}
    <section class="kw-wrap">
      {%- if rb.settings.eyebrow != blank -%}<span class="kw-eyebrow">{{ rb.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="kw-h2" style="margin-top: 6px">{{ rb.settings.heading | escape }}</h2>
      <div class="kw-rooms">
        {%- for block in section.blocks -%}
          {%- if block.type == 'frame' and block.settings.product != blank -%}
            {%- assign b = block.settings -%}
            {%- assign fname = b.short_name | default: b.product.title -%}
            <figure class="kw-room">
              {%- if b.room_image != blank -%}
                {{
                  b.room_image
                  | image_url: width: 640
                  | image_tag: widths: '320, 480, 640', sizes: '(min-width: 990px) 230px, 132px', loading: 'lazy', alt: fname
                }}
              {%- else -%}
                <span class="kw-ph" aria-hidden="true"></span>
              {%- endif -%}
              {%- if b.room_label != blank -%}<span class="kw-room-label">{{ b.room_label | escape }}</span>{%- endif -%}
              <span class="kw-room-name">{{ fname | escape }}</span>
              {%- if b.room_line != blank -%}<span class="kw-room-line">{{ b.room_line | escape }}</span>{%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- complete edition ---------- {%- endcomment -%}
  {%- if xb.settings.heading != blank and frame_count > 1 -%}
    <section class="kw-wrap">
      <div class="kw-complete">
        <div class="kw-complete-imgs">
          {%- for block in section.blocks -%}
            {%- if block.type == 'frame' and block.settings.product != blank -%}
              {%- assign p = block.settings.product -%}
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: p.title }}
              {%- else -%}
                <span class="kw-ph" aria-hidden="true"></span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="kw-stack" style="gap: 12px">
          {%- if xb.settings.eyebrow != blank -%}<span class="kw-eyebrow">{{ xb.settings.eyebrow | escape }}</span>{%- endif -%}
          <h2>{{ xb.settings.heading | escape }}</h2>
          {%- if xb.settings.text != blank -%}<p>{{ xb.settings.text | escape }}</p>{%- endif -%}
          <div class="kw-complete-price">
            <span>{{ all_price | money_without_trailing_zeros }}</span>
            {%- if xb.settings.note != blank -%}<span>{{ xb.settings.note | escape }}</span>{%- endif -%}
          </div>
          <button type="button" class="kw-btn kw-btn--dark" data-pick-all>{{ xb.settings.button | escape }}</button>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- perks (rendered twice: mobile above cards, desktop aside) ---------- {%- endcomment -%}
  {%- capture perks -%}
    {%- if s.perks_title != blank -%}
      <div class="kw-box" data-perks>
        <span class="kw-perks-title">{{ s.perks_title | escape }}</span>
        {%- for block in section.blocks -%}
          {%- if block.type == 'perk' -%}
            {%- liquid
              assign at = 1
              case block.settings.unlock
                when 'plaque'
                  assign at = plaque_at
                when 'hang'
                  assign at = hang_free_at
                  if hanging == blank
                    assign at = 0
                  endif
                when 'all'
                  assign at = 'all'
              endcase
            -%}
            {%- if at != 0 -%}
              <div class="kw-perk" data-perk="{{ at }}" data-nudge="{{ block.settings.nudge | escape }}" {{ block.shopify_attributes }}>{{ dot_svg }}<span><b>{{ block.settings.label | escape }}</b> {{ block.settings.text | escape }}</span></div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <p class="kw-next" data-next-line aria-live="polite">{{ s.summary_empty | escape }}</p>
      </div>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture summary -%}
    <div class="kw-box kw-sum">
      <ul class="kw-lines" data-lines role="list"></ul>
      <p class="kw-empty" data-empty>{{ s.summary_empty | escape }}</p>
      <div class="kw-rule"></div>
      <div class="kw-total"><span>{{ s.total_label | default: 'Total' | escape }}</span><span data-total>{{ 0 | money_without_trailing_zeros }}</span></div>
      {%- if s.delivery_note != blank -%}<span class="kw-small" style="margin-top: -6px">{{ s.delivery_note | escape }}</span>{%- endif -%}
      <button type="button" class="kw-btn kw-btn--dark kw-order" data-order>{{ s.order_label | escape }}</button>
      <p class="kw-error" role="alert" data-error></p>
      {%- if s.pay_note != blank -%}<span class="kw-pay">{{ s.pay_note | escape }}</span>{%- endif -%}
    </div>
  {%- endcapture -%}

  {%- comment -%} ---------- chooser ---------- {%- endcomment -%}
  <section class="kw-wrap kw-chooser" id="kw-choose-{{ uid }}">
    <div class="kw-main">
      {%- if s.choose_eyebrow != blank -%}<span class="kw-eyebrow">{{ s.choose_eyebrow | escape }}</span>{%- endif -%}
      <h2 class="kw-h2">{{ s.choose_heading | escape }}</h2>
      <div class="kw-only-mob" style="flex-direction: column">{{ perks }}</div>

      <div class="kw-cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'frame' and block.settings.product != blank -%}
            {%- liquid
              assign b = block.settings
              assign p = b.product
              assign v = p.selected_or_first_available_variant
              assign fname = b.short_name | default: p.title
              assign max_qty = 9
              if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
                assign max_qty = v.inventory_quantity
                if max_qty > 9
                  assign max_qty = 9
                endif
              endif
              if p.available == false
                assign max_qty = 0
              endif
            -%}
            <article class="kw-card" data-card data-variant="{{ v.id }}" data-price="{{ v.price }}" data-name="{{ fname | escape }}" data-max="{{ max_qty }}" {{ block.shopify_attributes }}>
              {%- if p.featured_image -%}
                {{
                  p.featured_image
                  | image_url: width: 800
                  | image_tag: class: 'kw-card-img', widths: '400, 600, 800', sizes: '(min-width: 990px) 270px, 100vw', loading: 'lazy', alt: fname
                }}
              {%- else -%}
                <span class="kw-card-img kw-ph" aria-hidden="true"></span>
              {%- endif -%}
              <div class="kw-card-body">
                <div class="kw-card-top">
                  <span class="kw-card-name">{{ fname | escape }}</span>
                  <span class="kw-only-mob">{{ v.price | money_without_trailing_zeros }}</span>
                </div>
                {%- if b.meaning != blank -%}<span class="kw-card-meaning">{{ b.meaning | escape }}</span>{%- endif -%}
                <div class="kw-card-foot">
                  <span class="kw-only-desk">{{ v.price | money_without_trailing_zeros }}</span>
                  {%- if b.size != blank -%}<span class="kw-card-size kw-only-mob">{{ b.size | escape }}</span>{%- endif -%}
                  {%- if max_qty > 0 -%}
                    <span class="kw-stepper">
                      <button type="button" data-step="-1" aria-label="{{ s.remove_label | default: 'Remove one' | escape }}, {{ fname | escape }}">−</button>
                      <output data-qty aria-live="polite">0</output>
                      <button type="button" data-step="1" aria-label="{{ s.add_label | default: 'Add one' | escape }}, {{ fname | escape }}">+</button>
                    </span>
                  {%- else -%}
                    <span class="kw-soldout">{{ s.sold_out_label | default: 'Sold out' | escape }}</span>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
        {%- if s.notsure_heading != blank -%}
          <div class="kw-notsure">
            <span class="kw-notsure-t">{{ s.notsure_heading | escape }}</span>
            {%- if s.notsure_text != blank -%}<span class="kw-notsure-s">{{ s.notsure_text | escape }}</span>{%- endif -%}
            <a href="#kw-viewing-{{ uid }}">{{ s.notsure_link | escape }}</a>
          </div>
        {%- endif -%}
      </div>
      {%- if s.choose_note != blank -%}<p class="kw-small" style="margin: 0">{{ s.choose_note | escape }}</p>{%- endif -%}

      <div class="kw-group">
        {%- if s.ready_heading != blank -%}<div class="kw-subhead">{{ s.ready_heading | escape }}</div>{%- endif -%}
        <div class="kw-item">
          {{ check_svg }}
          <div class="kw-item-body">
            <span class="kw-item-head"><span>{{ s.wrap_title | escape }}</span><span class="kw-incl">{{ s.included_label | default: 'Included' | escape }}</span></span>
            {%- if s.wrap_text != blank -%}<span class="kw-item-text">{{ s.wrap_text | escape }}</span>{%- endif -%}
          </div>
        </div>
        <div class="kw-item">
          {{ check_svg }}
          <div class="kw-item-body">
            <span class="kw-item-head"><span>{{ s.card_title | escape }}</span><span class="kw-incl">{{ s.included_label | default: 'Included' | escape }}</span></span>
            <label class="kw-item-text" for="kw-msg-{{ uid }}">{{ s.card_text | escape }}</label>
            <input class="kw-input" id="kw-msg-{{ uid }}" type="text" maxlength="200" placeholder="{{ s.card_placeholder | escape }}" data-message>
          </div>
        </div>
        {%- if hanging != blank and hanging.available -%}
          <div class="kw-item" style="align-items: center">
            <div class="kw-item-body">
              <span class="kw-item-head"><span>{{ s.hang_title | default: hanging.title | escape }}</span></span>
              {%- if s.hang_text != blank -%}<span class="kw-item-text">{{ s.hang_text | escape }}</span>{%- endif -%}
              <span style="font-size: 14px; font-weight: 500; margin-top: 4px" data-hang-price>+ {{ hanging.price | money_without_trailing_zeros }}{% if hang_free_at > 0 %} · {{ s.hang_free_text | replace: '[n]', hang_free_at | escape }}{% endif %}</span>
            </div>
            <button type="button" class="kw-toggle" aria-pressed="false" data-hang data-variant="{{ hanging.selected_or_first_available_variant.id }}" data-price="{{ hanging.price }}">{{ s.add_button | default: 'Add' | escape }}</button>
          </div>
        {%- endif -%}
      </div>

      {%- assign addon_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'addon' and block.settings.product != blank -%}{%- assign addon_count = addon_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if addon_count > 0 -%}
        <div class="kw-group">
          <div>
            {%- if s.addons_eyebrow != blank -%}<span class="kw-eyebrow">{{ s.addons_eyebrow | escape }}</span>{%- endif -%}
            <div class="kw-subhead">{{ s.addons_heading | escape }}</div>
            {%- if s.addons_text != blank -%}<span class="kw-small">{{ s.addons_text | escape }}</span>{%- endif -%}
          </div>
          <div class="kw-addons">
            {%- for block in section.blocks -%}
              {%- if block.type == 'addon' and block.settings.product != blank -%}
                {%- assign p = block.settings.product -%}
                {%- assign aname = block.settings.title | default: p.title -%}
                <div class="kw-item kw-addon" {{ block.shopify_attributes }}>
                  {%- if p.featured_image -%}
                    {{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: aname }}
                  {%- else -%}
                    <span class="kw-ph" aria-hidden="true"></span>
                  {%- endif -%}
                  <div class="kw-item-body">
                    <span style="font-weight: 500">{{ aname | escape }}</span>
                    {%- if block.settings.text != blank -%}<span class="kw-item-text">{{ block.settings.text | escape }}</span>{%- endif -%}
                    <span style="font-size: 14px">+ {{ p.price | money_without_trailing_zeros }}</span>
                  </div>
                  {%- if p.available -%}
                    <button type="button" class="kw-toggle" aria-pressed="false" data-addon data-variant="{{ p.selected_or_first_available_variant.id }}" data-price="{{ p.price }}" data-name="{{ aname | escape }}">{{ s.add_button | default: 'Add' | escape }}</button>
                  {%- else -%}
                    <span class="kw-soldout">{{ s.sold_out_label | default: 'Sold out' | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="kw-only-mob" style="flex-direction: column; margin-top: 18px">{{ summary }}</div>
    </div>

    <aside class="kw-aside kw-only-desk" aria-label="{{ s.summary_label | default: 'Your order' | escape }}">
      {{ perks }}
      {{ summary }}
    </aside>
  </section>

  {%- comment -%} ---------- see them on your wall ---------- {%- endcomment -%}
  {%- if vb.settings.heading != blank -%}
    <section class="kw-wrap" id="kw-viewing-{{ uid }}">
      <div class="kw-viewing">
        {%- if vb.settings.image != blank -%}
          {{
            vb.settings.image
            | image_url: width: 1200
            | image_tag: class: 'kw-viewing-img', widths: '600, 900, 1200', sizes: '(min-width: 990px) 620px, 100vw', loading: 'lazy'
          }}
        {%- endif -%}
        <div class="kw-viewing-body">
          {%- if vb.settings.eyebrow != blank -%}<span class="kw-eyebrow">{{ vb.settings.eyebrow | escape }}</span>{%- endif -%}
          <h2>{{ vb.settings.heading | escape }}</h2>
          {%- if vb.settings.text != blank -%}<p class="kw-body" style="font-size: 16px">{{ vb.settings.text | escape }}</p>{%- endif -%}
          {%- if wa_number != blank -%}
            <a class="kw-btn kw-btn--line" href="{{ wa_url }}" target="_blank" rel="noopener">{{ vb.settings.button | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- faq ---------- {%- endcomment -%}
  {%- assign faq_count = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{%- assign faq_count = faq_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if faq_count > 0 -%}
    <section class="kw-wrap kw-faq">
      {%- if s.faq_eyebrow != blank -%}<span class="kw-eyebrow kw-only-mob" style="margin-bottom: 8px">{{ s.faq_eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ s.faq_heading | escape }}</h2>
      {%- assign first_faq = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          <details class="kw-q" {% if first_faq %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}</summary>
            <div class="kw-a">{{ block.settings.answer }}</div>
          </details>
          {%- assign first_faq = false -%}
        {%- endif -%}
      {%- endfor -%}
    </section>
  {%- endif -%}
  <div class="kw-end" aria-hidden="true"></div>

  {%- comment -%} ---------- mobile bar ---------- {%- endcomment -%}
  <div class="kw-bar">
    <div>
      <span class="kw-bar-line" data-bar-line>{{ s.bar_empty | default: 'Five designs, from [price]' | replace: '[price]', from_money | escape }}</span>
      <span class="kw-bar-total" data-bar-total>{{ from_price | money_without_trailing_zeros }}</span>
    </div>
    <button type="button" class="kw-btn kw-btn--dark" data-bar-cta>{{ s.bar_choose | default: 'Choose a frame' | escape }}</button>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('kw-{{ uid }}');
    if (!root || root.hasAttribute('data-ready')) return;
    root.setAttribute('data-ready', '');

    var FORMAT = {{ shop.money_format | json }};
    var PLAQUE_AT = {{ plaque_at }};
    var HANG_FREE_AT = {{ hang_free_at }};
    var AFTER = {{ s.after_add | default: 'checkout' | json }};
    var T = {
      included: {{ s.included_label | default: 'Included' | json }},
      free: {{ s.free_label | default: 'Free' | json }},
      wrapLine: {{ s.line_wrap | default: 'Hand wrapping, card and certificate' | json }},
      plaqueLine: {{ s.line_plaque | default: 'Engraved brass plaque × [n]' | json }},
      editionLine: {{ s.line_edition | default: 'Matching edition numbers' | json }},
      hangLine: {{ s.hang_title | default: 'Hung & cared for' | json }},
      hangFreeNow: {{ s.hang_free_now | default: 'Free with [n] frames or more' | json }},
      done: {{ s.perks_done | default: 'The Complete Edition: one number, across all five.' | json }},
      start: {{ s.summary_empty | json }},
      bar: {
        empty: {{ s.bar_empty | default: 'Five designs, from [price]' | replace: '[price]', from_money | json }},
        one: {{ s.bar_frame | default: '1 frame' | json }},
        many: {{ s.bar_frames | default: '[n] frames' | json }},
        base: {{ s.bar_base | default: 'wrapped, with certificate' | json }},
        plaque: {{ s.bar_plaque | default: 'brass plaques added' | json }},
        hang: {{ s.bar_hang | default: 'hung free in Dhaka' | json }},
        all: {{ s.bar_all | default: 'Complete Edition' | json }},
        choose: {{ s.bar_choose | default: 'Choose a frame' | json }},
        order: {{ s.order_label | json }}
      },
      need: {{ s.need_frame | default: 'Choose at least one frame first.' | json }},
      failed: {{ s.add_error | default: 'Something went wrong. Please try again.' | json }},
      adding: {{ s.adding_label | default: 'Adding…' | json }},
      props: {
        wrap: {{ s.prop_wrap | default: 'Wrapping' | json }},
        message: {{ s.prop_message | default: 'Card message' | json }},
        plaque: {{ s.prop_plaque | default: 'Brass plaque' | json }},
        edition: {{ s.prop_edition | default: 'Edition' | json }},
        link: {{ s.prop_link | default: 'For' | json }}
      },
      editionValue: {{ s.edition_value | default: 'Matching edition numbers' | json }},
      plaqueValue: {{ s.plaque_value | default: 'Engraved' | json }},
      wrapValue: {{ s.wrap_title | json }}
    };

    function money(cents) {
      var whole = Math.round(cents / 100).toLocaleString('en-US');
      var fixed = (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return FORMAT.replace(/\{\{\s*(\w+)\s*\}\}/, function (m, key) {
        return key === 'amount' ? fixed : whole;
      }).replace(/<[^>]*>/g, '');
    }

    /* ---------- hero gallery ---------- */
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-slide]'));
    var captionEl = root.querySelector('[data-caption-text]');
    var countEl = root.querySelector('[data-count]');
    var current = 0;

    function show(i) {
      if (!slides.length) return;
      current = (i + slides.length) % slides.length;
      slides.forEach(function (sl, n) {
        if (n === current) sl.setAttribute('data-active', '');
        else sl.removeAttribute('data-active');
      });
      root.querySelectorAll('[data-pick]').forEach(function (t) {
        t.setAttribute('aria-current', parseInt(t.getAttribute('data-pick'), 10) === current ? 'true' : 'false');
      });
      var cap = slides[current].getAttribute('data-caption');
      captionEl.textContent = cap;
      captionEl.hidden = !cap;
      if (countEl) countEl.textContent = current + 1 + ' / ' + slides.length;
    }
    show(0);

    var stage = root.querySelector('[data-stage]');
    var touchX = null;
    stage.addEventListener('touchstart', function (e) {
      touchX = e.touches[0].clientX;
    }, { passive: true });
    stage.addEventListener('touchend', function (e) {
      if (touchX === null) return;
      var dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      touchX = null;
    });

    /* ---------- chooser ---------- */
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-card]'));
    var qty = cards.map(function () {
      return 0;
    });
    var hangBtn = root.querySelector('[data-hang]');
    var hangChosen = false;
    var addons = Array.prototype.slice.call(root.querySelectorAll('[data-addon]'));
    var msg = root.querySelector('[data-message]');

    function count() {
      return qty.reduce(function (a, b) {
        return a + b;
      }, 0);
    }

    function isComplete() {
      return cards.length > 1 && qty.every(function (n, i) {
        return n > 0 || cards[i].getAttribute('data-max') === '0';
      }) && count() > 0;
    }

    function hangFree() {
      return HANG_FREE_AT > 0 && count() >= HANG_FREE_AT;
    }

    function line(label, value, free) {
      var li = document.createElement('li');
      li.className = 'kw-line';
      if (free) li.setAttribute('data-free', '');
      var a = document.createElement('span');
      a.textContent = label;
      var b = document.createElement('span');
      b.textContent = value;
      li.appendChild(a);
      li.appendChild(b);
      return li;
    }

    function render() {
      var n = count();
      var complete = isComplete();
      var total = 0;
      var lines = [];

      cards.forEach(function (card, i) {
        var q = qty[i];
        var price = parseInt(card.getAttribute('data-price'), 10) || 0;
        var max = parseInt(card.getAttribute('data-max'), 10) || 0;
        if (q > 0) card.setAttribute('data-selected', '');
        else card.removeAttribute('data-selected');
        var out = card.querySelector('[data-qty]');
        if (out) out.textContent = q;
        var minus = card.querySelector('[data-step="-1"]');
        var plus = card.querySelector('[data-step="1"]');
        if (minus) minus.disabled = q <= 0;
        if (plus) plus.disabled = q >= max;
        if (q > 0) {
          total += q * price;
          lines.push([(q > 1 ? q + ' × ' : '') + card.getAttribute('data-name'), money(q * price), false]);
        }
      });

      if (n > 0) lines.push([T.wrapLine, T.included, true]);
      if (PLAQUE_AT > 0 && n >= PLAQUE_AT) lines.push([T.plaqueLine.replace('[n]', n), T.included, true]);
      if (complete) lines.push([T.editionLine, T.included, true]);

      addons.forEach(function (btn) {
        var on = btn.getAttribute('aria-pressed') === 'true';
        if (!on) return;
        var price = parseInt(btn.getAttribute('data-price'), 10) || 0;
        total += price;
        lines.push([btn.getAttribute('data-name'), money(price), false]);
      });

      if (hangBtn) {
        var free = hangFree();
        var price = parseInt(hangBtn.getAttribute('data-price'), 10) || 0;
        hangBtn.disabled = free;
        hangBtn.setAttribute('aria-pressed', free || hangChosen ? 'true' : 'false');
        hangBtn.textContent = free ? T.free : hangChosen ? '✓' : {{ s.add_button | default: 'Add' | json }};
        if (n > 0 && (free || hangChosen)) {
          if (!free) total += price;
          lines.push([T.hangLine, free ? T.free : money(price), free]);
        }
        var hp = root.querySelector('[data-hang-price]');
        if (hp && free) hp.textContent = T.hangFreeNow.replace('[n]', HANG_FREE_AT);
        else if (hp) hp.textContent = '+ ' + money(price) + (HANG_FREE_AT > 0 ? ' · ' + {{ s.hang_free_text | replace: '[n]', hang_free_at | json }} : '');
      }

      root.querySelectorAll('[data-lines]').forEach(function (ul) {
        ul.innerHTML = '';
        lines.forEach(function (l) {
          ul.appendChild(line(l[0], l[1], l[2]));
        });
      });
      root.querySelectorAll('[data-empty]').forEach(function (el) {
        el.hidden = n > 0;
      });
      root.querySelectorAll('[data-total]').forEach(function (el) {
        el.textContent = money(total);
      });

      // Perks
      root.querySelectorAll('[data-perk]').forEach(function (el) {
        var at = el.getAttribute('data-perk');
        var on = at === 'all' ? complete : n >= parseInt(at, 10);
        if (on) el.setAttribute('data-on', '');
        else el.removeAttribute('data-on');
      });
      var next = n === 0 ? T.start : '';
      if (!next) {
        var perkEls = root.querySelectorAll('[data-perks]')[0];
        var locked = perkEls ? perkEls.querySelector('[data-perk]:not([data-on])') : null;
        next = locked ? locked.getAttribute('data-nudge') : T.done;
      }
      root.querySelectorAll('[data-next-line]').forEach(function (el) {
        if (next) el.textContent = next;
      });

      // Mobile bar
      var barLine = root.querySelector('[data-bar-line]');
      var barTotal = root.querySelector('[data-bar-total]');
      var barCta = root.querySelector('[data-bar-cta]');
      if (n > 0) {
        var state = complete ? T.bar.all : hangFree() ? T.bar.hang : PLAQUE_AT > 0 && n >= PLAQUE_AT ? T.bar.plaque : T.bar.base;
        barLine.textContent = (n === 1 ? T.bar.one : T.bar.many.replace('[n]', n)) + ' · ' + state;
        barTotal.textContent = money(total);
        barCta.textContent = T.bar.order;
      } else {
        barLine.textContent = T.bar.empty;
        barCta.textContent = T.bar.choose;
      }
    }

    function scrollToChooser() {
      var target = root.querySelector('.kw-cards');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (target) target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }

    root.addEventListener('click', function (e) {
      var go = e.target.closest('[data-go]');
      if (go) {
        show(current + parseInt(go.getAttribute('data-go'), 10));
        return;
      }
      var pick = e.target.closest('[data-pick]');
      if (pick) {
        show(parseInt(pick.getAttribute('data-pick'), 10));
        return;
      }
      var step = e.target.closest('[data-step]');
      if (step) {
        var card = step.closest('[data-card]');
        var i = cards.indexOf(card);
        var max = parseInt(card.getAttribute('data-max'), 10) || 0;
        qty[i] = Math.max(0, Math.min(max, qty[i] + parseInt(step.getAttribute('data-step'), 10)));
        setError('');
        render();
        return;
      }
      if (e.target.closest('[data-pick-all]')) {
        cards.forEach(function (card, i) {
          if (qty[i] < 1 && card.getAttribute('data-max') !== '0') qty[i] = 1;
        });
        render();
        scrollToChooser();
        return;
      }
      var addon = e.target.closest('[data-addon]');
      if (addon) {
        addon.setAttribute('aria-pressed', addon.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        addon.textContent = addon.getAttribute('aria-pressed') === 'true' ? '✓' : {{ s.add_button | default: 'Add' | json }};
        render();
        return;
      }
      if (e.target.closest('[data-hang]')) {
        hangChosen = !hangChosen;
        render();
        return;
      }
      if (e.target.closest('[data-order]')) {
        order(e.target.closest('[data-order]'));
        return;
      }
      if (e.target.closest('[data-bar-cta]')) {
        if (count() > 0) order(e.target.closest('[data-bar-cta]'));
        else scrollToChooser();
      }
    });

    function setError(text) {
      root.querySelectorAll('[data-error]').forEach(function (el) {
        el.textContent = text;
      });
    }

    var busy = false;
    function order(button) {
      if (busy) return;
      var n = count();
      if (n === 0) {
        setError(T.need);
        scrollToChooser();
        return;
      }
      var complete = isComplete();
      var props = {};
      if (T.wrapValue) props[T.props.wrap] = T.wrapValue;
      var message = msg && msg.value.trim();
      if (message) props[T.props.message] = message;
      if (PLAQUE_AT > 0 && n >= PLAQUE_AT) props[T.props.plaque] = T.plaqueValue;
      if (complete) props[T.props.edition] = T.editionValue;

      var items = [];
      var names = [];
      cards.forEach(function (card, i) {
        if (qty[i] < 1) return;
        items.push({ id: parseInt(card.getAttribute('data-variant'), 10), quantity: qty[i], properties: props });
        names.push((qty[i] > 1 ? qty[i] + ' × ' : '') + card.getAttribute('data-name'));
      });
      if (hangBtn && (hangFree() || hangChosen)) {
        var hp = {};
        hp[T.props.link] = names.join(', ');
        items.push({ id: parseInt(hangBtn.getAttribute('data-variant'), 10), quantity: 1, properties: hp });
      }
      addons.forEach(function (btn) {
        if (btn.getAttribute('aria-pressed') !== 'true') return;
        items.push({ id: parseInt(btn.getAttribute('data-variant'), 10), quantity: 1 });
      });

      busy = true;
      var label = button.textContent;
      button.setAttribute('aria-busy', 'true');
      button.textContent = T.adding;
      setError('');
      fetch((window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/') + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) {
          if (!res.ok) {
            return res.json().then(function (data) {
              throw new Error((data && (data.description || data.message)) || T.failed);
            });
          }
          window.location.href = AFTER === 'cart' ? {{ routes.cart_url | json }} : '/checkout';
        })
        .catch(function (err) {
          busy = false;
          button.removeAttribute('aria-busy');
          button.textContent = label;
          setError(err && err.message ? err.message : T.failed);
        });
    }

    render();
  })();
</script>

