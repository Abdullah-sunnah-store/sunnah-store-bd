{%- assign sid = section.id -%}

{% render 'tss-base' %}

<section
  class="scc-section"
  id="scc-{{ sid }}"
  style="background-color:{{ section.settings.section_bg }};padding:{{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;"
>
  <div class="scc-wrap">

    <!-- Header -->
    <div class="scc-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="scc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="scc-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="scc-subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <!-- Collection cards -->
    <div
      class="scc-grid tss-rail"
      role="region"
      tabindex="0"
      aria-label="{{ section.settings.heading | default: 'Collections' | escape }}"
      data-progress="scc-progress-{{ sid }}"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign col = collections[b.collection]
          assign col_title = col.title | default: b.fallback_title
        -%}
        <a
          class="scc-card"
          href="{{ col.url | default: '#' }}"
          {{ block.shopify_attributes }}
        >
          <div class="scc-card-media tss-clip">
            <div>
              {% render 'tss-image',
                image: b.icon,
                sizes: '(min-width: 64rem) 24vw, (min-width: 40rem) 46vw, 78vw',
                alt: col_title,
                placeholder: 'product-1'
              %}
            </div>
          </div>

          <div class="scc-card-text tss-rise">
            {%- if b.category_label != blank -%}
              <p class="scc-category" style="color:{{ b.category_color }};">{{ b.category_label }}</p>
            {%- endif -%}
            <p class="scc-col-name">{{ col_title }}</p>
            {%- if b.quote != blank -%}
              <p class="scc-quote">&ldquo;{{ b.quote }}&rdquo;</p>
            {%- endif -%}
            {%- if section.settings.card_link_label != blank -%}
              <div class="scc-link">
                <span class="tss-link-gold">{{ section.settings.card_link_label }}</span>
              </div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

    <div class="tss-progress scc-progress" id="scc-progress-{{ sid }}" aria-hidden="true">
      <span></span>
    </div>

    <!-- View All — bottom center primary button -->
    {%- if section.settings.view_all_text != blank -%}
      <div class="scc-view-all-wrap">
        <a class="scc-view-all btn btn--primary" href="{{ section.settings.view_all_url | default: '#' }}">
          {{ section.settings.view_all_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  #scc-{{ sid }} { box-sizing: border-box; }

  #scc-{{ sid }} .scc-wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* ── Header — centered (mirrors .tss-head) ── */
  #scc-{{ sid }} .scc-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: {{ section.settings.head_bottom_gap }}px;
  }

  #scc-{{ sid }} .scc-eyebrow {
    margin: 0 0 8px;
    font-size: {{ section.settings.eyebrow_size }}px;
    letter-spacing: 0.22em;
    font-weight: 500;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    font-family: var(--tss-sans);
    text-align: center;
  }

  #scc-{{ sid }} .scc-title {
    margin: 0 0 10px;
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-family: var(--tss-serif);
    font-weight: 400;
    letter-spacing: normal;
    color: {{ section.settings.heading_color }};
    line-height: 1.1;
    text-wrap: balance;
    text-align: center;
  }

  /* Matches the .tss-head-title step-up used by the TSS sections */
  @media screen and (min-width: 64rem) {
    #scc-{{ sid }} .scc-title {
      font-size: {{ section.settings.heading_size }}px;
    }
  }

  #scc-{{ sid }} .scc-subtext {
    margin: 0 auto;
    font-size: {{ section.settings.subtext_size }}px;
    color: {{ section.settings.subtext_color }};
    line-height: 1.5;
    max-width: 520px;
    text-align: center;
    font-family: var(--font-body--family);
  }

  /* ── View All — bottom center primary button ── */
  #scc-{{ sid }} .scc-view-all-wrap {
    text-align: center;
    margin-top: {{ section.settings.view_all_top_gap }}px;
  }

  #scc-{{ sid }} .scc-view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    padding: var(--button-padding-block, 14px) var(--button-padding-inline, 36px);
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: 1.5px solid var(--color-primary-button-border);
    border-radius: var(--style-border-radius-buttons-primary);
    font-size: {{ section.settings.btn_font_size }}px;
    font-family: var(--button-font-family-primary);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: var(--button-text-case-primary, none);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  #scc-{{ sid }} .scc-view-all:hover {
    background-color: var(--color-primary-button-text, #fff);
    color: var(--color-primary-button-background, #111);
    border-color: var(--color-primary-button-background, #111);
  }

  /* ── Grid ── */
  /* Mobile inherits .tss-rail — the same horizontal snap rail the Journal
     uses. The section's own mobile padding provides the inset, so the rail
     zeroes the gutter .tss-rail would otherwise add. Padding on a flex scroll
     container is unreliable, so the inset lives on the section instead. */
  #scc-{{ sid }} .scc-grid {
    padding-inline: 0;
  }

  /* ── Card — image above, text below (mirrors the Journal card) ── */
  #scc-{{ sid }} .scc-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  #scc-{{ sid }} .scc-card-media {
    border-radius: {{ section.settings.card_radius }}px;
  }

  #scc-{{ sid }} .scc-card-text {
    margin-top: 20px;
    text-align: left;
  }

  #scc-{{ sid }} .scc-category {
    margin: 0 0 8px;
    font-family: var(--tss-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #scc-{{ sid }} .scc-col-name {
    margin: 0;
    max-width: 20ch;
    font-family: var(--tss-serif);
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 500;
    line-height: 1.25;
    text-wrap: balance;
    color: {{ section.settings.card_title_color }};
  }

  #scc-{{ sid }} .scc-quote {
    margin: 8px 0 0;
    font-family: var(--tss-sans);
    font-size: {{ section.settings.quote_size }}px;
    font-style: italic;
    color: {{ section.settings.quote_color }};
    line-height: 1.6;
  }

  #scc-{{ sid }} .scc-link {
    margin-top: 12px;
  }

  /* .tss-progress carries its own gutter margin; the section is already padded,
     so zero it to keep the bar flush with the cards. */
  #scc-{{ sid }} .scc-progress {
    margin-inline: 0;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 768px) {
    #scc-{{ sid }} {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_right }}px {{ section.settings.mobile_padding_bottom }}px {{ section.settings.mobile_padding_left }}px !important;
    }
    /* .scc-title uses "Font size mobile" as its base size */
  }

  /* From the theme's 40rem breakpoint up the rail becomes a grid again, so the
     column settings still drive tablet and desktop. */
  @media screen and (min-width: 40rem) {
    #scc-{{ sid }} .scc-grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
      gap: {{ section.settings.card_gap }}px;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      /* .tss-rail caps itself at --tss-max above 64rem; the wrapper's
         "Content max-width" setting governs here instead. */
      max-width: none;
    }

    /* Undoes the 46vw/24vw widths .tss-rail gives its children. */
    #scc-{{ sid }} .scc-grid > * {
      width: auto;
    }

    #scc-{{ sid }} .scc-progress {
      display: none;
    }
  }

  @media screen and (min-width: 64rem) {
    #scc-{{ sid }} .scc-grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Sunnah Collection Cards",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "section_bg", "label": "Background color", "default": "#f5f0e8" },
    { "type": "range", "id": "max_width",  "label": "Content max-width (px)", "min": 800, "max": 1800, "step": 20, "default": 1400 },

    { "type": "header", "content": "Eyebrow" },
    { "type": "text",  "id": "eyebrow",       "label": "Eyebrow text",   "default": "A SUNNAH OF GIVING" },
    { "type": "range", "id": "eyebrow_size",  "label": "Font size (px)", "min": 9, "max": 18, "step": 1, "default": 10 },
    { "type": "color", "id": "eyebrow_color", "label": "Color",          "default": "#B8860B" },

    { "type": "header", "content": "Heading" },
    { "type": "text",   "id": "heading",             "label": "Heading",                "default": "Gifts that never age." },
    { "type": "range",  "id": "heading_size",        "label": "Font size desktop (px)", "min": 20, "max": 80, "step": 2, "default": 46 },
    { "type": "range",  "id": "heading_size_mobile", "label": "Font size mobile (px)",  "min": 18, "max": 48, "step": 2, "default": 34 },
    { "type": "color",  "id": "heading_color",       "label": "Color",                  "default": "#1C1C1A" },
    { "type": "header", "content": "Subtext" },
    { "type": "text",  "id": "subtext",       "label": "Subtext",        "default": "Four gifts the world has always loved — carried here as the Sunnah intended." },
    { "type": "range", "id": "subtext_size",  "label": "Font size (px)", "min": 12, "max": 20, "step": 1, "default": 15 },
    { "type": "color", "id": "subtext_color", "label": "Color",          "default": "#555555" },
    { "type": "range", "id": "head_bottom_gap", "label": "Space below header (px)", "min": 8, "max": 80, "step": 4, "default": 32 },

    { "type": "header", "content": "View All Button" },
    { "type": "text",  "id": "view_all_text",    "label": "Button text",           "default": "View All" },
    { "type": "url",   "id": "view_all_url",     "label": "URL" },
    { "type": "range", "id": "btn_font_size",    "label": "Button font size (px)", "min": 11, "max": 18, "step": 1, "default": 13 },
    { "type": "range", "id": "view_all_top_gap", "label": "Space above button (px)", "min": 8, "max": 80, "step": 4, "default": 32 },

    { "type": "header", "content": "Card Grid" },
    { "type": "range", "id": "columns",        "label": "Columns (desktop)", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Columns (tablet)",  "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "card_gap",     "label": "Gap between cards (px)",  "min": 0, "max": 40,  "step": 2,  "default": 24 },
    { "type": "range", "id": "card_radius", "label": "Card radius (px)",        "min": 0, "max": 24,  "step": 2,  "default": 0 },

    { "type": "header", "content": "Card Text" },
    { "type": "color",  "id": "card_title_color", "label": "Title color",     "default": "#1C1C1A" },
    { "type": "range",  "id": "card_title_size",  "label": "Title size (px)", "min": 14, "max": 32, "step": 1, "default": 22 },
    { "type": "color", "id": "quote_color", "label": "Quote color",    "default": "#5A5A54" },
    { "type": "range", "id": "quote_size",  "label": "Quote size (px)","min": 10, "max": 18, "step": 1, "default": 14 },
    { "type": "text",  "id": "card_link_label", "label": "Card link label", "info": "Gold link under each card, like \"Read →\" in the Journal. Leave empty to hide.", "default": "Shop →" },

    { "type": "header", "content": "Section Spacing — Desktop" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_left",   "label": "Padding left",   "min": 0, "max": 80,  "step": 4, "default": 40 },
    { "type": "range", "id": "padding_right",  "label": "Padding right",  "min": 0, "max": 80,  "step": 4, "default": 40 },

    { "type": "header", "content": "Section Spacing — Mobile" },
    { "type": "range", "id": "mobile_padding_top",    "label": "Padding top",    "min": 0, "max": 80, "step": 4, "default": 40 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Padding bottom", "min": 0, "max": 80, "step": 4, "default": 40 },
    { "type": "range", "id": "mobile_padding_left",   "label": "Padding left",   "min": 0, "max": 60, "step": 4, "default": 20 },
    { "type": "range", "id": "mobile_padding_right",  "label": "Padding right",  "min": 0, "max": 60, "step": 4, "default": 20 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection Card",
      "settings": [
        { "type": "collection",   "id": "collection",      "label": "Collection" },
        { "type": "text",         "id": "fallback_title",  "label": "Fallback title (if no collection)" },
        { "type": "image_picker", "id": "icon",            "label": "Icon image" },
        { "type": "text",         "id": "category_label",  "label": "Category label (e.g. KNOWLEDGE)" },
        { "type": "color",        "id": "category_color",  "label": "Category label color", "default": "#B8860B" },
        { "type": "textarea",     "id": "quote",           "label": "Quote text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sunnah Collection Cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
