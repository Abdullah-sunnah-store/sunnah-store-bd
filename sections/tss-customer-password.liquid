{% comment %}
  TSS — Set password (legacy customer accounts)
  Serves both templates that end in a new password: customers/reset_password
  (from the recovery email) and customers/activate_account (from an invite).
  The activate form adds a "Decline" button, as Shopify expects.
{% endcomment %}

{% render 'tss-base' %}
{{ 'tss-account.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign activate = false
  if request.page_type == 'customers/activate_account'
    assign activate = true
  endif
-%}

<section
  id="tss-password-{{ uid }}"
  class="tss-section tss-acct"
  style="--acct-page: {{ s.page_bg }}; --acct-card: {{ s.card_bg }}; --acct-btn: {{ s.button_bg }}; --acct-btn-text: {{ s.button_text }};"
>
  <div class="tss-acct__card">
    {%- if activate -%}
      <h1 class="tss-acct__title">{{ s.activate_title | escape }}</h1>
      <p class="tss-acct__lede">{{ s.activate_lede | escape }}</p>
    {%- else -%}
      <h1 class="tss-acct__title">{{ s.reset_title | escape }}</h1>
      <p class="tss-acct__lede">{{ s.reset_lede | escape }}</p>
    {%- endif -%}

    {%- capture fields -%}
      <label class="tss-sr-only" for="tss-pw-{{ uid }}">Password</label>
      <input
        type="password"
        id="tss-pw-{{ uid }}"
        class="tss-acct__input"
        name="customer[password]"
        placeholder="New password"
        autocomplete="new-password"
        required
      >
      <label class="tss-sr-only" for="tss-pw-confirm-{{ uid }}">Confirm password</label>
      <input
        type="password"
        id="tss-pw-confirm-{{ uid }}"
        class="tss-acct__input"
        name="customer[password_confirmation]"
        placeholder="Confirm password"
        autocomplete="new-password"
        required
      >
    {%- endcapture -%}

    {%- if activate -%}
      {%- form 'activate_customer_password', class: 'tss-acct__form' -%}
        {%- if form.errors -%}
          <div class="tss-acct__errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {{ fields }}
        <button type="submit" class="tss-acct__btn">Activate account</button>
        <button type="submit" name="decline" value="Decline" class="tss-acct__btn tss-acct__btn--ghost">Decline invitation</button>
      {%- endform -%}
    {%- else -%}
      {%- form 'reset_customer_password', class: 'tss-acct__form' -%}
        {%- if form.errors -%}
          <div class="tss-acct__errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {{ fields }}
        <button type="submit" class="tss-acct__btn">Reset password</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TSS · Set password",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Reset password" },
    { "type": "text", "id": "reset_title", "label": "Heading", "default": "Reset password" },
    { "type": "text", "id": "reset_lede", "label": "Subheading", "default": "Choose a new password for your account." },
    { "type": "header", "content": "Activate account" },
    { "type": "text", "id": "activate_title", "label": "Heading", "default": "Activate account" },
    { "type": "text", "id": "activate_lede", "label": "Subheading", "default": "Set a password to finish creating your account." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "page_bg", "label": "Page background", "default": "#F5F5F7" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_bg", "label": "Button", "default": "#1F6FC5" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FFFFFF" }
  ]
}
{% endschema %}
